---
interface Props {
  title: string;
  description?: string;
  /** Open Graph type; blog posts pass `article` with their publication date. */
  type?: 'website' | 'article';
  published?: Date;
}

const {
  title,
  description = "Gufo runs text, image, audio and video models locally on AMD Strix Halo.",
  type = 'website',
  published,
} = Astro.props;
// Absolute URLs need `site` in astro.config.mjs; without it the tags fall back to root-relative paths.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImage = absolute('/og.png');
// With `build.format: 'file'` the built pathname is /docs.html; the public URL is /docs.
const pagePath = Astro.url.pathname.replace(/(index)?\.html$/, '');
import '../styles/fonts.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-400-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f8f3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {Astro.site && <link rel="canonical" href={absolute(pagePath)} />}

    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:site_name" content="Gufo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Gufo owl logo beside the text: Gufo, the Open Source Strix Halo AI engine" />
    {Astro.site && <meta property="og:url" content={absolute(pagePath)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen flex flex-col bg-ivory text-ink selection:bg-forest/20">
    <slot />
  </body>
</html>

<script>
  // Give every code block a copy button. Blocks with a header swap their
  // language label for it; bare <pre class="code-block"> get a floating one.
  document.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
    const pre = block.matches('pre') ? block : block.querySelector('pre');
    if (!pre) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.trimEnd());
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });

    const header = block.querySelector('.code-block-header');
    if (header) {
      header.lastElementChild?.replaceWith(button);
    } else {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      block.replaceWith(wrap);
      wrap.append(block, button);
    }
  });
</script>
