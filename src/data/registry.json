  "extensions": [
    {
      "name": "deepseek41flash",
      "description": "DeepSeek V4.1 Flash on Strix Halo: DSpark drafting, vision, tool calls and SSD expert streaming",
      "homepage": "https://github.com/franzmoca/ds41-gufo-extension",
      "source": "https://github.com/franzmoca/ds41-gufo-extension",
      "license": "MIT",
      "maintainers": [
        "@franzmoca"
      ],
      "releases": [
        {
          "version": "0.1.0",
          "revision": "ab48afcab3390f781db703a9c09c2fd52c29fc24",
          "digest": "sha256:a531ab549fd4525c995b71e6aa2ee8c2692b5167f73a611753a6f29ca30b842c",
          "apiVersion": ">= 0.2.14",
          "platforms": [
            "linux"
          ]
        }
      ],
      "providers": [
        {
          "id": "deepseek41",
          "capability": "text",
          "keys": [
            "gguf:deepseek41"
          ],
          "modelIds": [
            "DeepSeek V4.1 Flash"
          ],
          "speculative": [
            "dspark"
          ]
        }
      ],
      "options": [
        {
          "name": "--dspark-model",
          "help": "DSpark drafter GGUF for --speculative dspark"
        },
        {
          "name": "--prefill-batch",
          "help": "Most prompt tokens per prefill batch, 16 to 4096 (default: 2048)"
        },
        {
          "name": "--exact-prefill",
          "help": "Run every decoder layer over every prompt token instead of each prompt's last 140"
        },
        {
          "name": "--stream-experts",
          "help": "Keep dense weights resident and stream routed experts from the SSD through a bounded cache"
        },
        {
          "name": "--expert-cache-bytes",
          "help": "With --stream-experts: streamed expert cache bytes (default: what the sessions leave)"
        }
      ]
    },
    {
      "name": "flint",
      "description": "Flint 40B MoE text generation",
      "homepage": "https://github.com/brunobarbosaux-ai/flint-gufo-extension",
      "source": "https://github.com/brunobarbosaux-ai/flint-gufo-extension",
      "license": "MIT",
      "maintainers": [
        "@brunobarbosaux-ai"
      ],
      "releases": [
        {
          "version": "0.1.1",
