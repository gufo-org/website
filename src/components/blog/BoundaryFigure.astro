---
// The target graph of the extension design: executables compile their own
// generated registry, extensions link down to gufo_ext_runtime, and serving,
// HTTP and the CLI meet models only through the registry interface — never
// by including or linking model code. Static single-frame diagram.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

const green = '#3f7a4f';
const blue = '#4f86b8';
const teal = '#3d8a8a';
---
<figure class="bdf">
  <p class="bdf-eyebrow"><span class="bdf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}The link graph</p>
  <div class="bdf-scroll">
    <svg viewBox="0 0 760 360" role="img" aria-label="Executables compile their own generated registry. Below them, extension libraries and serving libraries sit side by side: extensions never include or link serving code, and serving sees extensions only through the registry interface. Both link down to gufo_ext_runtime, then to the cache and core, and finally the platform leaves.">
      <defs>
        <marker id="bdf-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" class="bdf-arrowhead" />
        </marker>
      </defs>

      <text x="24" y="14" class="bdf-head">Executables · each compiles its own generated registry.cpp</text>

      {['gufo', 'gufo-kernel-bench', 'test binaries'].map((name, i) => (
        <g>
          <rect x={24 + i * 254} y="22" width="204" height="40" rx="8" class="bdf-exe" />
          <text x={126 + i * 254} y="40" class="bdf-title" text-anchor="middle">{name}</text>
          <text x={126 + i * 254} y="54" class="bdf-sub" text-anchor="middle">+ registry.cpp</text>
          <line x1={126 + i * 254} y1="62" x2={126 + i * 254} y2="86" class="bdf-flow" marker-end="url(#bdf-arrow)" />
        </g>
      ))}

      <g style={`--c: ${green}`}>
        <rect x="24" y="90" width="290" height="70" rx="10" class="bdf-box" />
        <text x="169" y="116" class="bdf-title" text-anchor="middle">extensions</text>
        <text x="169" y="132" class="bdf-sub" text-anchor="middle">gufo_&lt;name&gt; · family libraries</text>
        <text x="169" y="148" class="bdf-sub" text-anchor="middle">model code · kernels · adapters</text>
      </g>
      <g style={`--c: ${blue}`}>
        <rect x="446" y="90" width="290" height="70" rx="10" class="bdf-box" />
        <text x="591" y="116" class="bdf-title" text-anchor="middle">gufo_serving · gufo_http · gufo_llm_cli</text>
        <text x="591" y="132" class="bdf-sub" text-anchor="middle">scheduler · pool · cache glue · HTTP</text>
      </g>

      <rect x="336" y="100" width="88" height="50" rx="8" class="bdf-reg" />
      <text x="380" y="121" class="bdf-reg-text" text-anchor="middle">Registry</text>
      <text x="380" y="135" class="bdf-reg-text" text-anchor="middle">interface</text>
      <line x1="314" y1="125" x2="332" y2="125" class="bdf-flow" marker-end="url(#bdf-arrow)" />
      <line x1="446" y1="125" x2="428" y2="125" class="bdf-flow" marker-end="url(#bdf-arrow)" />

      <line x1="318" y1="168" x2="442" y2="168" class="bdf-forbid" />
      <text x="380" y="184" class="bdf-forbid-text" text-anchor="middle">✗ never includes · never links</text>

      <g style={`--c: ${teal}`}>
        <line x1="169" y1="160" x2="169" y2="204" class="bdf-flow" marker-end="url(#bdf-arrow)" />
        <line x1="591" y1="160" x2="591" y2="204" class="bdf-flow" marker-end="url(#bdf-arrow)" />
        <rect x="24" y="210" width="712" height="44" rx="10" class="bdf-box" />
        <text x="380" y="230" class="bdf-title" text-anchor="middle">include/gufo/ext/ · gufo_ext_runtime</text>
        <text x="380" y="245" class="bdf-sub" text-anchor="middle">API types · registry · host services · runner defaults</text>
      </g>

      <line x1="169" y1="254" x2="169" y2="274" class="bdf-flow" marker-end="url(#bdf-arrow)" />
      <line x1="591" y1="254" x2="591" y2="274" class="bdf-flow" marker-end="url(#bdf-arrow)" />
      <rect x="24" y="280" width="344" height="36" rx="8" class="bdf-flat" />
      <text x="196" y="302" class="bdf-title" text-anchor="middle">gufo_cache · gufo_cache_hip</text>
      <rect x="392" y="280" width="344" height="36" rx="8" class="bdf-flat" />
      <text x="564" y="302" class="bdf-title" text-anchor="middle">gufo_core · HIP utils · GGUF · sampling</text>

      <line x1="380" y1="316" x2="380" y2="330" class="bdf-flow" marker-end="url(#bdf-arrow)" />
      <rect x="24" y="336" width="712" height="20" rx="8" class="bdf-flat" />
      <text x="380" y="350" class="bdf-sub" text-anchor="middle">gufo_platform · gufo_logging · gufo_hip_host</text>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .bdf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .bdf-eyebrow { display: flex; align-items: center; gap: 8px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .bdf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .bdf-scroll { margin: 14px 0; overflow-x: auto; }
  .bdf svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .bdf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .bdf-arrowhead { fill: var(--color-ink-3); }
  .bdf-flow { stroke: var(--color-ink-3); stroke-width: 1.2; stroke-opacity: 0.6; }

  .bdf-exe { fill: var(--color-ivory); stroke: var(--color-line-strong); }
  .bdf-box { fill: color-mix(in srgb, var(--c) 12%, white); stroke: var(--c); stroke-width: 1.5; }
  .bdf-flat { fill: var(--color-paper); stroke: var(--color-line-strong); }
  .bdf-title { font: 11.5px var(--font-mono); fill: var(--color-ink); }
  .bdf-sub { font: italic 10.5px var(--font-sans); fill: var(--color-ink-3); }

  .bdf-reg { fill: color-mix(in srgb, #3d8a8a 12%, white); stroke: #3d8a8a; stroke-width: 1.3; stroke-dasharray: 5 3; }
  .bdf-reg-text { font: 10.5px var(--font-mono); fill: color-mix(in srgb, #3d8a8a 85%, black); }

  .bdf-forbid { stroke: #b8336a; stroke-width: 1.4; stroke-dasharray: 4 3; }
  .bdf-forbid-text { font: italic 11px var(--font-sans); fill: #b8336a; }

  .bdf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
