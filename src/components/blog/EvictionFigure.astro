---
// The RAM eviction order, in the style of the other blog figures: a nearly
// full budget, a new checkpoint that doesn't fit, and the classes removed in
// order until it does. Sizes are illustrative units. Inline SVG rendered on
// the server.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

const classes = {
  retry: { order: 1, name: 'retry copies', c: '#c27a2c' },
  cheap: { order: 2, name: 'cheap checkpoints', c: '#9a5c8a' },
  idle: { order: 3, name: 'idle conversations', c: '#4f86b8' },
  reused: { order: 4, name: 'reused conversations', c: '#3f7a4f' },
};
type Class = keyof typeof classes;

// `gone` is the step that evicts a checkpoint.
const held: { name: string; size: number; cls: Class; gone?: number }[] = [
  { name: 'A@8k', size: 3, cls: 'reused' },
  { name: 'A@4k', size: 3, cls: 'reused' },
  { name: 'B@8k', size: 3, cls: 'idle' },
  { name: 'B@4k', size: 2, cls: 'idle' },
  { name: 'C', size: 2, cls: 'cheap', gone: 3 },
  { name: 'D', size: 1, cls: 'cheap', gone: 3 },
  { name: 'A↻', size: 2, cls: 'retry', gone: 2 },
];
const budget = 17;
const incoming = 5;
const unit = 30;
const left = 150;
const x = (u: number) => left + u * unit;
let cursor = 0;
const chips = held.map((h) => {
  const chip = { ...h, from: cursor };
  cursor += h.size;
  return chip;
});
const used = cursor;
// Free room after each step: evictions add their sizes back.
const freeAt = (step: number) => budget - used + held.filter((h) => h.gone !== undefined && step >= h.gone).reduce((s, h) => s + h.size, 0);

const ramY = 64;
const newY = 132;
const legendY = 196;

const steps = [
  `A new checkpoint needs ${incoming} units, but only ${freeAt(1)} unit is free in the RAM budget.`,
  `Retry copies go first: they only make resending the same request instant. Now ${freeAt(2)} units are free, still not enough.`,
  `Next go cheap checkpoints, whose private state costs far more than the prefill they would save. ${freeAt(3)} units are free.`,
  'The new checkpoint is admitted. Idle conversations would be next, and reused ones last.',
];
const show = frames(steps.length);
import StepControls from './StepControls.astro';
import StepText from './StepText.astro';
import { frames } from './steps';
---
<figure class="evf" data-steps={steps.length}>
  <p class="evf-eyebrow"><span class="fig-eyebrow-title"><span class="evf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}Making room in RAM</span><span class="fig-eyebrow-side"><StepControls count={steps.length} /></span></p>
  <div class="evf-scroll">
    <svg viewBox={`0 0 760 ${legendY + 20}`} role="img" aria-label={`The RAM budget holds checkpoints from reused and idle conversations, two cheap checkpoints and a retry copy, with ${freeAt(1)} unit free. A new checkpoint needs ${incoming}. The retry copy is evicted first, then the two cheap checkpoints, and then the new checkpoint fits. Idle and reused conversations stay.`}>
      <text x="24" y="26" class="evf-head">RAM budget · {budget} units</text>

      <rect x="24" y={ramY - 14} width="104" height="28" rx="6" class="evf-tag" />
      <text x="76" y={ramY + 4.5} class="evf-tag-text" text-anchor="middle">held</text>
      <rect x={x(0) - 4} y={ramY - 20} width={budget * unit + 8} height="40" rx="8" class="evf-budget" />
      {chips.map((c) => {
        const x1 = x(c.from) + 2;
        const w = c.size * unit - 4;
        const live = c.gone === undefined ? '1-' : `1-${c.gone - 1}`;
        return (
          <g style={`--c: ${classes[c.cls].c}`}>
            <g {...show(live)}>
              <rect x={x1} y={ramY - 14} width={w} height="28" rx="6" class="evf-chip" />
              <text x={x1 + w / 2} y={ramY + 4.5} class="evf-chip-text" text-anchor="middle">{c.name}</text>
            </g>
            {c.gone !== undefined && (
              <g {...show(`${c.gone}-`)}>
                <rect x={x1} y={ramY - 14} width={w} height="28" rx="6" class="evf-ghost" />
                <text x={x1 + w / 2} y={ramY + 4.5} class="evf-ghost-text" text-anchor="middle">{c.size > 1 ? 'evicted' : '×'}</text>
              </g>
            )}
          </g>
        );
      })}
      {[1, 2, 3, 4].map((step) => (
        <text x={x(budget) + 12} y={ramY + 4.5} class="evf-free" {...show(String(step))}>{freeAt(step)} free</text>
      ))}

      <rect x="24" y={newY - 14} width="104" height="28" rx="6" class="evf-tag" />
      <text x="76" y={newY + 4.5} class="evf-tag-text" text-anchor="middle">new</text>
      <g style="--c: #3d8a8a">
        <rect x={x(0) + 2} y={newY - 14} width={incoming * unit - 4} height="28" rx="6" class="evf-chip" {...show('4-')} />
        <rect x={x(0) + 2} y={newY - 14} width={incoming * unit - 4} height="28" rx="6" class="evf-wait" {...show('1-3')} />
        <text x={x(0) + incoming * unit / 2} y={newY + 4.5} class="evf-chip-text" text-anchor="middle">E@6k</text>
      </g>
      <text x={x(incoming) + 12} y={newY + 4.5} class="evf-status" {...show('1-3')}>needs {incoming} units, doesn't fit yet</text>
      <text x={x(incoming) + 12} y={newY + 4.5} class="evf-status is-ok" {...show('4-')}>✓ admitted</text>

      <text x="24" y={legendY - 18} class="evf-head">Evicted first → last</text>
      {Object.values(classes).map((k, i) => (
        <g transform={`translate(${24 + [0, 140, 310, 485][i]} ${legendY})`} style={`--c: ${k.c}`}>
          <rect x="0" y="-10" width="14" height="12" rx="3" class="evf-chip" />
          <text x="20" y="0" class="evf-legend">{k.order} · {k.name}</text>
        </g>
      ))}
    </svg>
  </div>
  <StepText steps={steps} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .evf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .evf-eyebrow { display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .evf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .evf-scroll { margin: 14px 0; overflow-x: auto; }
  .evf svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .evf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .evf-tag { fill: var(--color-ivory); stroke: var(--color-line-strong); }
  .evf-tag-text { font: 12px var(--font-mono); fill: var(--color-ink); }
  .evf-budget { fill: none; stroke: var(--color-ink-3); stroke-width: 1.2; }
  .evf-chip { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .evf-chip-text { font: 12px var(--font-mono); fill: var(--color-ink); }
  .evf-ghost { fill: none; stroke: var(--color-ink-4); stroke-dasharray: 3 3; }
  .evf-ghost-text { font: italic 11px var(--font-sans); fill: var(--color-ink-4); }
  .evf-wait { fill: none; stroke: var(--c); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .evf-free { font: 11px var(--font-mono); fill: var(--color-ink-3); }
  .evf-status { font: italic 12px var(--font-sans); fill: #b8336a; }
  .evf-status.is-ok { font-style: normal; font-weight: 600; fill: var(--color-forest); }
  .evf-legend { font: 12px var(--font-sans); fill: var(--color-ink-3); }

  .evf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
