---
// The "restart" story from the cache explorer, in the style of the other
// blog figures: what is on disk just before a restart, and the two outcomes
// depending on whether the newer checkpoint's manifest was already durable.
// Inline SVG rendered on the server.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

const number = (t: number) => t.toLocaleString('en-US');
const chunk = 2048;
const prompt = 12800;
const durable = 8192;
const queued = 12288;
const left = 24;
const width = 712;
const x = (t: number) => left + (t / prompt) * width;
const colours = { durable: '#3f7a4f', queued: '#c27a2c', restored: '#3f7a4f', prefill: '#4f86b8' };

const chunks = Array.from({ length: queued / chunk }, (_, i) => ({ i, from: i * chunk, to: (i + 1) * chunk, ok: durable >= (i + 1) * chunk }));

const palette = ['#3f7a4f', '#4f86b8', '#c27a2c', '#3d8a8a', '#9a5c8a'];
const cell = 7;
const blockTop = 52;
const block = (cx: number, seed: number) =>
  Array.from({ length: 9 }, (_, k) => ({
    x: cx - 1.5 * cell + (k % 3) * cell,
    y: blockTop + Math.floor(k / 3) * cell,
    fill: palette[(k * 2 + seed) % palette.length],
  }));
const diskTop = 84;

const outcomes = [
  { head: `Restart after A@${number(queued)}'s manifest is durable`, top: 162, restored: queued },
  { head: `Restart while A@${number(queued)} is still queued`, top: 256, restored: durable },
];
const gap = 1.5;
const bottom = outcomes[1].top + 46;
---
<figure class="rsf">
  <p class="rsf-eyebrow"><span class="rsf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}Queued is not durable</p>
  <div class="rsf-scroll">
    <svg viewBox={`0 0 760 ${bottom + 40}`} role="img" aria-label={`Before a restart, A@${number(durable)} is durable on disk and A@${number(queued)} is still queued. If the restart comes after A@${number(queued)}'s manifest is durable, a ${number(prompt)}-token request restores ${number(queued)} tokens and prefills ${number(prompt - queued)}. If it comes while the write is queued, only ${number(durable)} tokens come back and ${number(prompt - durable)} are prefilled.`}>
      <text x={left} y="26" class="rsf-head">On disk, just before the restart</text>

      <text x={x(durable)} y={blockTop - 8} class="rsf-cp-label" text-anchor="middle">A@{number(durable)} · manifest durable</text>
      {block(x(durable), 1).map((s) => <rect x={s.x} y={s.y} width={cell} height={cell} fill={s.fill} class="rsf-state" />)}
      <line x1={x(durable)} y1={blockTop + 3 * cell + 1} x2={x(durable)} y2={diskTop} class="rsf-cp-line" />

      <text x={x(queued) + 1.5 * cell} y={blockTop - 8} class="rsf-cp-label is-queued" text-anchor="end">A@{number(queued)} · queued</text>
      <rect x={x(queued) - 1.5 * cell} y={blockTop} width={3 * cell} height={3 * cell} rx="2" class="rsf-pending" />
      <line x1={x(queued)} y1={blockTop + 3 * cell + 1} x2={x(queued)} y2={diskTop} class="rsf-pending-line" />

      {chunks.map((c) => {
        const x1 = x(c.from) + gap;
        const x2 = x(c.to) - gap;
        return (
          <g style={`--c: ${c.ok ? colours.durable : colours.queued}`}>
            <rect x={x1} y={diskTop} width={x2 - x1} height="28" rx="6" class={c.ok ? 'rsf-chunk' : 'rsf-chunk is-queued'} />
            <text x={(x1 + x2) / 2} y={diskTop + 18.5} class={c.ok ? 'rsf-chunk-text' : 'rsf-chunk-text is-queued'} text-anchor="middle">{c.ok ? `C${c.i + 1}` : `C${c.i + 1} · queued`}</text>
          </g>
        );
      })}

      {outcomes.map((o) => {
        const segments = [
          { from: 0, to: o.restored, c: colours.restored, label: 'restored from disk' },
          { from: o.restored, to: prompt, c: colours.prefill, label: 'prefilled' },
        ];
        return (
          <g>
            <text x={left} y={o.top - 12} class="rsf-head">{o.head}</text>
            {segments.map((s, i) => {
              const x1 = x(s.from) + (i > 0 ? gap : 0);
              const x2 = x(s.to) - (i === 0 ? gap : 0);
              const wide = x2 - x1 > 60;
              return (
                <g style={`--c: ${s.c}`}>
                  <rect x={x1} y={o.top} width={x2 - x1} height="28" rx="6" class="rsf-seg" />
                  {wide && <text x={(x1 + x2) / 2} y={o.top + 18.5} class="rsf-seg-count" text-anchor="middle">{number(s.to - s.from)}</text>}
                  <text x={wide ? (x1 + x2) / 2 : x2} y={o.top + 46} class="rsf-seg-label" text-anchor={wide ? 'middle' : 'end'}>{wide ? s.label : `${number(s.to - s.from)} ${s.label}`}</text>
                </g>
              );
            })}
          </g>
        );
      })}

      <text x={left} y={bottom + 26} class="rsf-note">A checkpoint exists on disk only once its manifest is renamed into place, after its chunks and state are synced.</text>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rsf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .rsf-eyebrow { display: flex; align-items: center; gap: 8px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .rsf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .rsf-scroll { margin: 14px 0; overflow-x: auto; }
  .rsf svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .rsf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .rsf-cp-label { font: 11px var(--font-mono); fill: var(--color-ink-3); }
  .rsf-cp-label.is-queued { font-style: italic; fill: #8a5a1f; }
  .rsf-note { font: italic 12px var(--font-sans); fill: var(--color-ink-3); }
  .rsf-state { stroke: var(--color-paper); stroke-width: 1; fill-opacity: 0.75; }
  .rsf-cp-line { stroke: var(--color-ink-3); stroke-width: 1.2; }
  .rsf-pending { fill: none; stroke: #c27a2c; stroke-dasharray: 3 3; }
  .rsf-pending-line { stroke: #c27a2c; stroke-dasharray: 3 3; }

  .rsf-chunk { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .rsf-chunk.is-queued { fill: color-mix(in srgb, var(--c) 6%, white); stroke-dasharray: 4 3; }
  .rsf-chunk-text { font: 12px var(--font-mono); fill: var(--color-ink); }
  .rsf-chunk-text.is-queued { font-style: italic; fill: color-mix(in srgb, var(--c) 75%, black); }

  .rsf-seg { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .rsf-seg-count { font: 13px var(--font-mono); fill: var(--color-ink); }
  .rsf-seg-label { font: italic 12px var(--font-sans); fill: color-mix(in srgb, var(--c) 75%, black); }

  .rsf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
