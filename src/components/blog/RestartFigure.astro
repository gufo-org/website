---
// The disk publication order, in the style of the other blog figures: A@8,192
// is complete on disk, A@12,288 is written in order (chunks and state first,
// manifest last), and a restart after each step restores whatever a manifest
// lists. Files that no manifest lists are ignored and reclaimed in the
// background. One step per stage. Inline SVG rendered on the server.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

const number = (t: number) => t.toLocaleString('en-US');
const chunk = 2048;
const prompt = 12800;
const durable = 8192;
const queued = 12288;
const left = 160;
const span = 400;
const x = (t: number) => left + (t / prompt) * span;
const gap = 1.5;
const colours = { durable: '#3f7a4f', written: '#c27a2c', prefill: '#4f86b8' };
const box = (i: number) => ({ x1: x(i * chunk) + gap, x2: x((i + 1) * chunk) - gap });
const names = Array.from({ length: queued / chunk }, (_, i) => `C${i + 1}`);
const fresh = durable / chunk;

// Each file is drawn in one of three states: not on disk yet, on disk but
// listed by no manifest, or part of a published checkpoint.
type State = 'absent' | 'written' | 'durable';
const css = (s: State) => `rsf-file is-${s}`;
const colour = (s: State) => (s === 'written' ? colours.written : colours.durable);

const stateX = 584;
const stateW = 56;
const manifestX = 648;
const manifestW = 88;
const rows = { chunks: 64, older: 108, newer: 148 };
const restartTop = 210;
const bottom = restartTop + 46;

// Per step: the state of A@12,288's new files and what a restart would restore.
const stages: { range: string; files: State; manifest: State; manifestText: string; restored: number }[] = [
  { range: '1', files: 'absent', manifest: 'absent', manifestText: 'queued', restored: durable },
  { range: '2', files: 'written', manifest: 'absent', manifestText: 'no manifest', restored: durable },
  { range: '3-', files: 'durable', manifest: 'durable', manifestText: '✓ renamed', restored: queued },
];

const steps = [
  `A@${number(durable)} is complete on disk: chunks C1 to C4, its state file and its manifest. A@${number(queued)} waits in the background queue; none of it is on disk yet.`,
  `The writer syncs A@${number(queued)}'s new chunks C5 and C6 and its state file, then their directories. No manifest lists them yet, so a restart ignores them, deletes them in the background and restores A@${number(durable)}.`,
  `The manifest is written, synced and renamed into place. A@${number(queued)} now exists: it lists C1 to C6, four of them shared with A@${number(durable)}, and a restart restores ${number(queued)} tokens.`,
];
const show = frames(steps.length);
import StepControls from './StepControls.astro';
import StepText from './StepText.astro';
import { frames } from './steps';
---
<figure class="rsf" data-steps={steps.length}>
  <p class="rsf-eyebrow"><span class="fig-eyebrow-title"><span class="rsf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}The manifest publishes a checkpoint</span><span class="fig-eyebrow-side"><StepControls count={steps.length} /></span></p>
  <div class="rsf-scroll">
    <svg viewBox={`0 0 760 ${bottom + 40}`} role="img" aria-label={`A@${number(durable)} is complete on disk with chunks C1 to C4, a state file and a manifest. A@${number(queued)} is queued. First its new chunks C5 and C6 and its state file are written and synced; no manifest lists them, so a restart ignores them and restores ${number(durable)} tokens. Then its manifest is renamed into place; it lists C1 to C6, and a restart restores ${number(queued)} tokens.`}>
      <text x="24" y="26" class="rsf-head">On disk</text>
      <text x={left} y="40" class="rsf-col">chunk files, shared</text>
      <text x={stateX + stateW / 2} y="40" class="rsf-col" text-anchor="middle">state</text>
      <text x={manifestX + manifestW / 2} y="40" class="rsf-col" text-anchor="middle">manifest</text>

      <rect x="24" y={rows.chunks - 14} width="112" height="28" rx="6" class="rsf-chip" />
      <text x="80" y={rows.chunks + 4.5} class="rsf-chip-text" text-anchor="middle">chunks</text>
      {names.map((name, i) => {
        const b = box(i);
        const cell = (s: State, range?: string) => (
          <g style={`--c: ${colour(s)}`} {...(range ? show(range) : {})}>
            <rect x={b.x1} y={rows.chunks - 14} width={b.x2 - b.x1} height="28" rx="6" class={css(s)} />
            <text x={(b.x1 + b.x2) / 2} y={rows.chunks + 4.5} class={`rsf-file-text is-${s}`} text-anchor="middle">{name}</text>
          </g>
        );
        return fresh > i ? cell('durable') : stages.map((st) => cell(st.files, st.range));
      })}

      <rect x="24" y={rows.older - 14} width="112" height="28" rx="6" class="rsf-chip" />
      <text x="80" y={rows.older + 4.5} class="rsf-chip-text" text-anchor="middle">A@{number(durable)}</text>
      <g style={`--c: ${colours.durable}`}>
        {names.slice(0, fresh).map((name, i) => (
          <g>
            <rect x={box(i).x1} y={rows.older - 11} width={box(i).x2 - box(i).x1} height="22" rx="5" class="rsf-ref" />
            <text x={(box(i).x1 + box(i).x2) / 2} y={rows.older + 4} class="rsf-ref-text" text-anchor="middle">→ {name}</text>
          </g>
        ))}
        <rect x={stateX} y={rows.older - 14} width={stateW} height="28" rx="6" class={css('durable')} />
        <text x={stateX + stateW / 2} y={rows.older + 4.5} class="rsf-file-text is-durable" text-anchor="middle">state</text>
        <rect x={manifestX} y={rows.older - 14} width={manifestW} height="28" rx="6" class={css('durable')} />
        <text x={manifestX + manifestW / 2} y={rows.older + 4.5} class="rsf-file-text is-durable" text-anchor="middle">✓ renamed</text>
      </g>

      <rect x="24" y={rows.newer - 14} width="112" height="28" rx="6" class="rsf-chip" />
      <text x="80" y={rows.newer + 4.5} class="rsf-chip-text" text-anchor="middle">A@{number(queued)}</text>
      {stages.map((st) => (
        <g {...show(st.range)}>
          <g class={st.manifest === 'durable' ? 'rsf-listed' : 'rsf-unlisted'} style={`--c: ${colours.durable}`}>
            {names.map((name, i) => (
              <g>
                <rect x={box(i).x1} y={rows.newer - 11} width={box(i).x2 - box(i).x1} height="22" rx="5" class="rsf-ref" />
                <text x={(box(i).x1 + box(i).x2) / 2} y={rows.newer + 4} class="rsf-ref-text" text-anchor="middle">→ {name}</text>
              </g>
            ))}
          </g>
          <g style={`--c: ${colour(st.files)}`}>
            <rect x={stateX} y={rows.newer - 14} width={stateW} height="28" rx="6" class={css(st.files)} />
            <text x={stateX + stateW / 2} y={rows.newer + 4.5} class={`rsf-file-text is-${st.files}`} text-anchor="middle">state</text>
          </g>
          <g style={`--c: ${colour(st.manifest)}`}>
            <rect x={manifestX} y={rows.newer - 14} width={manifestW} height="28" rx="6" class={css(st.manifest)} />
            <text x={manifestX + manifestW / 2} y={rows.newer + 4.5} class={`rsf-file-text is-${st.manifest}`} text-anchor="middle">{st.manifestText}</text>
          </g>
        </g>
      ))}
      <text x={left} y={rows.newer + 30} class="rsf-aside" {...show('2')}>C5, C6 and the state file are on disk, but no manifest lists them yet.</text>

      {stages.map((st) => {
        const segments = [
          { from: 0, to: st.restored, c: colours.durable, label: 'restored from disk' },
          { from: st.restored, to: prompt, c: colours.prefill, label: 'prefilled' },
        ];
        return (
          <g {...show(st.range)}>
            <text x="24" y={restartTop - 12} class="rsf-head">If Gufo restarts now, a {number(prompt)}-token request</text>
            {segments.map((s, i) => {
              const x1 = x(s.from) + (i > 0 ? gap : 0);
              const x2 = x(s.to) - (i === 0 ? gap : 0);
              const wide = x2 - x1 > 60;
              return (
                <g style={`--c: ${s.c}`}>
                  <rect x={x1} y={restartTop} width={x2 - x1} height="28" rx="6" class="rsf-seg" />
                  {wide && <text x={(x1 + x2) / 2} y={restartTop + 18.5} class="rsf-seg-count" text-anchor="middle">{number(s.to - s.from)}</text>}
                  <text x={wide ? (x1 + x2) / 2 : x2} y={restartTop + 46} class="rsf-seg-label" text-anchor={wide ? 'middle' : 'end'}>{wide ? s.label : `${number(s.to - s.from)} ${s.label}`}</text>
                </g>
              );
            })}
            <text x={stateX} y={restartTop + 18.5} class="rsf-outcome">restores A@{number(st.restored)}</text>
          </g>
        );
      })}

      <text x="24" y={bottom + 26} class="rsf-note">A checkpoint exists on disk only once its manifest is renamed into place, after its chunks and state are synced.</text>
    </svg>
  </div>
  <StepText steps={steps} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rsf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .rsf-eyebrow { display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .rsf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .rsf-scroll { margin: 14px 0; overflow-x: auto; }
  .rsf svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .rsf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .rsf-col { font: italic 11px var(--font-sans); fill: var(--color-ink-4); }
  .rsf-note { font: italic 12px var(--font-sans); fill: var(--color-ink-3); }
  .rsf-aside { font: italic 11.5px var(--font-sans); fill: #8a5a1f; }
  .rsf-outcome { font: 12px var(--font-mono); fill: var(--color-ink-2); }

  .rsf-chip { fill: var(--color-ivory); stroke: var(--color-line-strong); }
  .rsf-chip-text { font: 12px var(--font-mono); fill: var(--color-ink); }

  .rsf-file { stroke-width: 1.4; }
  .rsf-file.is-durable { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); }
  .rsf-file.is-written { fill: color-mix(in srgb, var(--c) 10%, white); stroke: var(--c); stroke-dasharray: 4 3; }
  .rsf-file.is-absent { fill: none; stroke: var(--color-ink-4); stroke-dasharray: 3 3; stroke-width: 1; }
  .rsf-file-text { font: 12px var(--font-mono); fill: var(--color-ink); }
  .rsf-file-text.is-written { font-style: italic; fill: #8a5a1f; }
  .rsf-file-text.is-absent { font: italic 12px var(--font-sans); fill: var(--color-ink-4); }

  .rsf-ref { fill: color-mix(in srgb, var(--c) 6%, white); stroke: var(--c); stroke-opacity: 0.6; }
  .rsf-ref-text { font: 11px var(--font-mono); fill: var(--color-ink-2); }
  .rsf-unlisted .rsf-ref { fill: none; stroke: var(--color-ink-4); stroke-opacity: 1; stroke-dasharray: 3 3; }
  .rsf-unlisted .rsf-ref-text { fill: var(--color-ink-4); font-style: italic; }

  .rsf-seg { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .rsf-seg-count { font: 13px var(--font-mono); fill: var(--color-ink); }
  .rsf-seg-label { font: italic 12px var(--font-sans); fill: color-mix(in srgb, var(--c) 75%, black); }

  .rsf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
