---
// What adding one model to Gufo means today: its own directory, plus the
// shared code files and the build / CI / registry files that each gain a
// mention. Stepped in four frames, in the style of the cache figures.
import StepControls from './StepControls.astro';
import StepText from './StepText.astro';
import { frames } from './steps';

interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

// Same palette the cache figures use for state blocks.
const green = '#3f7a4f';
const plum = '#9a5c8a';

const codeFiles = [
  { name: 'serve/inference_backend.cpp', note: 'a new runner · 4,070 lines' },
  { name: 'serve/openai_chat.cpp', note: 'its tool-call markers · 4,191 lines' },
  { name: 'bench/bench.cpp', note: 'a new bench path · ~1,300 lines' },
  { name: 'core/json_constraint.hpp', note: 'ToolFormat gains one value' },
  { name: 'core/text_sampling_defaults.hpp', note: 'a new sampling preset' },
];

const buildFiles = [
  { name: 'CMakeLists.txt', note: '225 lines name models' },
  { name: 'Checks.cmake', note: '+ test presets' },
  { name: 'workflows/', note: 'Windows targets' },
  { name: 'flake.nix', note: 'package.nix' },
  { name: 'devlab · impact', note: 'test profiles' },
];

const steps = [
  'A new model arrives as one directory: sources, kernels, tests and docs.',
  'Its runner joins a 4,070-line file, its tool-call markers join a 4,191-line file, and two core enums gain a value each.',
  'The build, the CI workflows, the Nix files and the two functional registries each carry its name by hand.',
  'Reviewing a new model means reviewing the core — and a fork re-merges every one of these hunks against upstream, forever.',
];
const show = frames(steps.length);

const chipY = (i: number) => 40 + i * 38;
const buildY = 268;
const busY = 254;
const boxMidY = 128;
---
<figure class="caf" data-steps={steps.length}>
  <p class="caf-eyebrow"><span class="fig-eyebrow-title"><span class="caf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}Adding one model, before extensions</span><span class="fig-eyebrow-side"><StepControls count={steps.length} /></span></p>
  <div class="caf-scroll">
    <svg viewBox="0 0 760 372" role="img" aria-label="A new model adds its own directory, but also edits shared code — inference_backend.cpp, openai_chat.cpp, bench.cpp and two core enums — and hand-maintained build, CI, Nix and functional registry files. Reviewing the model therefore means reviewing the core.">
      <defs>
        <marker id="caf-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" class="caf-arrowhead" />
        </marker>
      </defs>

      <text x="24" y="28" class="caf-head">The model · its own directory</text>
      <text x="268" y="28" class="caf-head">Shared code · every new model edits it</text>
      <text x="268" y="240" class="caf-head">Build, CI and registries · hand-maintained</text>

      <g style={`--c: ${green}`}>
        <rect x="24" y="78" width="180" height="100" rx="10" class="caf-box" />
        <text x="114" y="118" class="caf-box-title" text-anchor="middle">src/models/</text>
        <text x="114" y="136" class="caf-box-title" text-anchor="middle">&lt;new_model&gt;/</text>
        <text x="114" y="160" class="caf-box-note" text-anchor="middle">code · kernels · tests · docs</text>
      </g>

      {codeFiles.map((f, i) => (
        <g {...show('2-')}>
          <line x1="204" y1={boxMidY} x2="264" y2={chipY(i) + 16} class="caf-flow" marker-end="url(#caf-arrow)" />
          <rect x="268" y={chipY(i)} width="216" height="32" rx="6" class="caf-chip" />
          <text x="280" y={chipY(i) + 14} class="caf-chip-name">{f.name}</text>
          <text x="280" y={chipY(i) + 26} class="caf-chip-note">{f.note}</text>
        </g>
      ))}

      <g {...show('3-')}>
        <line x1="114" y1="178" x2="114" y2={busY} class="caf-flow" />
        <line x1="92" y1={busY} x2={92 + 4 * 144} y2={busY} class="caf-flow" />
      </g>
      {buildFiles.map((f, i) => (
        <g {...show('3-')}>
          <line x1={92 + i * 144} y1={busY} x2={92 + i * 144} y2={buildY - 4} class="caf-flow" marker-end="url(#caf-arrow)" />
          <rect x={24 + i * 144} y={buildY} width="136" height="42" rx="6" class="caf-chip" />
          <text x={36 + i * 144} y={buildY + 17} class="caf-chip-name">{f.name}</text>
          <text x={36 + i * 144} y={buildY + 31} class="caf-chip-note">{f.note}</text>
        </g>
      ))}

      <g {...show('4')} style={`--c: ${plum}`}>
        <rect x="24" y="326" width="712" height="34" rx="8" class="caf-band" />
        <text x="380" y="347" class="caf-band-text" text-anchor="middle">a model review is a core review · a fork re-merges these hunks forever</text>
      </g>
    </svg>
  </div>
  <StepText steps={steps} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .caf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .caf-eyebrow { display: flex; justify-content: space-between; align-items: center; gap: 12px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .caf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .caf-scroll { margin: 14px 0; overflow-x: auto; }
  .caf svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .caf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .caf-arrowhead { fill: var(--color-ink-3); }
  .caf-flow { stroke: var(--color-ink-3); stroke-width: 1.2; stroke-opacity: 0.6; }

  .caf-box { fill: color-mix(in srgb, var(--c) 12%, white); stroke: var(--c); stroke-width: 1.6; }
  .caf-box-title { font: 12.5px var(--font-mono); fill: var(--color-ink); }
  .caf-box-note { font: italic 11px var(--font-sans); fill: var(--color-ink-3); }

  .caf-chip { fill: var(--color-ivory); stroke: var(--color-line-strong); }
  .caf-chip-name { font: 10.5px var(--font-mono); fill: var(--color-ink); }
  .caf-chip-note { font: italic 10px var(--font-sans); fill: var(--color-ink-4); }

  .caf-band { fill: color-mix(in srgb, var(--c) 8%, white); stroke: var(--c); stroke-width: 1.2; stroke-dasharray: 5 3; }
  .caf-band-text { font: italic 12.5px var(--font-sans); fill: color-mix(in srgb, var(--c) 80%, black); }

  .caf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
