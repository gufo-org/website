---
// The "provenance" story from the cache explorer, in the style of the other
// blog figures: two independent cold prefills of the same 6,144 tokens keep
// separate chunks, and only a branch that really restores A shares A's rows.
// Inline SVG rendered on the server.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

// Same readable chunk size as the cache explorer.
const chunk = 2048;
const total = 8192;
const number = (t: number) => t.toLocaleString('en-US');
const left = 160;
const span = 440;
const x = (t: number) => left + (t / total) * span;
const sideX = 630;
const colours = { A: '#3f7a4f', B: '#4f86b8', C: '#3d8a8a' };

type Cell = { i: number; kind: 'computed' | 'ref'; owner: keyof typeof colours };
const rows: { name: string; c: string; y: number; cells: Cell[]; stores: string }[] = [
  { name: 'B@6,144', c: colours.B, y: 64, stores: '3 chunks', cells: [0, 1, 2].map((i) => ({ i, kind: 'computed', owner: 'B' })) },
  { name: 'A@6,144', c: colours.A, y: 112, stores: '3 chunks', cells: [0, 1, 2].map((i) => ({ i, kind: 'computed', owner: 'A' })) },
  { name: 'C@8,192', c: colours.C, y: 202, stores: '1 chunk + 3 refs', cells: [
    ...[0, 1, 2].map((i) => ({ i, kind: 'ref' as const, owner: 'A' as const })),
    { i: 3, kind: 'computed', owner: 'C' },
  ] },
];
const bottom = 226;

const palette = ['#3f7a4f', '#4f86b8', '#c27a2c', '#3d8a8a', '#9a5c8a'];
const cell = 6;
const blockTop = 134;
const block = Array.from({ length: 9 }, (_, k) => ({
  x: x(6144) - 1.5 * cell + (k % 3) * cell,
  y: blockTop + Math.floor(k / 3) * cell,
  fill: palette[(k * 2 + 1) % palette.length],
}));
---
<figure class="cof">
  <p class="cof-eyebrow"><span class="cof-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}Two cold prefills, one restore</p>
  <div class="cof-scroll">
    <svg viewBox={`0 0 760 ${bottom + 34}`} role="img" aria-label="B and A each compute the same 6,144 tokens cold and keep three chunks each; nothing is shared between them. C restores A's checkpoint at 6,144, references A's three chunks and computes one new chunk up to 8,192.">
      <defs>
        <marker id="cof-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" class="cof-arrowhead" />
        </marker>
      </defs>

      <text x="24" y="26" class="cof-head">Checkpoint</text>
      <text x={left} y="26" class="cof-head">Rows · {number(chunk)}-token chunks</text>
      <text x={sideX} y="26" class="cof-head">Stores</text>
      {[0, 2048, 4096, 6144, 8192].map((t) => <line x1={x(t)} y1="40" x2={x(t)} y2={bottom - 6} class="cof-grid" />)}

      {rows.map((r) => (
        <g>
          <rect x="24" y={r.y - 14} width="104" height="28" rx="6" class="cof-chip" style={`--c: ${r.c}`} />
          <text x="76" y={r.y + 4.5} class="cof-chip-text" text-anchor="middle">{r.name}</text>
          {r.cells.map((k) => {
            const x1 = x(k.i * chunk) + 2;
            const x2 = x((k.i + 1) * chunk) - 2;
            const label = k.kind === 'ref' ? `→ ${k.owner}:${k.i + 1}` : `${k.owner}:${k.i + 1}`;
            return (
              <g style={`--c: ${colours[k.owner]}`}>
                <rect x={x1} y={r.y - 14} width={x2 - x1} height="28" rx="6" class={`cof-cell is-${k.kind}`} />
                <text x={(x1 + x2) / 2} y={r.y + 4.5} class={`cof-cell-text is-${k.kind}`} text-anchor="middle">{label}</text>
              </g>
            );
          })}
          <text x={sideX} y={r.y + 4.5} class="cof-side">{r.stores}</text>
        </g>
      ))}

      <text x={x(7168)} y="92" class="cof-note" text-anchor="middle">same tokens,</text>
      <text x={x(7168)} y="106" class="cof-note" text-anchor="middle">not shared</text>

      {block.map((s) => <rect x={s.x} y={s.y} width={cell} height={cell} fill={s.fill} class="cof-state" />)}
      <line x1={x(6144)} y1={blockTop + 3 * cell + 2} x2={x(6144)} y2={rows[2].y - 18} class="cof-restore" marker-end="url(#cof-arrow)" />
      <text x={x(6144) - 2 * cell} y={blockTop + 13} class="cof-note" text-anchor="end">restore A@6,144</text>

      <text x="24" y={bottom + 20} class="cof-note">Seven chunks in memory: A's three, B's three and C's new one. C shares A's rows because it restored them.</text>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cof {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .cof-eyebrow { display: flex; align-items: center; gap: 8px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .cof-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .cof-scroll { margin: 14px 0; overflow-x: auto; }
  .cof svg { display: block; width: 100%; min-width: 560px; height: auto; }

  .cof-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .cof-note { font: italic 12px var(--font-sans); fill: var(--color-ink-3); }
  .cof-side { font: 11px var(--font-mono); fill: var(--color-ink-3); }
  .cof-grid { stroke: var(--color-line-strong); stroke-dasharray: 2 4; }
  .cof-restore { stroke: var(--color-ink-3); stroke-width: 1.4; }
  .cof-arrowhead { fill: var(--color-ink-3); }
  .cof-state { stroke: var(--color-paper); stroke-width: 1; fill-opacity: 0.75; }

  .cof-chip { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .cof-chip-text { font: 13px var(--font-mono); fill: var(--color-ink); }
  .cof-cell.is-computed { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .cof-cell.is-ref { fill: var(--color-ivory); stroke: color-mix(in srgb, var(--c) 55%, white); }
  .cof-cell-text { font: 12px var(--font-mono); fill: var(--color-ink); }
  .cof-cell-text.is-ref { font-size: 11px; fill: color-mix(in srgb, var(--c) 75%, black); }

  .cof figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
