---
// The hybrid counterpart of KvFigure: the same prompt through three recurrent
// layers and one attention layer, showing the two kinds of state left behind.
// The attention layer leaves one KV row per token; each recurrent layer leaves
// a fixed-size state and a short convolution history that only describe the
// last position. Inline SVG rendered on the server.
interface Props {
  figure?: number | string;
  caption?: string;
}

const { figure, caption } = Astro.props;

const sentence = 'Read the file main.cpp';
const tokens = ['Read', 'the', 'file', 'main', '.cpp'];
// Same token colours as KvFigure.
const palette = ['#3f7a4f', '#4f86b8', '#c27a2c', '#3d8a8a', '#9a5c8a'];
// Three recurrent layers to one attention layer, the usual mix in Qwen-style hybrids.
const layers = [
  { name: 'L1', kind: 'recurrent' },
  { name: 'L2', kind: 'recurrent' },
  { name: 'L3', kind: 'recurrent' },
  { name: 'L4', kind: 'attention' },
] as const;

const rowY = (i: number) => 84 + i * 42;
const lastY = rowY(tokens.length - 1);
const ghostY = rowY(tokens.length) + 6;
const layerX = (l: number) => 200 + l * 70;
const kvX = 500;
const attention = layers.length - 1;

// Recurrent layers pass their state down from one position to the next.
const chains = layers.flatMap((layer, l) =>
  layer.kind === 'recurrent' ? tokens.slice(1).map((_, i) => ({ x1: layerX(l), y1: rowY(i) + 7, x2: layerX(l), y2: rowY(i + 1) - 8 })) : [],
);
// Every layer after the first reads the layer below at the same position.
const links = layers.slice(1).flatMap((layer, l) =>
  layer.kind === 'recurrent' ? tokens.map((_, i) => ({ x1: layerX(l) + 7, y1: rowY(i), x2: layerX(l + 1) - 7, y2: rowY(i) })) : [],
);
// The attention layer reads every earlier position of the layer below.
const fan = tokens.flatMap((_, from) =>
  tokens.slice(from).map((_, k) => ({ x1: layerX(attention - 1), y1: rowY(from), x2: layerX(attention), y2: rowY(from + k) })),
);

// A recurrent state mixes every token read so far: a 4x4 block in all five colours.
const cell = 11;
const stateTop = lastY + 44;
const stateCells = (l: number) =>
  Array.from({ length: 16 }, (_, k) => ({
    x: layerX(l) - 2 * cell + (k % 4) * cell,
    y: stateTop + Math.floor(k / 4) * cell,
    c: palette[(k * 3 + l * 2 + Math.floor(k / 4)) % palette.length],
    o: 0.35 + ((k * 7 + l * 5) % 6) * 0.1,
  }));
// The convolution history keeps only the last three tokens.
const convTop = stateTop + 4 * cell + 8;
const convCells = (l: number) => [2, 3, 4].map((t, k) => ({ x: layerX(l) - 1.5 * cell + k * cell, y: convTop, c: palette[t] }));
const recurrent = layers.map((layer, l) => ({ ...layer, l })).filter((layer) => layer.kind === 'recurrent');
const labelX = layerX(recurrent[recurrent.length - 1].l) + 2 * cell + 8;
---
<figure class="hyf">
  <p class="hyf-eyebrow"><span class="hyf-dot"></span>{figure !== undefined && <>Fig. {figure} · </>}Prefill on a hybrid model</p>
  <p class="hyf-prompt">
    <span>Prompt: <q>{sentence}</q></span>
    <span class="hyf-legend"><span class="hyf-key is-rec"></span>recurrent layer <span class="hyf-key"></span>attention layer</span>
  </p>
  <div class="hyf-scroll">
    <svg viewBox="0 0 700 420" role="img" aria-label={`The prompt "${sentence}" passes through three recurrent layers and one attention layer. The attention layer leaves one KV row per token. Each recurrent layer leaves one fixed-size state and a short convolution history that describe only the last token, and are updated in place by the next token.`}>
      <defs>
        <marker id="hyf-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" class="hyf-arrowhead" />
        </marker>
        <marker id="hyf-tick" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" class="hyf-tickhead" />
        </marker>
      </defs>

      <text x="24" y="30" class="hyf-head">Tokens</text>
      <text x={(layerX(0) + layerX(attention)) / 2} y="30" class="hyf-head" text-anchor="middle">Model</text>
      <text x={kvX} y="30" class="hyf-head">Append-only rows · KV of L4</text>

      <rect x="168" y="50" width="274" height="224" rx="10" class="hyf-model" />
      {layers.map((layer, l) => <text x={layerX(l)} y="63" class="hyf-layer" text-anchor="middle">{layer.name}</text>)}
      <text x={kvX + 38} y="63" class="hyf-layer" text-anchor="middle">L4</text>

      {links.map((e) => <line {...e} class="hyf-link" />)}
      {fan.map((e) => <line {...e} class="hyf-edge" />)}
      {chains.map((e) => <line {...e} class="hyf-chain" marker-end="url(#hyf-tick)" />)}

      {tokens.map((token, i) => {
        const y = rowY(i);
        return (
          <g style={`--c: ${palette[i]}`}>
            <rect x="24" y={y - 14} width="104" height="28" rx="6" class="hyf-token" />
            <text x="76" y={y + 4.5} class="hyf-token-text" text-anchor="middle">{token}</text>
            <line x1="130" y1={y} x2={layerX(0) - 10} y2={y} class="hyf-flow" marker-end="url(#hyf-arrow)" />
            {layers.map((layer, l) =>
              layer.kind === 'recurrent'
                ? <rect x={layerX(l) - 7} y={y - 7} width="14" height="14" rx="3" class="hyf-node" />
                : <circle cx={layerX(l)} cy={y} r="7" class="hyf-node" />,
            )}
            <line x1={layerX(attention) + 9} y1={y} x2={kvX - 6} y2={y} class="hyf-flow" marker-end="url(#hyf-arrow)" />
            <rect x={kvX} y={y - 14} width="36" height="28" rx="3" class="hyf-cell" />
            <text x={kvX + 18} y={y + 4} class="hyf-cell-text" text-anchor="middle">K</text>
            <rect x={kvX + 40} y={y - 14} width="36" height="28" rx="3" class="hyf-cell" />
            <text x={kvX + 58} y={y + 4} class="hyf-cell-text" text-anchor="middle">V</text>
          </g>
        );
      })}

      {recurrent.map(({ l }) => (
        <>
          <line x1={layerX(l)} y1={lastY + 9} x2={layerX(l)} y2={stateTop - 4} class="hyf-chain" marker-end="url(#hyf-tick)" />
          {stateCells(l).map((s) => <rect x={s.x} y={s.y} width={cell} height={cell} fill={s.c} fill-opacity={s.o} class="hyf-state" />)}
          {convCells(l).map((s) => <rect x={s.x} y={s.y} width={cell} height={cell} fill={s.c} fill-opacity="0.6" class="hyf-state" />)}
        </>
      ))}
      <text x={labelX} y={stateTop + 2 * cell + 4} class="hyf-label">state</text>
      <text x={labelX} y={convTop + cell - 2} class="hyf-label">conv</text>

      <text x="168" y={convTop + 42} class="hyf-head">Private state · fixed size · valid only after “.cpp”</text>
      <text x="168" y={convTop + 58} class="hyf-note">The next token updates it in place. No new row, no way back.</text>

      <g class="hyf-ghost">
        <rect x="24" y={ghostY - 14} width="104" height="28" rx="6" />
        <text x="76" y={ghostY + 4.5} text-anchor="middle">next token</text>
        <rect x={kvX} y={ghostY - 14} width="36" height="28" rx="3" />
        <rect x={kvX + 40} y={ghostY - 14} width="36" height="28" rx="3" />
        <text x={kvX + 86} y={ghostY + 4}>+1 row</text>
      </g>
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .hyf {
    margin: 2.5rem 0;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  .hyf-eyebrow { display: flex; align-items: center; gap: 8px; font: 12px var(--font-mono); color: var(--color-ink-3); }
  .hyf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-forest); }
  .hyf-prompt { margin-top: 10px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; font-size: 14px; color: var(--color-ink-3); }
  .hyf-prompt q { font-family: var(--font-mono); font-size: 13px; color: var(--color-ink); }
  .hyf-legend { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; }
  .hyf-key { display: inline-block; width: 11px; height: 11px; border-radius: 50%; border: 1.4px solid var(--color-ink-3); margin-left: 8px; }
  .hyf-key.is-rec { border-radius: 3px; margin-left: 0; }
  .hyf-scroll { margin: 14px 0; overflow-x: auto; }
  .hyf svg { display: block; width: 100%; min-width: 540px; height: auto; }

  .hyf-head { font: 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--color-ink-4); }
  .hyf-note { font: italic 12px var(--font-sans); fill: var(--color-ink-3); }
  .hyf-layer, .hyf-label { font: 11px var(--font-mono); fill: var(--color-ink-3); }
  .hyf-model { fill: var(--color-ivory); stroke: var(--color-line-strong); }
  .hyf-edge { stroke: var(--color-ink-4); stroke-opacity: 0.3; stroke-width: 0.8; }
  .hyf-link { stroke: var(--color-ink-4); stroke-opacity: 0.45; stroke-width: 1; }
  .hyf-chain { stroke: var(--color-ink-3); stroke-width: 1.2; }
  .hyf-flow { stroke: var(--c); stroke-width: 1.4; }
  .hyf-arrowhead, .hyf-tickhead { fill: var(--color-ink-3); }

  .hyf-token { fill: color-mix(in srgb, var(--c) 14%, white); stroke: var(--c); stroke-width: 1.4; }
  .hyf-token-text { font: 13px var(--font-mono); fill: var(--color-ink); }
  .hyf-node { fill: color-mix(in srgb, var(--c) 30%, white); stroke: var(--c); stroke-width: 1.4; }
  .hyf-cell { fill: color-mix(in srgb, var(--c) 18%, white); stroke: color-mix(in srgb, var(--c) 60%, white); }
  .hyf-cell-text { font: 11px var(--font-mono); fill: color-mix(in srgb, var(--c) 75%, black); }
  .hyf-state { stroke: var(--color-paper); stroke-width: 1; }

  .hyf-ghost rect { fill: none; stroke: var(--color-ink-4); stroke-dasharray: 3 3; }
  .hyf-ghost text { font: italic 12px var(--font-sans); fill: var(--color-ink-4); }

  .hyf figcaption { font-family: var(--font-serif); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--color-ink-2); }
</style>
