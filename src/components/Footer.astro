---
const columns = [
  {
    title: 'Docs',
    links: [
      { name: 'Quickstart', href: '/docs#quickstart' },
      { name: 'Build from source', href: '/docs#build-from-source' },
    ],
  },
  {
    title: 'How it works',
    links: [
      { name: 'API', href: 'https://github.com/gufo-org/gufo/blob/main/docs/SERVER.md', external: true },
    ],
  },
  {
    title: 'Models',
    links: [
      { name: 'Qwen3.8 27B', href: '/benchmarks' },
      { name: 'Qwen3.8 Flash-Next', href: '/benchmarks' },
      { name: 'DeepSeek V4 Flash', href: '/benchmarks' },
    ],
  },
  {
    title: 'Project',
    links: [
      { name: 'GitHub', href: 'https://github.com/gufo-org/gufo', external: true },
      { name: 'OCI images', href: 'https://github.com/gufo-org/toolboxes', external: true },
    ],
  },
];---

<footer class="bg-paper border-t border-line text-ink mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/images/gufo-logo-128.jpg" alt="" width="28" height="28" class="w-7 h-7 rounded-md object-cover" />
          <span class="font-serif text-xl">Gufo</span>
        </a>
        <p class="mt-4 text-sm text-ink-3 leading-relaxed max-w-xs">
          Local AI for AMD Strix Halo. Open source, built with the community.
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="text-sm text-ink-4 mb-4">{col.title}</h3>
          <ul class="space-y-2.5 text-sm">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="text-ink-2 hover:text-ink hover:underline"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-6 border-t border-line flex flex-col sm:flex-row justify-between gap-2 text-xs text-ink-4">
      <span>MIT licensed. Model weights keep their own licenses.</span>
      <span>Built with Astro.</span>
    </div>
  </div>
</footer>
