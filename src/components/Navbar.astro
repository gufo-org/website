---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Philosophy', href: '/philosophy' },
  { name: 'Docs', href: '/docs' },
  { name: 'Benchmarks', href: '/benchmarks' },
  { name: 'Cache', href: '/cache' },
  { name: 'OCI Images', href: '/docs#toolboxes' },
];

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href.split('#')[0]));
---

<!-- Announcement Bar -->
<div class="bg-gradient-to-r from-emerald-800 via-teal-800 to-cyan-900 text-white text-xs py-1.5 px-4 text-center border-b border-emerald-700/50 font-medium">
  <span>⚡ <b>gufo</b> — local inference for AMD Strix Halo: Ryzen AI MAX+ 395, Radeon 8060S (<b>gfx1151</b>), up to 128 GiB unified memory</span>
</div>

<!-- Main Navbar -->
<nav class="sticky top-0 z-50 bg-[#242526] border-b border-[#3e4042] text-sm font-medium shadow-sm">
  <!-- Drawer state. Sibling of the overlay and panel so `peer-checked` can reach them. -->
  <input type="checkbox" id="nav-drawer" class="peer sr-only" aria-label="Open navigation menu" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 gap-3">
      <!-- Left: logo and desktop links -->
      <div class="flex items-center gap-6 min-w-0">
        <a href="/" class="flex items-center gap-2.5 hover:opacity-90 transition-opacity shrink-0">
          <img src="/images/gufo-logo.jpg" alt="gufo" class="w-8 h-8 rounded object-cover" />
          <span class="font-bold text-base text-white tracking-tight">gufo</span>
        </a>

        <div class="hidden md:flex items-center gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded text-sm transition-colors ${
                isActive(item.href) ? 'text-[#25c2a0] font-semibold' : 'text-slate-300 hover:text-white'
              }`}
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Right: desktop chrome, then the kebab on small screens -->
      <div class="flex items-center gap-3">
        <div class="hidden lg:flex items-center gap-1.5 px-2 py-0.5 rounded text-xs bg-[#1b1b1d] border border-[#3e4042] text-slate-300 font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>ROCm HIP · gfx1151</span>
        </div>

        <a
          href="https://github.com/gufo-org/gufo"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:flex items-center gap-1.5 px-2.5 py-1 text-xs text-slate-200 bg-[#1b1b1d] hover:bg-[#2d2f31] border border-[#3e4042] rounded transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span>GitHub</span>
        </a>

        <!-- Kebab -->
        <label
          for="nav-drawer"
          role="button"
          tabindex="0"
          aria-controls="nav-drawer"
          class="md:hidden flex items-center justify-center w-10 h-10 -mr-2 rounded text-slate-200 hover:bg-[#1b1b1d] cursor-pointer transition-colors"
        >
          <span class="sr-only">Open menu</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="12" cy="5" r="1.75" />
            <circle cx="12" cy="12" r="1.75" />
            <circle cx="12" cy="19" r="1.75" />
          </svg>
        </label>
      </div>
    </div>
  </div>

  <!-- Scrim: tapping outside closes the panel -->
  <label
    for="nav-drawer"
    class="md:hidden fixed inset-0 z-40 bg-black/60 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-200"
    aria-hidden="true"
  ></label>

  <!-- Side panel -->
  <aside
    class="md:hidden fixed top-0 right-0 z-50 h-dvh w-72 max-w-[85vw] bg-[#242526] border-l border-[#3e4042] shadow-2xl translate-x-full peer-checked:translate-x-0 transition-transform duration-200 ease-out flex flex-col"
  >
    <div class="flex items-center justify-between h-14 px-4 border-b border-[#3e4042] shrink-0">
      <span class="font-bold text-white">Menu</span>
      <label
        for="nav-drawer"
        role="button"
        tabindex="0"
        class="flex items-center justify-center w-10 h-10 -mr-2 rounded text-slate-300 hover:bg-[#1b1b1d] cursor-pointer transition-colors"
      >
        <span class="sr-only">Close menu</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </label>
    </div>

    <nav class="flex-1 overflow-y-auto p-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-3 py-3 rounded text-sm transition-colors ${
            isActive(item.href)
              ? 'text-[#25c2a0] font-semibold bg-[#1b1b1d]'
              : 'text-slate-300 hover:text-white hover:bg-[#1b1b1d]'
          }`}
        >
          {item.name}
        </a>
      ))}

      <a
        href="https://github.com/gufo-org/gufo"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-3 py-3 rounded text-sm text-slate-300 hover:text-white hover:bg-[#1b1b1d] transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        GitHub repository
      </a>
    </nav>

    <div class="p-4 border-t border-[#3e4042] text-[11px] text-slate-500 font-mono shrink-0">
      ROCm HIP · gfx1151
    </div>
  </aside>
</nav>

<style>
  /* Close the drawer when a link inside it is followed. */
  #nav-drawer:checked ~ aside a:active {
    opacity: 0.7;
  }
</style>

<script>
  // Progressive enhancement only: the drawer already opens and closes with CSS.
  const drawer = document.getElementById('nav-drawer') as HTMLInputElement | null;
  if (drawer) {
    // Close after navigating to an in-page anchor, where no page load happens.
    document.querySelectorAll('nav aside a[href*="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        drawer.checked = false;
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') drawer.checked = false;
    });
  }
</script>
