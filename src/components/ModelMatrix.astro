---
import { catalogue } from '../data/models';
---

<div class="overflow-x-auto border-t border-line">
  <table class="w-full text-left text-sm">
    <thead class="text-ink-3">
      <tr class="border-b border-line">
        <th class="py-3 pr-6 font-normal">Model</th>
        <th class="py-3 pr-6 font-normal">Task</th>
        <th class="py-3 pr-6 font-normal">Weights</th>
        <th class="py-3 pr-6 font-normal">Modes</th>
        <th class="py-3 font-normal">Retained measurement</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line text-ink-2">
      {catalogue.map((m) => (
        <tr class="align-top">
          <td class="py-4 pr-6 text-ink font-medium whitespace-nowrap">{m.name}</td>
          <td class="py-4 pr-6">{m.role}</td>
          <td class="py-4 pr-6 min-w-40">{m.weights}</td>
          <td class="py-4 pr-6 whitespace-nowrap">{m.modes}</td>
          <td class={`py-4 min-w-48 ${m.status === 'measured' ? 'text-ink' : 'text-ink-4'}`}>{m.headline}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="text-sm text-ink-3 mt-4 leading-relaxed max-w-3xl">
  Peak measured workloads. Text <code>pp</code> is autoregressive; <code>tg</code> uses the named speculative mode.
  Aggregated rates sum individual request decode rates across concurrent requests. Each model guide lists the required
  files and complete benchmark settings.
</p>
