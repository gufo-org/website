---
import { catalogue } from '../data/models';
---

<div class="overflow-x-auto border-t border-line">
  <table class="w-full text-left text-sm">
    <thead class="text-ink-3">
      <tr class="border-b border-line">
        <th class="py-3 pr-6 font-normal">Model</th>
        <th class="py-3 pr-6 font-normal">Task</th>
        <th class="py-3 font-normal">Best result</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line text-ink-2">
      {catalogue.map((m) => (
        <tr class="align-top">
          <td class="py-4 pr-6 text-ink font-medium whitespace-nowrap">{m.name}</td>
          <td class="py-4 pr-6">{m.role}</td>
          <td class={`py-4 min-w-48 ${m.status === 'measured' ? 'text-ink' : 'text-ink-4'}`}>{m.headline}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="text-sm text-ink-3 mt-4 leading-relaxed max-w-3xl">
  Best measured results. Prefill (<code>pp</code>) runs without speculation; decode (<code>tg</code>) uses the
  model's draft mode, and its peak comes from repetitive output. The 8-user number adds up each request's decode speed.
</p>
