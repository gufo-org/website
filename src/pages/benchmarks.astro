---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import { benchmarks } from '../data/benchmarks';
---

<Layout
  title="Benchmarks · Gufo"
  description="Measured prefill, decode, concurrency, loading and memory results for Gufo on AMD Strix Halo, compared with llama.cpp and antirez/ds4."
>
  <main id="main-content" class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs text-ink-3">
      <a href="/" class="hover:text-ink">Home</a>
      <span>/</span>
      <span class="text-ink">Benchmarks</span>
    </div>

    <!-- Header -->
    <div class="space-y-3">
      <h1 class="text-4xl sm:text-5xl text-ink">
        Benchmarks
      </h1>
    </div>

    <!-- Horizontal model bar -->
    <div class="sticky top-16 z-40 py-2 bg-ivory/95 backdrop-blur border-b border-line">
      <div class="flex gap-2 overflow-x-auto pb-1" id="model-bar" role="tablist" aria-label="Model">
        {benchmarks.map((m, idx) => (
          <button
            type="button"
            role="tab"
            id={`model-tab-${m.id}`}
            data-model={m.id}
            aria-controls={`model-panel-${m.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            tabindex={idx === 0 ? 0 : -1}
            class="shrink-0 px-3.5 py-2 rounded-full text-xs border border-line text-ink-2 hover:border-line-strong aria-selected:bg-ink aria-selected:text-ivory aria-selected:border-ink transition-colors"
          >
            <span class="font-semibold">{m.short}</span>
            <span class="ml-2 text-[11px] opacity-60">{m.reference ? `vs ${m.reference.split(' ')[0]}` : 'no reference'}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Model panels -->
    {benchmarks.map((m, idx) => (
      <div
        id={`model-panel-${m.id}`}
        role="tabpanel"
        aria-labelledby={`model-tab-${m.id}`}
        hidden={idx !== 0}
        class="model-panel scroll-mt-32 space-y-6">
        <!-- Model header -->
        <div class="pt-4 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-line pb-3">
            <div>
              <h2 class="text-3xl text-ink">{m.name}</h2>
            </div>
            <div class="text-xs text-ink-2 bg-ivory px-2.5 py-1.5 rounded border border-line">
              {m.reference ? (
                <span>Reference: <span class="font-semibold text-ink">{m.reference}</span></span>
              ) : (
                <span class="text-ink-3">No reference engine comparison retained</span>
              )}
            </div>
          </div>
          <p class="text-[15px] text-ink-2 leading-relaxed">{m.summary}</p>
          <p class="text-[11px] text-ink-3 font-mono">{m.measured}</p>
        </div>

        <!-- Benchmark sidebar + centre panel -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
          <aside class="lg:col-span-1 min-w-0 space-y-2 lg:sticky lg:top-36">
            <div class="text-xs text-ink-4 px-2 py-1 border-b border-line">
              Benchmark
            </div>
            <div class="flex lg:block gap-2 overflow-x-auto lg:overflow-visible">
              {m.views.map((v, vIdx) => (
                <button
                  type="button"
                  data-view={v.id}
                  aria-pressed={vIdx === 0 ? 'true' : 'false'}
                  class="view-btn shrink-0 lg:w-full text-left p-2.5 rounded text-xs text-ink-3 hover:text-ink hover:bg-paper aria-pressed:bg-paper aria-pressed:text-ink aria-pressed:font-semibold transition-colors lg:mb-1.5"
                >
                  <div class="font-semibold whitespace-nowrap">{v.label}</div>
                  <div class="text-[11px] text-ink-4 mt-0.5 whitespace-nowrap">{v.kicker}</div>
                </button>
              ))}
            </div>

            <div class="hidden lg:block pt-2 border-t border-line text-[11px] text-ink-4 font-mono px-1 leading-relaxed">
              {m.docPath}
            </div>
          </aside>

          <div class="lg:col-span-3 min-w-0 space-y-6">
            {m.views.map((v, vIdx) => (
              <div data-view={v.id} hidden={vIdx !== 0} class="view-panel space-y-6">
                {v.charts.map((c) => (
                  <div class="min-w-0 pt-5 border-t border-line space-y-3">
                    <h3 class="text-sm font-semibold text-ink">{c.title}</h3>
                    <Chart chart={c} />
                  </div>
                ))}

                <div class="border-t border-line">
                  <div class="py-4 space-y-1">
                    <h3 class="text-sm font-semibold text-ink">{v.table.title}</h3>
                    {v.table.note && <p class="text-[11px] text-ink-3 leading-relaxed">{v.table.note}</p>}
                  </div>
                  <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono">
                      <thead class="text-ink-3 text-xs border-y border-line">
                        <tr>
                          {v.table.columns.map((col, i) => (
                            <th class={`px-4 py-3 whitespace-nowrap ${i === 0 ? 'font-sans' : ''} ${col.startsWith('Gufo') ? 'text-ink font-semibold' : ''}`}>
                              {col}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-line text-ink-2">
                        {v.table.rows.map((row) => (
                          <tr class="hover:bg-paper-2 transition-colors">
                            {row.map((cell, i) => (
                              <td
                                class={`px-4 py-3 whitespace-nowrap ${
                                  i === 0
                                    ? 'font-semibold text-ink'
                                    : cell === 'TODO' || cell === 'N/A'
                                      ? 'text-ink-4'
                                      : v.table.columns[i]?.startsWith('Gufo')
                                        ? 'text-ink font-semibold'
                                        : 'text-ink-2'
                                }`}
                              >
                                {cell}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            ))}

            <!-- Notes -->
            <div class="rounded-r-md border-l-2 border-[#6a9bcc] bg-paper px-5 py-4">
              <p class="mb-2 text-[13px] font-semibold text-ink">Notes</p>
              <ul class="space-y-1.5 text-xs text-ink-2">
                {m.notes.map((note) => (
                  <li class="flex items-start gap-2">
                    <span class="text-ink font-semibold">·</span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    ))}
  </main>
</Layout>

<script>
  const tabs = [...document.querySelectorAll<HTMLElement>('#model-bar [role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.model-panel')];
  const fromHash = () => decodeURIComponent(location.hash.slice(1));

  function selectModel(id: string) {
    if (!tabs.some((tab) => tab.dataset.model === id)) return false;
    for (const tab of tabs) {
      const on = tab.dataset.model === id;
      tab.ariaSelected = String(on);
      tab.tabIndex = on ? 0 : -1;
    }
    for (const panel of panels) panel.hidden = panel.id !== `model-panel-${id}`;
    // Keep the selection linkable, e.g. /benchmarks#deepseek-v4-flash.
    if (fromHash() !== id) history.replaceState(null, '', `#${id}`);
    return true;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const tab = target.closest<HTMLElement>('#model-bar [role="tab"]');
    if (tab) return void selectModel(tab.dataset.model!);

    const button = target.closest<HTMLElement>('.view-btn');
    const panel = button?.closest('.model-panel');
    if (!button || !panel) return;
    for (const other of panel.querySelectorAll('.view-btn')) other.ariaPressed = String(other === button);
    for (const view of panel.querySelectorAll<HTMLElement>('.view-panel')) view.hidden = view.dataset.view !== button.dataset.view;
  });

  // Arrow keys move between model tabs, as in the ARIA tabs pattern.
  document.getElementById('model-bar')!.addEventListener('keydown', (event) => {
    const current = tabs.indexOf(document.activeElement as HTMLElement);
    const next = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 }[event.key];
    if (current === -1 || next === undefined) return;
    event.preventDefault();
    const tab = tabs[(next + tabs.length) % tabs.length];
    tab.focus();
    selectModel(tab.dataset.model!);
  });

  // Links such as /benchmarks#deepseek-v4-flash open that model. No element carries
  // the model id, so the browser doesn't scroll; bring the panel into view ourselves.
  window.addEventListener('hashchange', () => {
    if (selectModel(fromHash())) document.getElementById(`model-panel-${fromHash()}`)!.scrollIntoView();
  });
  selectModel(fromHash());
</script>
