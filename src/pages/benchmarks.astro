---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { benchmarks } from '../data/benchmarks';

const chartPayload = benchmarks.map((m) => ({
  id: m.id,
  views: m.views.map((v) => ({ id: v.id, charts: v.charts })),
}));
---

<Layout title="Benchmarks — gufo">
  <Navbar currentPath="/benchmarks" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-white">Home</a>
      <span>/</span>
      <span class="text-slate-200">Benchmarks</span>
      <span>/</span>
      <span class="text-[#25c2a0] font-semibold">Retained measurements</span>
    </div>

    <!-- Header -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Benchmarks on AMD Strix Halo
      </h1>
      <p class="text-sm text-slate-300 max-w-4xl leading-relaxed">
        Every figure below is transcribed from <code class="text-[#25c2a0]">docs/models/&lt;model&gt;/BENCHMARKS.md</code> in
        the Gufo repository. Measurements come from <code class="text-[#25c2a0]">nix build</code> binaries on one
        <code class="text-[#25c2a0] font-mono">gfx1151</code> machine with 128 GB of unified memory. Pending cells stay
        <b class="text-white">TODO</b> and comparisons a reference engine cannot run stay <b class="text-white">N/A</b>,
        rather than being estimated.
      </p>
      <details class="text-xs text-slate-400 bg-[#242526] border border-[#3e4042] rounded-lg">
        <summary class="cursor-pointer px-4 py-2.5 text-slate-300 font-semibold select-none">
          How these numbers are measured
        </summary>
        <div class="px-4 pb-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 leading-relaxed">
          <div>
            <div class="text-slate-400 font-mono mb-1">Reading the columns</div>
            <code class="text-slate-300">pp</code> is prompt processing, <code class="text-slate-300">tg</code> is token
            generation, and depth is the cached prefix in tokens. Text results are HTTP, greedy, thinking off.
          </div>
          <div>
            <div class="text-slate-400 font-mono mb-1">Concurrency</div>
            Rows sum individual request decode rates and exclude prefill and scheduling, so they are not whole-request
            throughput.
          </div>
          <div>
            <div class="text-slate-400 font-mono mb-1">Comparable runs</div>
            Same source revision, model artifact, quantization, prompt and generation lengths, depth, concurrency, GPU
            route, driver and ROCm version, warmup policy.
          </div>
          <div>
            <div class="text-slate-400 font-mono mb-1">Reference engines</div>
            Separate Nix packages, excluded from Gufo and the normal dev shell:
            <code class="text-[#25c2a0]">.#llama-cpp-reference</code>,
            <code class="text-[#25c2a0]">.#llama-cpp-mtp-reference</code>,
            <code class="text-[#25c2a0]">.#ds4-reference</code>. Headline numbers come from unprofiled runs.
          </div>
        </div>
      </details>
    </div>

    <!-- Horizontal model bar -->
    <div class="sticky top-14 z-40 py-2 bg-[#080c14]/95 backdrop-blur border-b border-[#3e4042]">
      <div class="flex gap-2 overflow-x-auto pb-1" id="model-bar" role="tablist">
        {benchmarks.map((m, idx) => (
          <button
            type="button"
            role="tab"
            data-model-id={m.id}
            aria-selected={idx === 0 ? 'true' : 'false'}
            class={`model-tab shrink-0 px-3 py-2 rounded text-xs border transition-colors ${
              idx === 0
                ? 'bg-[#242526] text-white border-[#25c2a0] font-semibold'
                : 'bg-[#1b1b1d] text-slate-400 border-[#3e4042] hover:text-slate-200 hover:border-slate-500'
            }`}
          >
            <span class="font-bold">{m.short}</span>
            <span class="ml-2 text-[11px] text-slate-500">{m.reference ? `vs ${m.reference.split(' ')[0]}` : 'no reference'}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Model panels -->
    {benchmarks.map((m, idx) => (
      <div id={`model-panel-${m.id}`} class={`model-panel space-y-6 ${idx === 0 ? 'block' : 'hidden'}`}>
        <!-- Model header -->
        <div class="p-5 rounded-lg bg-[#242526] border border-[#3e4042] space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-[#3e4042] pb-3">
            <div>
              <h2 class="text-2xl font-bold text-white tracking-tight">{m.name}</h2>
              <p class="text-xs text-slate-400 mt-1">
                <span class="text-slate-300 font-semibold">{m.type}</span> ·
                <span class="text-[#25c2a0]"> {m.format}</span> ·
                <code class="text-slate-400"> {m.sourceDir}</code>
              </p>
            </div>
            <div class="text-xs text-slate-300 bg-[#1b1b1d] px-2.5 py-1.5 rounded border border-[#3e4042]">
              {m.reference ? (
                <span>Reference: <span class="font-bold text-white">{m.reference}</span></span>
              ) : (
                <span class="text-slate-400">No reference engine comparison retained</span>
              )}
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{m.summary}</p>
          <p class="text-[11px] text-slate-400 font-mono">{m.measured}</p>
        </div>

        <!-- Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {m.highlights.map((h) => (
            <div class="p-3.5 rounded-lg bg-[#242526] border border-[#3e4042] space-y-1">
              <div class="text-[11px] text-slate-400 uppercase tracking-wide">{h.label}</div>
              <div class="text-lg font-bold text-[#25c2a0] font-mono">{h.value}</div>
              <div class="text-[11px] text-slate-400 leading-relaxed">{h.note}</div>
            </div>
          ))}
        </div>

        <!-- Benchmark sidebar + centre panel -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
          <aside class="lg:col-span-1 min-w-0 border border-[#3e4042] rounded-lg bg-[#242526] p-3 space-y-2 lg:sticky lg:top-32">
            <div class="text-xs font-bold text-slate-300 uppercase tracking-wider px-2 py-1 border-b border-[#3e4042]">
              Benchmark
            </div>
            <div class="flex lg:block gap-2 overflow-x-auto lg:overflow-visible view-list" data-model-id={m.id}>
              {m.views.map((v, vIdx) => (
                <button
                  type="button"
                  data-view-id={v.id}
                  class={`view-btn shrink-0 lg:w-full text-left p-2.5 rounded text-xs transition-colors border lg:mb-1.5 ${
                    vIdx === 0
                      ? 'bg-[#1b1b1d] text-white border-[#25c2a0] font-semibold'
                      : 'bg-[#242526] text-slate-400 border-transparent hover:text-slate-200 hover:bg-[#2c2d30]'
                  }`}
                >
                  <div class="font-bold whitespace-nowrap">{v.label}</div>
                  <div class="text-[11px] text-slate-500 mt-0.5 whitespace-nowrap">{v.kicker}</div>
                </button>
              ))}
            </div>

            <div class="hidden lg:block pt-2 border-t border-[#3e4042] text-[11px] text-slate-500 font-mono px-1 leading-relaxed">
              {m.docPath}
            </div>
          </aside>

          <main class="lg:col-span-3 min-w-0 space-y-6">
            {m.views.map((v, vIdx) => (
              <div
                id={`view-${m.id}-${v.id}`}
                data-model-id={m.id}
                class={`view-panel space-y-6 ${vIdx === 0 ? 'block' : 'hidden'}`}
              >
                {v.charts.map((c) => (
                  <div class="min-w-0 p-4 sm:p-5 rounded-lg bg-[#242526] border border-[#3e4042] space-y-3 overflow-hidden">
                    <h3 class="text-sm font-bold text-white">{c.title}</h3>
                    <div class="relative w-full min-w-0 h-72 sm:h-80">
                      <canvas id={`chart-${c.id}`} class="max-w-full"></canvas>
                    </div>
                  </div>
                ))}

                <div class="border border-[#3e4042] rounded-lg bg-[#242526] overflow-hidden">
                  <div class="px-4 py-3 bg-[#1b1b1d] border-b border-[#3e4042] space-y-1">
                    <h3 class="text-xs font-bold text-white uppercase tracking-wider">{v.table.title}</h3>
                    {v.table.note && <p class="text-[11px] text-slate-400 leading-relaxed">{v.table.note}</p>}
                  </div>
                  <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono">
                      <thead class="bg-[#242526] text-slate-400 uppercase text-[11px] border-b border-[#3e4042]">
                        <tr>
                          {v.table.columns.map((col, i) => (
                            <th class={`px-4 py-3 whitespace-nowrap ${i === 0 ? 'font-sans' : ''} ${col.startsWith('Gufo') ? 'text-[#25c2a0]' : ''}`}>
                              {col}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-[#3e4042] text-slate-300">
                        {v.table.rows.map((row) => (
                          <tr class="hover:bg-[#2c2d30] transition-colors">
                            {row.map((cell, i) => (
                              <td
                                class={`px-4 py-3 whitespace-nowrap ${
                                  i === 0
                                    ? 'font-bold text-white'
                                    : cell === 'TODO' || cell === 'N/A'
                                      ? 'text-slate-500'
                                      : v.table.columns[i]?.startsWith('Gufo')
                                        ? 'text-[#25c2a0] font-semibold'
                                        : 'text-slate-300'
                                }`}
                              >
                                {cell}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            ))}

            <!-- Notes -->
            <div class="admonition admonition-info">
              <div class="admonition-title">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Reading these numbers</span>
              </div>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {m.notes.map((note) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#25c2a0] font-bold">·</span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Reproduce -->
            <div class="docusaurus-code">
              <div class="docusaurus-code-header">
                <span>Reproduce</span>
                <span>sh</span>
              </div>
              <div class="p-3 text-xs font-mono text-[#25c2a0] space-y-1 break-all">
                {m.reproduce.map((line) => <div>{line}</div>)}
              </div>
            </div>
          </main>
        </div>
      </div>
    ))}
  </div>

  <Footer />

  <script is:inline type="application/json" id="bench-charts" set:html={JSON.stringify(chartPayload)}></script>
</Layout>

<script>
  import Chart from 'chart.js/auto';

  interface Series {
    label: string;
    data: (number | null)[];
    color: string;
    dashed?: boolean;
  }

  interface ChartSpec {
    id: string;
    title: string;
    type: 'line' | 'bar';
    labels: string[];
    series: Series[];
    xTitle?: string;
    yTitle: string;
  }

  interface ViewSpec {
    id: string;
    charts: ChartSpec[];
  }

  const payloadEl = document.getElementById('bench-charts');
  const payload: { id: string; views: ViewSpec[] }[] = payloadEl ? JSON.parse(payloadEl.textContent || '[]') : [];
  const viewsByModel = new Map(payload.map((entry) => [entry.id, entry.views]));
  const instances: Record<string, any> = {};

  const axis = {
    grid: { color: 'rgba(255, 255, 255, 0.05)' },
    ticks: { color: '#a3a3a3', font: { family: 'ui-monospace, monospace', size: 11 } },
  };

  function renderChart(spec: ChartSpec) {
    const el = document.getElementById(`chart-${spec.id}`) as HTMLCanvasElement | null;
    if (!el) return;
    instances[spec.id]?.destroy();

    instances[spec.id] = new Chart(el, {
      type: spec.type,
      data: {
        labels: spec.labels,
        datasets: spec.series.map((s) => ({
          label: s.label,
          data: s.data,
          borderColor: s.color,
          backgroundColor: spec.type === 'bar' ? s.color : 'transparent',
          borderDash: s.dashed ? [5, 5] : undefined,
          borderRadius: spec.type === 'bar' ? 4 : undefined,
          tension: 0.25,
          pointRadius: spec.type === 'line' ? 3 : undefined,
        })),
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: spec.series.length > 1,
            labels: { color: '#e3e3e3', font: { family: 'ui-monospace, monospace', size: 11 } },
          },
          tooltip: {
            backgroundColor: '#1b1b1d',
            borderColor: '#3e4042',
            borderWidth: 1,
            titleColor: '#25c2a0',
            bodyColor: '#e3e3e3',
            padding: 10,
          },
        },
        scales: {
          x: {
            ...axis,
            title: spec.xTitle ? { display: true, text: spec.xTitle, color: '#888', font: { size: 11 } } : undefined,
          },
          y: {
            ...axis,
            title: { display: true, text: spec.yTitle, color: '#888', font: { size: 11 } },
          },
        },
      },
    });
  }

  function renderView(modelId: string, viewId: string) {
    const view = (viewsByModel.get(modelId) || []).find((v) => v.id === viewId);
    view?.charts.forEach(renderChart);
  }

  const ACTIVE_MODEL = ['bg-[#242526]', 'text-white', 'border-[#25c2a0]', 'font-semibold'];
  const IDLE_MODEL = ['bg-[#1b1b1d]', 'text-slate-400', 'border-[#3e4042]', 'hover:text-slate-200', 'hover:border-slate-500'];
  const ACTIVE_VIEW = ['bg-[#1b1b1d]', 'text-white', 'border-[#25c2a0]', 'font-semibold'];
  const IDLE_VIEW = ['bg-[#242526]', 'text-slate-400', 'border-transparent', 'hover:text-slate-200', 'hover:bg-[#2c2d30]'];

  function activeViewOf(modelId: string): string | null {
    const btn = document.querySelector(`.view-list[data-model-id="${modelId}"] .view-btn.is-active`) as HTMLElement | null;
    if (btn) return btn.getAttribute('data-view-id');
    const first = (viewsByModel.get(modelId) || [])[0];
    return first ? first.id : null;
  }

  function selectView(modelId: string, viewId: string) {
    document
      .querySelectorAll(`.view-list[data-model-id="${modelId}"] .view-btn`)
      .forEach((btn) => {
        const isTarget = btn.getAttribute('data-view-id') === viewId;
        btn.classList.toggle('is-active', isTarget);
        btn.classList.remove(...(isTarget ? IDLE_VIEW : ACTIVE_VIEW));
        btn.classList.add(...(isTarget ? ACTIVE_VIEW : IDLE_VIEW));
      });

    document.querySelectorAll(`.view-panel[data-model-id="${modelId}"]`).forEach((panel) => {
      const isTarget = panel.id === `view-${modelId}-${viewId}`;
      panel.classList.toggle('hidden', !isTarget);
      panel.classList.toggle('block', isTarget);
    });

    requestAnimationFrame(() => renderView(modelId, viewId));
  }

  function selectModel(modelId: string) {
    document.querySelectorAll('#model-bar .model-tab').forEach((tab) => {
      const isTarget = tab.getAttribute('data-model-id') === modelId;
      tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      tab.classList.remove(...(isTarget ? IDLE_MODEL : ACTIVE_MODEL));
      tab.classList.add(...(isTarget ? ACTIVE_MODEL : IDLE_MODEL));
    });

    document.querySelectorAll('.model-panel').forEach((panel) => {
      const isTarget = panel.id === `model-panel-${modelId}`;
      panel.classList.toggle('hidden', !isTarget);
      panel.classList.toggle('block', isTarget);
    });

    const viewId = activeViewOf(modelId);
    if (viewId) requestAnimationFrame(() => renderView(modelId, viewId));
  }

  function init() {
    // Mark the initially visible view of each model as active.
    payload.forEach((model) => {
      const first = model.views[0];
      if (!first) return;
      document
        .querySelector(`.view-list[data-model-id="${model.id}"] .view-btn[data-view-id="${first.id}"]`)
        ?.classList.add('is-active');
    });

    // Delegated: survives re-renders and never depends on load ordering.
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const tab = target.closest('#model-bar .model-tab') as HTMLElement | null;
      if (tab) {
        const modelId = tab.getAttribute('data-model-id');
        if (modelId) selectModel(modelId);
        return;
      }

      const viewBtn = target.closest('.view-list .view-btn') as HTMLElement | null;
      if (viewBtn) {
        const modelId = viewBtn.closest('.view-list')?.getAttribute('data-model-id');
        const viewId = viewBtn.getAttribute('data-view-id');
        if (modelId && viewId) selectView(modelId, viewId);
      }
    });

    const first = payload[0];
    const firstView = first?.views[0];
    if (first && firstView) renderView(first.id, firstView.id);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
