---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// The catalogue describes the suite rather than any run: what each task is and
// what passing it demonstrates. Joined to results by task name, so results stay
// lean and capabilities are not duplicated once per run.
import catalogueRaw from '../data/agent-eval/catalogue.json';

// Every file here is a `gufo-agent-eval` result document, exactly as written by
// `eval-agent run --output`. The page renders the schema and nothing else, so a
// field missing here is a field the format needs to grow.
const modules = import.meta.glob<Record<string, any>>('../data/agent-eval/runs/*.json', { eager: true });

type TaskResult = {
  task: string;
  completed: boolean;
  passed: boolean;
  reward: number;
  duration_ms: number;
  first_response_ms: number | null;
  requests: number;
  tokens: { input: number; output: number; cache_read: number; cache_write: number; total: number };
  context_failures: number;
  agent_steps: number;
  tool_calls: number;
  tool_failures: number;
  tool_names: Record<string, number>;
  agent_timed_out: boolean;
  agent_exit_code: number;
  endpoint_errors: number;
  verifier_crashed: boolean;
  verifier_timed_out: boolean;
  workspace_hash: string | null;
  verifier_output: string;
};

type CatalogueTask = {
  task: string;
  summary: string;
  description: string;
  difficulty: string;
  category: string;
  requires: { label: string; items: string[] }[];
};

type ServerIdentity = {
  platform: string;
  platform_name: string | null;
  engine: string;
  engine_version: string | null;
  backend: string;
  backend_version: string | null;
  quant: string | null;
  inference_profile: string | null;
  context_length: number | null;
};

type RunResult = {
  schema_version: string;
  generated_at: string;
  suite: string;
  tier: string;
  server: ServerIdentity;
  identity: Record<string, any>;
  machine: Record<string, any>;
  tasks: TaskResult[];
  aggregate: Record<string, any>;
};

const catalogue = (catalogueRaw as any);
const byTask = new Map<string, CatalogueTask>(
  (catalogue.tasks as CatalogueTask[]).map((t) => [t.task, t])
);

const runs: RunResult[] = Object.values(modules)
  .map((m) => (m.default ?? m) as RunResult)
  .filter((r) => r.schema_version?.startsWith('gufo-agent-eval/'));
runs.sort((a, b) => b.generated_at.localeCompare(a.generated_at));

/** How a run is labelled when comparing across engines and backends. */
function serverLabel(s: ServerIdentity): string {
  return [s.engine, s.backend, s.quant].filter(Boolean).join(' · ');
}

/**
 * Runs are comparable only when they measured the same thing.
 *
 * A different tier, a different set of task derivations, or a different agent
 * revision all mean the numbers are not answering the same question, so they
 * are grouped apart rather than tabulated side by side as if they were.
 */
function comparisonKey(r: RunResult): string {
  return `${r.identity.benchmark_hash}|${r.identity.agent_version}|${r.identity.attempts_per_task}`;
}

const groups = [...new Map(
  runs.map((r) => [comparisonKey(r), runs.filter((o) => comparisonKey(o) === comparisonKey(r))])
).values()].filter((g) => g.length > 1);

/** Every task appearing in any run of a group, ordered by name. */
function groupTasks(group: RunResult[]): string[] {
  return [...new Set(group.flatMap((r) => r.tasks.map((t) => t.task)))].sort();
}

const fmtMin = (ms: number) => (ms / 60000).toFixed(1);
const fmtHours = (ms: number) => (ms / 3600000).toFixed(2);
const fmtNum = (n: number) => n.toLocaleString('en-US');

/**
 * Why a task did not pass, as far as the result can tell.
 *
 * These are kept apart deliberately: a run cut off by its timeout, a verifier
 * that produced no verdict, and a model that answered wrongly are three
 * different things, and averaging them into one "fail" hides the difference.
 */
function failureMode(t: TaskResult): { label: string; tone: string; hint: string } | null {
  if (t.passed) return null;
  if (t.verifier_crashed)
    return { label: 'verifier crashed', tone: 'purple', hint: 'No verdict produced. A harness fault, not a task failure.' };
  if (t.agent_timed_out && t.agent_steps === 0)
    return { label: 'no activity recorded', tone: 'purple', hint: 'Timed out having recorded no turns. Known measurement bug.' };
  if (t.agent_timed_out)
    return { label: 'timeout', tone: 'amber', hint: 'Cut off by the attempt timeout before finishing.' };
  if (t.context_failures > 0)
    return { label: 'output budget', tone: 'amber', hint: 'Stopped on length: the model exhausted its output budget mid-answer.' };
  return { label: 'wrong answer', tone: 'red', hint: 'Ran to completion; the verifier rejected the result.' };
}

const toneClass: Record<string, string> = {
  purple: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
  amber: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  red: 'bg-red-500/15 text-red-300 border-red-500/30',
};
---

<Layout title="Agent Eval — gufo">
  <Navbar currentPath="/agent-eval" />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-white tracking-tight">Agent Evaluation</h1>
      <p class="mt-3 text-[#b0b3b8] max-w-3xl leading-relaxed">
        Whether a served model, driven by a fixed coding agent through a terminal,
        can finish multi-step work. The agent runs in a bubblewrap sandbox and a
        deterministic verifier scores the workspace it leaves behind — a task
        passes only when its reward is exactly&nbsp;1.
      </p>
      <p class="mt-3 text-sm text-[#8a8d91] max-w-3xl leading-relaxed">
        This measures task completion, not speed. Raw throughput lives on the
        <a href="/benchmarks" class="text-[#25c2a0] hover:underline">benchmarks</a> page.
        The suite is derived from Terminal-Bench 2.1 but runs a different agent in a
        different sandbox, so these numbers are <strong class="text-[#b0b3b8]">not</strong> an
        official Terminal-Bench score.
      </p>
    </header>

    {runs.length === 0 && (
      <div class="rounded-lg border border-[#3e4042] bg-[#242526] p-8 text-center text-[#8a8d91]">
        No result documents yet. Drop the JSON from
        <code class="mx-1 text-[#25c2a0]">eval-agent run --output</code>
        into <code class="text-[#25c2a0]">src/data/agent-eval/</code>.
      </div>
    )}

    {groups.map((group) => {
      const tasks = groupTasks(group);
      return (
        <section class="mb-14">
          <h2 class="text-xl font-bold text-white mb-1">Comparison</h2>
          <p class="text-sm text-[#8a8d91] mb-4 max-w-3xl">
            {group.length} runs of the same tasks, agent and attempt budget, differing
            only in what served the model. Grouped by benchmark identity, so runs that
            measured different things are never tabulated together.
          </p>

          <div class="border border-[#3e4042] rounded-lg overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-[#242526] text-[#8a8d91] text-xs uppercase tracking-wide">
                <tr>
                  <th class="text-left font-medium px-4 py-3">Task</th>
                  {group.map((r) => (
                    <th class="text-left font-medium px-4 py-3">
                      <div class="text-[#e4e6eb] normal-case text-[13px]">{r.server.engine}</div>
                      <div class="font-normal normal-case text-[11px] text-[#8a8d91]">
                        {[r.server.backend, r.server.quant].filter(Boolean).join(' · ')}
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3e4042]">
                {tasks.map((name) => {
                  const cells = group.map((r) => r.tasks.find((t) => t.task === name));
                  const outcomes = new Set(cells.map((c) => (c ? c.passed : null)));
                  const differs = outcomes.size > 1;
                  return (
                    <tr class={differs ? 'bg-amber-500/[0.04]' : ''}>
                      <td class="px-4 py-2.5 font-mono text-[13px] text-[#e4e6eb]">
                        {name}
                        {differs && <span class="ml-2 text-[11px] text-amber-400">differs</span>}
                      </td>
                      {cells.map((c) => (
                        <td class="px-4 py-2.5">
                          {c === undefined ? (
                            <span class="text-[#5a5d61] text-xs">not run</span>
                          ) : (
                            <span class="flex items-baseline gap-2">
                              <span class={c.passed ? 'text-[#25c2a0]' : 'text-red-400'}>
                                {c.passed ? 'pass' : failureMode(c)!.label}
                              </span>
                              <span class="text-[11px] text-[#8a8d91] tabular-nums">
                                {fmtMin(c.duration_ms)}m
                              </span>
                            </span>
                          )}
                        </td>
                      ))}
                    </tr>
                  );
                })}
              </tbody>
              <tfoot class="bg-[#242526] border-t-2 border-[#3e4042]">
                <tr>
                  <td class="px-4 py-3 text-xs uppercase tracking-wide text-[#8a8d91]">Passed</td>
                  {group.map((r) => (
                    <td class="px-4 py-3">
                      <span class="text-[#25c2a0] font-bold">
                        {r.aggregate.passed_tasks}/{r.aggregate.total_tasks}
                      </span>
                      <span class="ml-2 text-[11px] text-[#8a8d91]">
                        {fmtHours(r.aggregate.total_duration_ms)}h
                      </span>
                    </td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>
        </section>
      );
    })}

    {runs.length === 1 && (
      <div class="mb-14 rounded-lg border border-[#3e4042] bg-[#242526] px-5 py-4 text-sm text-[#8a8d91]">
        Only one run is loaded, so there is nothing to compare against yet. Add another
        result document under <code class="text-[#25c2a0]">src/data/agent-eval/runs/</code>
        — a run of the same tier with a different
        <code class="mx-1 text-[#25c2a0]">--engine</code> or
        <code class="mr-1 text-[#25c2a0]">--backend</code>
        — and a comparison table appears here automatically.
      </div>
    )}

    {runs.map((run) => {
      const agg = run.aggregate;
      const passRate = (agg.pass_at_1 * 100).toFixed(0);
      const byDuration = [...run.tasks].sort((a, b) => b.duration_ms - a.duration_ms);
      const attempts = run.identity.attempts_per_task;

      return (
        <section class="mb-14">
          {/* Run identity */}
          <div class="rounded-t-lg border border-[#3e4042] bg-[#242526] px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2">
            <div>
              <div class="text-lg font-bold text-white">{run.identity.model}</div>
              <div class="text-xs text-[#8a8d91] mt-0.5">
                {run.identity.model_name ?? run.identity.model} on
                {' '}<span class="text-[#25c2a0]">{serverLabel(run.server)}</span>
                {' '}· {run.server.platform_name ?? run.server.platform}
              </div>
              <div class="text-xs text-[#8a8d91] mt-0.5">
                agent {run.identity.agent} {run.identity.agent_version} · tier {run.tier} ·
                {' '}{new Date(run.generated_at).toISOString().slice(0, 10)}
              </div>
            </div>
            <div class="ml-auto flex flex-wrap gap-2 text-[11px]">
              <span class="px-2 py-1 rounded border border-[#3e4042] text-[#8a8d91] font-mono">
                {run.identity.endpoint_label}
              </span>
              <span class="px-2 py-1 rounded border border-[#3e4042] text-[#8a8d91] font-mono">
                benchmark {run.identity.benchmark_hash}
              </span>
              {!run.identity.limits_enforced && (
                <span class="px-2 py-1 rounded border border-amber-500/30 bg-amber-500/10 text-amber-300">
                  resource limits not enforced
                </span>
              )}
            </div>
          </div>

          {/* Headline numbers */}
          <div class="border-x border-[#3e4042] bg-[#1c1e21] grid grid-cols-2 md:grid-cols-5 divide-x divide-[#3e4042]">
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-[#25c2a0]">{agg.passed_tasks}/{agg.total_tasks}</div>
              <div class="text-xs text-[#8a8d91] mt-1">passed — pass@{attempts} {passRate}%</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtHours(agg.total_duration_ms)}h</div>
              <div class="text-xs text-[#8a8d91] mt-1">wall time</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtNum(agg.tokens.input)}</div>
              <div class="text-xs text-[#8a8d91] mt-1">input tokens</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtNum(agg.tokens.cache_read)}</div>
              <div class="text-xs text-[#8a8d91] mt-1">
                cached {agg.tokens.cache_read === 0 && <span class="text-amber-400">· none reused</span>}
              </div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{agg.timed_out_tasks}</div>
              <div class="text-xs text-[#8a8d91] mt-1">timed out</div>
            </div>
          </div>

          {/* Per task */}
          <div class="border border-[#3e4042] rounded-b-lg overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-[#242526] text-[#8a8d91] text-xs uppercase tracking-wide">
                <tr>
                  <th class="text-left font-medium px-4 py-3">Task</th>
                  <th class="text-left font-medium px-4 py-3">Result</th>
                  <th class="text-right font-medium px-4 py-3">Time</th>
                  <th class="text-right font-medium px-4 py-3">Turns</th>
                  <th class="text-right font-medium px-4 py-3">Tools</th>
                  <th class="text-right font-medium px-4 py-3">In</th>
                  <th class="text-right font-medium px-4 py-3">Out</th>
                  <th class="text-right font-medium px-4 py-3">TTFR</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3e4042]">
                {byDuration.map((t) => {
                  const mode = failureMode(t);
                  const meta = byTask.get(t.task);
                  return (
                    <>
                    <tr
                      class="hover:bg-[#242526]/60 transition-colors cursor-pointer"
                      data-task-row={t.task}
                    >
                      <td class="px-4 py-3 font-mono text-[13px] text-[#e4e6eb]">
                        <span class="inline-block w-3 text-[#8a8d91] select-none" data-caret>▸</span>
                        {t.task}
                      </td>
                      <td class="px-4 py-3">
                        {t.passed ? (
                          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-[#25c2a0]/30 bg-[#25c2a0]/10 text-[#25c2a0] text-xs font-medium">
                            pass
                          </span>
                        ) : (
                          <span
                            class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-xs font-medium ${toneClass[mode!.tone]}`}
                            title={mode!.hint}
                          >
                            {mode!.label}
                          </span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">{fmtMin(t.duration_ms)}m</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">{t.agent_steps}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">
                        {t.tool_calls}
                        {t.tool_failures > 0 && (
                          <span class="text-red-400 ml-1">({t.tool_failures}✗)</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">{fmtNum(t.tokens.input)}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">
                        {fmtNum(t.tokens.output)}
                        {t.context_failures > 0 && (
                          <span class="text-amber-400 ml-1" title="hit the output cap">⚠</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#8a8d91]">
                        {t.first_response_ms === null ? '—' : `${t.first_response_ms}ms`}
                      </td>
                    </tr>

                    <tr class="hidden" data-task-detail={t.task}>
                      <td colspan="8" class="px-4 pb-5 pt-1 bg-[#1c1e21]">
                        {meta ? (
                          <div class="max-w-4xl">
                            <div class="flex flex-wrap items-center gap-2 mb-3">
                              <span class="text-[11px] px-2 py-0.5 rounded border border-[#3e4042] text-[#8a8d91]">
                                {meta.category}
                              </span>
                              <span class="text-[11px] px-2 py-0.5 rounded border border-[#3e4042] text-[#8a8d91]">
                                {meta.difficulty}
                              </span>
                            </div>

                            <p class="text-sm text-[#b0b3b8] leading-relaxed mb-4">{meta.summary}</p>

                            <div class="text-xs uppercase tracking-wide text-[#8a8d91] mb-2">
                              Passing this demonstrates
                            </div>
                            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                              {meta.requires.map((group) => (
                                <div class="rounded border border-[#3e4042] bg-[#242526] p-3">
                                  <div class="text-[13px] font-medium text-[#e4e6eb] mb-1.5">
                                    {group.label}
                                  </div>
                                  <ul class="space-y-1">
                                    {group.items.map((item) => (
                                      <li class="text-xs text-[#b0b3b8] leading-snug flex gap-1.5">
                                        <span class={t.passed ? 'text-[#25c2a0]' : 'text-[#5a5d61]'}>
                                          {t.passed ? '✓' : '·'}
                                        </span>
                                        <span>{item}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              ))}
                            </div>

                            {!t.passed && mode && (
                              <p class="mt-3 text-xs text-[#8a8d91]">
                                Not demonstrated in this run — {mode.hint.toLowerCase()}
                              </p>
                            )}
                          </div>
                        ) : (
                          <p class="text-xs text-[#8a8d91]">
                            No catalogue entry for this task. Regenerate with
                            <code class="mx-1 text-[#25c2a0]">eval-agent catalogue --output</code>.
                          </p>
                        )}
                      </td>
                    </tr>
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Anything the run itself flags */}
          {(agg.tokens.cache_read === 0 || agg.timed_out_tasks > 0) && (
            <div class="mt-3 text-xs text-[#8a8d91] space-y-1">
              {agg.tokens.cache_read === 0 && (
                <p>
                  No prompt cache reuse across {fmtNum(agg.tokens.input)} input tokens, so every
                  turn re-prefilled its whole prompt. Timings are an upper bound rather than a
                  measurement of the server.
                </p>
              )}
              {agg.timed_out_tasks > 0 && (
                <p>
                  {agg.timed_out_tasks} task(s) were cut off at {run.identity.agent_timeout_sec / 60}min.
                  A timeout is not evidence the model could not finish.
                </p>
              )}
            </div>
          )}
        </section>
      );
    })}

    <section class="mt-12 rounded-lg border border-[#3e4042] bg-[#242526] p-6">
      <h2 class="text-lg font-bold text-white mb-3">Reading these numbers</h2>
      <ul class="text-sm text-[#b0b3b8] space-y-2 leading-relaxed list-disc pl-5">
        <li>A task passes only when its verifier reward is exactly 1. Partial credit is not a pass.</li>
        <li>
          Failure modes are separated on purpose. <span class="text-amber-300">Timeout</span> and
          <span class="text-amber-300"> output budget</span> mean the run was cut short;
          <span class="text-purple-300"> verifier crashed</span> and
          <span class="text-purple-300"> no activity recorded</span> are harness faults;
          only <span class="text-red-300">wrong answer</span> is the model being wrong.
        </li>
        <li>pass@N is named for the attempt budget actually used and is not comparable across different budgets.</li>
        <li>Results are comparable only when the benchmark hash, tier and agent version all match.</li>
      </ul>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Rows expand to show what the task is and what passing it demonstrates.
  document.querySelectorAll<HTMLElement>('[data-task-row]').forEach((row) => {
    row.addEventListener('click', () => {
      const name = row.dataset.taskRow;
      const detail = document.querySelector<HTMLElement>(`[data-task-detail="${name}"]`);
      if (!detail) return;
      const open = !detail.classList.toggle('hidden');
      const caret = row.querySelector<HTMLElement>('[data-caret]');
      if (caret) caret.textContent = open ? '▾' : '▸';
    });
  });
</script>
