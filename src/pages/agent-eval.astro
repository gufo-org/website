---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// The catalogue describes the suite rather than any run: what each task is and
// what passing it demonstrates. Joined to results by task name, so results stay
// lean and capabilities are not duplicated once per run.
import catalogueRaw from '../data/agent-eval/catalogue.json';

// Every file here is a `gufo-agent-eval` result document, exactly as written by
// `eval-agent run --output`. The page renders the schema and nothing else, so a
// field missing here is a field the format needs to grow.
const modules = import.meta.glob<Record<string, any>>('../data/agent-eval/runs/*.json', { eager: true });

type TaskResult = {
  task: string;
  completed: boolean;
  passed: boolean;
  reward: number;
  duration_ms: number;
  first_response_ms: number | null;
  requests: number;
  tokens: { input: number; output: number; cache_read: number; cache_write: number; total: number };
  context_failures: number;
  agent_steps: number;
  tool_calls: number;
  tool_failures: number;
  tool_names: Record<string, number>;
  agent_timed_out: boolean;
  agent_exit_code: number;
  endpoint_errors: number;
  verifier_crashed: boolean;
  verifier_timed_out: boolean;
  workspace_hash: string | null;
  verifier_output: string;
};

type CatalogueTask = {
  task: string;
  summary: string;
  description: string;
  difficulty: string;
  category: string;
  requires: { label: string; items: string[] }[];
};

type ServerIdentity = {
  platform: string;
  platform_name: string | null;
  engine: string;
  engine_version: string | null;
  backend: string;
  backend_version: string | null;
  quant: string | null;
  inference_profile: string | null;
  context_length: number | null;
};

type RunResult = {
  schema_version: string;
  example?: boolean;
  generated_at: string;
  suite: string;
  tier: string;
  server: ServerIdentity;
  identity: Record<string, any>;
  machine: Record<string, any>;
  tasks: TaskResult[];
  aggregate: Record<string, any>;
};

const catalogue = (catalogueRaw as any);
const byTask = new Map<string, CatalogueTask>(
  (catalogue.tasks as CatalogueTask[]).map((t) => [t.task, t])
);

const runs: RunResult[] = Object.values(modules)
  .map((m) => (m.default ?? m) as RunResult)
  .filter((r) => r.schema_version?.startsWith('gufo-agent-eval/'));
runs.sort((a, b) => b.generated_at.localeCompare(a.generated_at));

/** How a run is labelled when comparing across engines and backends. */
function serverLabel(s: ServerIdentity): string {
  return [s.engine, s.backend, s.quant].filter(Boolean).join(' · ');
}


/** Stable id for a run, used to address its rows and columns from the facets. */
function runId(r: RunResult): string {
  return [r.server.engine, r.server.backend, r.server.quant, r.identity.model]
    .filter(Boolean)
    .join('-')
    .replace(/[^a-zA-Z0-9]+/g, '-')
    .toLowerCase();
}

/**
 * Facets are derived from the loaded data rather than hardcoded, so a new
 * engine or quantisation appears in the sidebar the moment a run using it is
 * added, and a facet with a single value is dropped as useless.
 */
function facet(label: string, key: string, values: (string | null | undefined)[]) {
  const counts = new Map<string, number>();
  for (const v of values) {
    if (!v) continue;
    counts.set(v, (counts.get(v) ?? 0) + 1);
  }
  return {
    label,
    key,
    options: [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0])),
  };
}

const runFacets = [
  facet('Engine', 'engine', runs.map((r) => r.server.engine)),
  facet('Backend', 'backend', runs.map((r) => r.server.backend)),
  facet('Platform', 'platform', runs.map((r) => r.server.platform)),
  facet('Quantisation', 'quant', runs.map((r) => r.server.quant)),
  facet('Model', 'model', runs.map((r) => r.identity.model)),
  facet('Agent', 'agent', runs.map((r) => `${r.identity.agent} ${r.identity.agent_version}`)),
].filter((f) => f.options.length > 1);

const allTaskNames = [...new Set(runs.flatMap((r) => r.tasks.map((t) => t.task)))];
const taskFacets = [
  facet('Category', 'category', allTaskNames.map((n) => byTask.get(n)?.category)),
  facet('Difficulty', 'difficulty', allTaskNames.map((n) => byTask.get(n)?.difficulty)),
].filter((f) => f.options.length > 1);

const fmtMin = (ms: number) => (ms / 60000).toFixed(1);
const fmtHours = (ms: number) => (ms / 3600000).toFixed(2);
const fmtNum = (n: number) => n.toLocaleString('en-US');

/**
 * Why a task did not pass, as far as the result can tell.
 *
 * These are kept apart deliberately: a run cut off by its timeout, a verifier
 * that produced no verdict, and a model that answered wrongly are three
 * different things, and averaging them into one "fail" hides the difference.
 */
function failureMode(t: TaskResult): { label: string; tone: string; hint: string } | null {
  if (t.passed) return null;
  if (t.verifier_crashed)
    return { label: 'verifier crashed', tone: 'purple', hint: 'No verdict produced. A harness fault, not a task failure.' };
  if (t.agent_timed_out && t.agent_steps === 0)
    return { label: 'no activity recorded', tone: 'purple', hint: 'Timed out having recorded no turns. Known measurement bug.' };
  if (t.agent_timed_out)
    return { label: 'timeout', tone: 'amber', hint: 'Cut off by the attempt timeout before finishing.' };
  if (t.context_failures > 0)
    return { label: 'output budget', tone: 'amber', hint: 'Stopped on length: the model exhausted its output budget mid-answer.' };
  return { label: 'wrong answer', tone: 'red', hint: 'Ran to completion; the verifier rejected the result.' };
}

/** Coarse outcome used by the facets: pass, model failure, or harness fault. */
function outcomeKey(t: TaskResult): string {
  if (t.passed) return 'pass';
  const mode = failureMode(t)!;
  return mode.tone === 'purple' ? 'harness' : mode.tone === 'amber' ? 'cut-short' : 'wrong';
}

const outcomeFacet = {
  label: 'Outcome',
  key: 'outcome',
  options: [
    ['pass', 0],
    ['wrong', 0],
    ['cut-short', 0],
    ['harness', 0],
  ] as [string, number][],
};

/**
 * What each column means, including the caveats that make a number
 * misleading if read at face value. Shown on hover rather than in a block at
 * the foot of the page, where nobody reads it while looking at a cell.
 */
const TIPS = {
  task: 'The task the agent was given. Click a row to see what it asks for and what passing it demonstrates.',
  result: 'A task passes only when its verifier reward is exactly 1. Partial verifier metrics are not passes.',
  time: 'Wall time for the whole attempt: agent startup, model time and tool execution. Model time is usually the minority of it, so this is not a measure of server speed.',
  turns: 'Assistant turns the agent completed. A turn cut off by the timeout may not be counted.',
  tools: 'Tool calls the agent made, with failed calls in red. Every task that has passed so far made zero failed calls.',
  input: 'Prompt tokens reported by the agent, summed over turns. With no prompt cache reuse each turn re-sends the whole conversation, so this grows faster than the work does.',
  output: 'Completion tokens reported by the agent. Known to undercount reasoning — the server reports more generated tokens than this — so treat it as a lower bound.',
  ttfr: 'Launch to the first byte from the agent, including agent startup. An upper bound on time to first model response, not a server latency measurement.',
} as const;

const toneClass: Record<string, string> = {
  purple: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
  amber: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  red: 'bg-red-500/15 text-red-300 border-red-500/30',
};
---

<Layout title="Agent Eval — gufo">
  <Navbar currentPath="/agent-eval" />

  <main class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-white tracking-tight">Agent Evaluation</h1>
      <p class="mt-3 text-[#b0b3b8] max-w-3xl leading-relaxed">
        Whether a served model, driven by a fixed coding agent through a terminal,
        can finish multi-step work. The agent runs in a bubblewrap sandbox and a
        deterministic verifier scores the workspace it leaves behind — a task
        passes only when its reward is exactly&nbsp;1.
      </p>
      <p class="mt-3 text-sm text-[#8a8d91] max-w-3xl leading-relaxed">
        This measures task completion, not speed. Raw throughput lives on the
        <a href="/benchmarks" class="text-[#25c2a0] hover:underline">benchmarks</a> page.
        The suite is derived from Terminal-Bench 2.1 but runs a different agent in a
        different sandbox, so these numbers are <strong class="text-[#b0b3b8]">not</strong> an
        official Terminal-Bench score.
      </p>
    </header>

    <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-8">
      <!-- Facets -->
      <aside class="mb-8 lg:mb-0 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-xs uppercase tracking-wide text-[#8a8d91] font-medium">Filter</h2>
          <button id="facet-clear" class="text-[11px] text-[#8a8d91] hover:text-[#25c2a0] transition-colors hidden">clear</button>
        </div>

        <div class="space-y-5 text-sm">
          {[...runFacets, outcomeFacet, ...taskFacets].map((f) => (
            <div>
              <div class="text-[11px] uppercase tracking-wide text-[#8a8d91] mb-1.5">{f.label}</div>
              <div class="space-y-0.5">
                {f.options.map(([value, count]) => (
                  <label class="flex items-center gap-2 px-2 py-1 -mx-2 rounded hover:bg-[#242526] cursor-pointer group">
                    <input type="checkbox" class="facet accent-[#25c2a0] w-3.5 h-3.5" data-facet={f.key} value={value} />
                    <span class="text-[13px] text-[#b0b3b8] group-hover:text-[#e4e6eb] truncate">{value}</span>
                    {count > 0 && <span class="ml-auto text-[11px] text-[#5a5d61] tabular-nums">{count}</span>}
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>

        <p class="mt-6 text-[11px] text-[#5a5d61] leading-relaxed">
          Filters within a facet are OR; across facets they are AND. Hiding a run
          removes its column from the comparison.
        </p>
      </aside>

      <div>
        <p id="facet-empty" class="hidden rounded-lg border border-[#3e4042] bg-[#242526] p-6 text-sm text-[#8a8d91]">
          Nothing matches these filters.
        </p>

    {runs.length === 0 && (
      <div class="rounded-lg border border-[#3e4042] bg-[#242526] p-8 text-center text-[#8a8d91]">
        No result documents yet. Drop the JSON from
        <code class="mx-1 text-[#25c2a0]">eval-agent run --output</code>
        into <code class="text-[#25c2a0]">src/data/agent-eval/</code>.
      </div>
    )}

    <!-- Comparison, built from whichever runs are ticked below. -->
    <div id="comparison" class="mb-10 hidden"></div>

    <p id="comparison-hint" class="mb-8 text-sm text-[#8a8d91]">
      Tick <span class="text-[#e4e6eb]">compare</span> on two or more runs to put them
      side by side. Up to four.
    </p>


    {runs.map((run) => {
      const agg = run.aggregate;
      const passRate = (agg.pass_at_1 * 100).toFixed(0);
      const byDuration = [...run.tasks].sort((a, b) => b.duration_ms - a.duration_ms);
      const attempts = run.identity.attempts_per_task;

      return (
        <section
          class="mb-14"
          data-run={runId(run)}
          data-engine={run.server.engine}
          data-backend={run.server.backend}
          data-platform={run.server.platform}
          data-quant={run.server.quant ?? ''}
          data-model={run.identity.model}
          data-agent={`${run.identity.agent} ${run.identity.agent_version}`}
        >
          {/* Run identity */}
          <div class="rounded-t-lg border border-[#3e4042] bg-[#242526] px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2">
            <div>
              <div class="text-lg font-bold text-white">{run.identity.model}</div>
              <div class="text-xs text-[#8a8d91] mt-0.5">
                {run.identity.model_name ?? run.identity.model} on
                {' '}<span class="text-[#25c2a0]">{serverLabel(run.server)}</span>
                {' '}· {run.server.platform_name ?? run.server.platform}
              </div>
              <div class="text-xs text-[#8a8d91] mt-0.5">
                agent {run.identity.agent} {run.identity.agent_version} · tier {run.tier} ·
                {' '}{new Date(run.generated_at).toISOString().slice(0, 10)}
              </div>
            </div>
            <label
              class="ml-auto flex items-center gap-2 px-2.5 py-1.5 rounded border border-[#3e4042] hover:border-[#25c2a0]/50 cursor-pointer transition-colors select-none"
              title="Put this run side by side with others"
            >
              <input type="checkbox" class="compare accent-[#25c2a0] w-3.5 h-3.5" data-run={runId(run)} />
              <span class="text-xs text-[#b0b3b8]">compare</span>
            </label>

            <div class="flex flex-wrap gap-2 text-[11px]">
              {run.example && (
                <span class="px-2 py-1 rounded border border-amber-500/40 bg-amber-500/15 text-amber-300 font-medium">
                  illustrative — not a measurement
                </span>
              )}
              <span class="px-2 py-1 rounded border border-[#3e4042] text-[#8a8d91] font-mono">
                {run.identity.endpoint_label}
              </span>
              <span class="px-2 py-1 rounded border border-[#3e4042] text-[#8a8d91] font-mono">
                benchmark {run.identity.benchmark_hash}
              </span>
              {!run.identity.limits_enforced && (
                <span class="px-2 py-1 rounded border border-amber-500/30 bg-amber-500/10 text-amber-300">
                  resource limits not enforced
                </span>
              )}
            </div>
          </div>

          {/* Headline numbers */}
          <div class="border-x border-[#3e4042] bg-[#1c1e21] grid grid-cols-2 md:grid-cols-5 divide-x divide-[#3e4042]">
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-[#25c2a0]">{agg.passed_tasks}/{agg.total_tasks}</div>
              <div class="text-xs text-[#8a8d91] mt-1">passed — pass@{attempts} {passRate}%</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtHours(agg.total_duration_ms)}h</div>
              <div class="text-xs text-[#8a8d91] mt-1">wall time</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtNum(agg.tokens.input)}</div>
              <div class="text-xs text-[#8a8d91] mt-1">input tokens</div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{fmtNum(agg.tokens.cache_read)}</div>
              <div class="text-xs text-[#8a8d91] mt-1">
                cached {agg.tokens.cache_read === 0 && <span class="text-amber-400">· none reused</span>}
              </div>
            </div>
            <div class="px-5 py-4">
              <div class="text-2xl font-bold text-white">{agg.timed_out_tasks}</div>
              <div class="text-xs text-[#8a8d91] mt-1">timed out</div>
            </div>
          </div>

          {/* Per task */}
          <div class="border border-[#3e4042] rounded-b-lg overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-[#242526] text-[#8a8d91] text-xs uppercase tracking-wide">
                <tr>
                  <th class="text-left font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.task}>Task</th>
                  <th class="text-left font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.result}>Result</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.time}>Time</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.turns}>Turns</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.tools}>Tools</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.input}>In</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.output}>Out</th>
                  <th class="text-right font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.ttfr}>TTFR</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3e4042]">
                {byDuration.map((t) => {
                  const mode = failureMode(t);
                  const meta = byTask.get(t.task);
                  return (
                    <>
                    <tr
                      class="hover:bg-[#242526]/60 transition-colors cursor-pointer"
                      data-task-row={t.task}
                      data-task={t.task}
                      data-category={meta?.category ?? ''}
                      data-difficulty={meta?.difficulty ?? ''}
                      data-outcome={outcomeKey(t)}
                    >
                      <td class="px-4 py-3 font-mono text-[13px] text-[#e4e6eb]">
                        <span class="inline-block w-3 text-[#8a8d91] select-none" data-caret>▸</span>
                        {t.task}
                      </td>
                      <td class="px-4 py-3">
                        {t.passed ? (
                          <span
                            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-[#25c2a0]/30 bg-[#25c2a0]/10 text-[#25c2a0] text-xs font-medium cursor-help"
                            data-tip="The verifier scored this workspace 1. Every capability listed below the row was demonstrated."
                          >
                            pass
                          </span>
                        ) : (
                          <span
                            class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-xs font-medium cursor-help ${toneClass[mode!.tone]}`}
                            data-tip={mode!.hint}
                          >
                            {mode!.label}
                          </span>
                        )}
                      </td>
                      <td
                        class="px-4 py-3 text-right tabular-nums text-[#b0b3b8] cursor-help"
                        data-tip={`${(t.duration_ms / 1000).toFixed(0)}s wall time. ${
                          t.throughput?.turns_timed
                            ? `Model time was ${(((t.throughput.prefill_ms ?? 0) + (t.throughput.decode_ms ?? 0)) / 1000).toFixed(0)}s of it; the rest is agent startup and tool execution.`
                            : 'Model time was not measured for this run.'
                        }`}
                      >{fmtMin(t.duration_ms)}m</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">{t.agent_steps}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">
                        {t.tool_calls}
                        {t.tool_failures > 0 && (
                          <span
                            class="text-red-400 ml-1 cursor-help"
                            data-tip={`${t.tool_failures} tool call(s) returned an error. Failed calls have accompanied every failure so far and none of the passes.`}
                          >({t.tool_failures}✗)</span>
                        )}
                      </td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">{fmtNum(t.tokens.input)}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-[#b0b3b8]">
                        {fmtNum(t.tokens.output)}
                        {t.context_failures > 0 && (
                          <span
                            class="text-amber-400 ml-1 cursor-help"
                            data-tip="Generation stopped on length: the model spent its whole output budget without finishing. With thinking enabled, reasoning and answer share that budget. This is a configuration limit, not the model being wrong."
                          >⚠</span>
                        )}
                      </td>
                      <td
                        class="px-4 py-3 text-right tabular-nums text-[#8a8d91] cursor-help"
                        data-tip={t.first_response_ms === null
                          ? 'The agent produced no output at all, so nothing could be timed.'
                          : 'Launch to first byte from the agent, including its own startup.'}
                      >
                        {t.first_response_ms === null ? '—' : `${t.first_response_ms}ms`}
                      </td>
                    </tr>

                    <tr class="hidden" data-task-detail={t.task} data-task={t.task}>
                      <td colspan="8" class="px-4 pb-5 pt-1 bg-[#1c1e21]">
                        {meta ? (
                          <div class="max-w-4xl">
                            <div class="flex flex-wrap items-center gap-2 mb-3">
                              <span class="text-[11px] px-2 py-0.5 rounded border border-[#3e4042] text-[#8a8d91]">
                                {meta.category}
                              </span>
                              <span class="text-[11px] px-2 py-0.5 rounded border border-[#3e4042] text-[#8a8d91]">
                                {meta.difficulty}
                              </span>
                            </div>

                            <p class="text-sm text-[#b0b3b8] leading-relaxed mb-4">{meta.summary}</p>

                            <div class="text-xs uppercase tracking-wide text-[#8a8d91] mb-2">
                              Passing this demonstrates
                            </div>
                            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                              {meta.requires.map((group) => (
                                <div class="rounded border border-[#3e4042] bg-[#242526] p-3">
                                  <div class="text-[13px] font-medium text-[#e4e6eb] mb-1.5">
                                    {group.label}
                                  </div>
                                  <ul class="space-y-1">
                                    {group.items.map((item) => (
                                      <li class="text-xs text-[#b0b3b8] leading-snug flex gap-1.5">
                                        <span class={t.passed ? 'text-[#25c2a0]' : 'text-[#5a5d61]'}>
                                          {t.passed ? '✓' : '·'}
                                        </span>
                                        <span>{item}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              ))}
                            </div>

                            {!t.passed && mode && (
                              <p class="mt-3 text-xs text-[#8a8d91]">
                                Not demonstrated in this run — {mode.hint.toLowerCase()}
                              </p>
                            )}
                          </div>
                        ) : (
                          <p class="text-xs text-[#8a8d91]">
                            No catalogue entry for this task. Regenerate with
                            <code class="mx-1 text-[#25c2a0]">eval-agent catalogue --output</code>.
                          </p>
                        )}
                      </td>
                    </tr>
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Anything the run itself flags */}
          {(agg.tokens.cache_read === 0 || agg.timed_out_tasks > 0) && (
            <div class="mt-3 text-xs text-[#8a8d91] space-y-1">
              {agg.tokens.cache_read === 0 && (
                <p>
                  No prompt cache reuse across {fmtNum(agg.tokens.input)} input tokens, so every
                  turn re-prefilled its whole prompt. Timings are an upper bound rather than a
                  measurement of the server.
                </p>
              )}
              {agg.timed_out_tasks > 0 && (
                <p>
                  {agg.timed_out_tasks} task(s) were cut off at {run.identity.agent_timeout_sec / 60}min.
                  A timeout is not evidence the model could not finish.
                </p>
              )}
            </div>
          )}
        </section>
      );
    })}

      </div>
    </div>

  </main>

  <div
    id="tip"
    role="tooltip"
    class="hidden fixed z-50 max-w-xs rounded-md border border-[#3e4042] bg-[#1c1e21] px-3 py-2 text-xs leading-relaxed text-[#b0b3b8] shadow-xl pointer-events-none"
  ></div>

  <script type="application/json" id="runs-data" set:html={JSON.stringify(
    runs.map((r) => ({
      id: runId(r),
      engine: r.server.engine,
      backend: r.server.backend,
      quant: r.server.quant,
      model: r.identity.model_name ?? r.identity.model,
      example: r.example === true,
      benchmark: r.identity.benchmark_hash,
      agent: `${r.identity.agent} ${r.identity.agent_version}`,
      passed: r.aggregate.passed_tasks,
      total: r.aggregate.total_tasks,
      duration_ms: r.aggregate.total_duration_ms,
      tasks: r.tasks.map((t) => ({
        task: t.task,
        passed: t.passed,
        duration_ms: t.duration_ms,
        outcome: outcomeKey(t),
        label: t.passed ? 'pass' : failureMode(t)!.label,
      })),
    }))
  )} />

  <Footer />
</Layout>

<script>
  /**
   * Hover explanations.
   *
   * The guidance sits on the thing it describes rather than in a block at the
   * foot of the page, because the moment someone needs to know that a duration
   * is wall time is the moment they are looking at the duration.
   */
  const tip = document.getElementById('tip')!;

  function showTip(el: HTMLElement) {
    const text = el.dataset.tip;
    if (!text) return;
    tip.textContent = text;
    tip.classList.remove('hidden');

    const r = el.getBoundingClientRect();
    const t = tip.getBoundingClientRect();
    // Prefer above; flip below when there is no room, and keep it on screen.
    const top = r.top - t.height - 8 < 8 ? r.bottom + 8 : r.top - t.height - 8;
    const left = Math.min(
      Math.max(8, r.left + r.width / 2 - t.width / 2),
      window.innerWidth - t.width - 8
    );
    tip.style.top = `${top}px`;
    tip.style.left = `${left}px`;
  }

  const hideTip = () => tip.classList.add('hidden');

  document.addEventListener('mouseover', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
    if (el) showTip(el);
  });
  document.addEventListener('mouseout', (e) => {
    if ((e.target as HTMLElement).closest('[data-tip]')) hideTip();
  });
  document.addEventListener('scroll', hideTip, true);

  /**
   * Comparison, built from whichever runs are ticked.
   *
   * Explicit rather than automatic: which runs are worth putting side by side
   * is a judgement the reader makes, not one the page can infer from metadata.
   * Comparability is still checked and reported, because a table implies the
   * numbers answer the same question whether or not they do.
   */
  const MAX_COMPARE = 4;

  const OUTCOME_TIP: Record<string, string> = {
    wrong: 'Ran to completion and the verifier rejected the result. The model was wrong.',
    'cut-short': 'Cut off before finishing, by the attempt timeout or the output budget. Not evidence the model could not do it.',
    harness: 'A harness fault rather than a model failure: the verifier produced no verdict, or the run recorded no activity.',
  };

  type CmpTask = { task: string; passed: boolean; duration_ms: number; outcome: string; label: string };
  type CmpRun = {
    id: string; engine: string; backend: string; quant: string | null; model: string;
    example: boolean; benchmark: string; agent: string;
    passed: number; total: number; duration_ms: number; tasks: CmpTask[];
  };

  const RUNS: CmpRun[] = JSON.parse(
    document.getElementById('runs-data')?.textContent ?? '[]'
  );

  const boxesFor = () => [...document.querySelectorAll<HTMLInputElement>('input.compare')];
  const esc = (v: string) => v.replace(/[&<>"]/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  function renderComparison() {
    const chosen = boxesFor().filter((b) => b.checked).map((b) => b.dataset.run!);
    const panel = document.getElementById('comparison')!;
    const hint = document.getElementById('comparison-hint')!;

    // Once four are ticked, the rest are unavailable rather than silently ignored.
    const atLimit = chosen.length >= MAX_COMPARE;
    boxesFor().forEach((b) => {
      b.disabled = atLimit && !b.checked;
      b.closest('label')?.classList.toggle('opacity-40', b.disabled);
    });

    if (chosen.length < 2) {
      panel.classList.add('hidden');
      panel.innerHTML = '';
      hint.classList.remove('hidden');
      hint.textContent = chosen.length === 1
        ? 'Tick compare on at least one more run to put them side by side. Up to four.'
        : 'Tick compare on two or more runs to put them side by side. Up to four.';
      return;
    }

    hint.classList.add('hidden');
    const picked = chosen.map((id) => RUNS.find((r) => r.id === id)!).filter(Boolean);

    const problems: string[] = [];
    if (new Set(picked.map((r) => r.benchmark)).size > 1)
      problems.push('different benchmark identity: the tasks, tier or agent configuration differ between these runs');
    if (new Set(picked.map((r) => r.agent)).size > 1)
      problems.push('different agent revisions');
    if (picked.some((r) => r.example))
      problems.push('one or more columns are illustrative, not measurements');

    const names = [...new Set(picked.flatMap((r) => r.tasks.map((t) => t.task)))].sort();

    const head = picked.map((r) => `
      <th class="text-left font-medium px-4 py-3 ${r.example ? 'bg-amber-500/[0.06]' : ''}">
        <div class="text-[#e4e6eb] normal-case text-[13px]">${esc(r.engine)}${
          r.example ? ' <span class="ml-1 font-mono text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">example</span>' : ''
        }</div>
        <div class="font-normal normal-case text-[11px] text-[#8a8d91]">${
          esc([r.backend, r.quant].filter(Boolean).join(' · '))
        }</div>
      </th>`).join('');

    const body = names.map((name) => {
      const cells = picked.map((r) => r.tasks.find((t) => t.task === name));
      const differs = new Set(cells.map((c) => (c ? c.passed : null))).size > 1;
      return `
        <tr class="${differs ? 'bg-amber-500/[0.04]' : ''}">
          <td class="px-4 py-2.5 font-mono text-[13px] text-[#e4e6eb]">${esc(name)}${
            differs
              ? '<span class="ml-2 text-[11px] text-amber-400 cursor-help" data-tip="The selected runs disagree on this task. These rows are the only ones carrying information; the rest agree.">differs</span>'
              : ''
          }</td>
          ${cells.map((c) => c
            ? `<td class="px-4 py-2.5 cursor-help" data-tip="${esc(
                 c.passed
                   ? 'Verifier scored this workspace 1.'
                   : OUTCOME_TIP[c.outcome] ?? 'Did not pass.'
               )} Wall time ${(c.duration_ms / 60000).toFixed(1)} minutes, which includes tool execution."><span class="flex items-baseline gap-2">
                 <span class="${c.passed ? 'text-[#25c2a0]' : 'text-red-400'}">${esc(c.label)}</span>
                 <span class="text-[11px] text-[#8a8d91] tabular-nums">${(c.duration_ms / 60000).toFixed(1)}m</span>
               </span></td>`
            : '<td class="px-4 py-2.5 text-[#5a5d61] text-xs cursor-help" data-tip="This task was not part of that run.">not run</td>').join('')}
        </tr>`;
    }).join('');

    const foot = picked.map((r) => `
      <td class="px-4 py-3">
        <span class="text-[#25c2a0] font-bold">${r.passed}/${r.total}</span>
        <span class="ml-2 text-[11px] text-[#8a8d91]">${(r.duration_ms / 3600000).toFixed(2)}h</span>
      </td>`).join('');

    panel.innerHTML = `
      <div class="flex items-center gap-3 mb-3">
        <h2 class="text-xl font-bold text-white">Comparison</h2>
        <span class="text-xs text-[#8a8d91]">${picked.length} runs</span>
        <button id="comparison-clear" class="ml-auto text-[11px] text-[#8a8d91] hover:text-[#25c2a0]">clear</button>
      </div>
      ${problems.length ? `
        <div class="mb-4 rounded border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
          <strong class="font-semibold">These runs are not directly comparable.</strong>
          <ul class="mt-1 list-disc pl-5 text-[13px]">${problems.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>
        </div>` : ''}
      <div class="border border-[#3e4042] rounded-lg overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[#242526] text-[#8a8d91] text-xs uppercase tracking-wide">
            <tr><th class="text-left font-medium px-4 py-3 cursor-help underline decoration-dotted decoration-[#5a5d61] underline-offset-4" data-tip={TIPS.task}>Task</th>${head}</tr>
          </thead>
          <tbody class="divide-y divide-[#3e4042]">${body}</tbody>
          <tfoot class="bg-[#242526] border-t-2 border-[#3e4042]">
            <tr><td class="px-4 py-3 text-xs uppercase tracking-wide text-[#8a8d91]">Passed</td>${foot}</tr>
          </tfoot>
        </table>
      </div>`;
    panel.classList.remove('hidden');

    document.getElementById('comparison-clear')?.addEventListener('click', () => {
      boxesFor().forEach((b) => (b.checked = false));
      renderComparison();
    });
  }

  boxesFor().forEach((b) => b.addEventListener('change', renderComparison));
  renderComparison();

  /**
   * Faceted filtering.
   *
   * Within a facet the selections are OR (two backends means either); across
   * facets they are AND (that backend *and* that difficulty). Run-level facets
   * hide whole runs and their comparison columns; task-level facets hide rows.
   */
  const RUN_KEYS = ['engine', 'backend', 'platform', 'quant', 'model', 'agent'];
  const TASK_KEYS = ['category', 'difficulty', 'outcome'];

  const boxes = () => [...document.querySelectorAll<HTMLInputElement>('input.facet')];

  function selected() {
    const out: Record<string, Set<string>> = {};
    for (const b of boxes()) {
      if (!b.checked) continue;
      const key = b.dataset.facet!;
      (out[key] ??= new Set()).add(b.value);
    }
    return out;
  }

  function matches(el: HTMLElement, keys: string[], sel: Record<string, Set<string>>) {
    for (const key of keys) {
      const wanted = sel[key];
      if (!wanted) continue;
      // `outcome` can hold several values on a comparison row, one per run.
      const have = (el.dataset[key] ?? '').split(' ').filter(Boolean);
      if (!have.some((v) => wanted.has(v))) return false;
    }
    return true;
  }

  function apply() {
    const sel = selected();
    const any = Object.keys(sel).length > 0;
    document.getElementById('facet-clear')?.classList.toggle('hidden', !any);

    // Runs. The comparison is driven by explicit ticks, not by the facets, so
    // a filtered-out run keeps its place in a comparison already built.
    document.querySelectorAll<HTMLElement>('section[data-run]').forEach((section) => {
      section.classList.toggle('hidden', !matches(section, RUN_KEYS, sel));
    });

    // Task rows, in both the comparison table and the per-run tables.
    const hiddenTasks = new Set<string>();
    document.querySelectorAll<HTMLElement>('tr[data-task]').forEach((row) => {
      if (row.hasAttribute('data-task-detail')) return;
      const show = matches(row, TASK_KEYS, sel);
      row.classList.toggle('hidden', !show);
      if (!show) hiddenTasks.add(row.dataset.task!);
    });
    // A collapsed detail row must not reappear just because its parent is shown.
    document.querySelectorAll<HTMLElement>('tr[data-task-detail]').forEach((row) => {
      if (hiddenTasks.has(row.dataset.task!)) row.classList.add('hidden');
    });

    const visibleRuns = document.querySelectorAll('section[data-run]:not(.hidden)').length;
    document.getElementById('facet-empty')?.classList.toggle('hidden', visibleRuns > 0);
  }

  boxes().forEach((b) => b.addEventListener('change', apply));
  document.getElementById('facet-clear')?.addEventListener('click', () => {
    boxes().forEach((b) => (b.checked = false));
    apply();
  });

  // Rows expand to show what the task is and what passing it demonstrates.
  document.querySelectorAll<HTMLElement>('[data-task-row]').forEach((row) => {
    row.addEventListener('click', () => {
      const name = row.dataset.taskRow;
      const detail = document.querySelector<HTMLElement>(`[data-task-detail="${name}"]`);
      if (!detail) return;
      const open = !detail.classList.toggle('hidden');
      const caret = row.querySelector<HTMLElement>('[data-caret]');
      if (caret) caret.textContent = open ? '▾' : '▸';
    });
  });
</script>
