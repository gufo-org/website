---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// Keep this list aligned with the official Gufo README's model list.
const models = [
  { name: 'Qwen3.8 Flash-Next', role: 'Text and images', href: '/docs/models/qwen3.8-flash-next' },
  { name: 'Qwen3.8 27B', role: 'Text and images', href: '/docs/models/qwen3.8-27b' },
  { name: 'DeepSeek V4 Flash', role: 'Text', href: '/docs/models/deepseek-v4-flash' },
  { name: 'EmbeddingGemma 2', role: 'Multimodal embeddings', href: '/docs/models/embeddinggemma-2' },
  { name: 'Qwen3-ASR 1.7B', role: 'Speech to text', href: '/docs/models/qwen3-asr' },
  { name: 'Qwen3-TTS 1.7B', role: 'Speech and voice cloning', href: '/docs/models/qwen3-tts' },
  { name: 'Qwen-Image-2.1 & Turbo', role: 'Image generation and editing', href: 'https://github.com/gufo-org/gufo/blob/main/docs/models/qwen-image-2.1.md' },
  { name: 'MiniMax H3', role: 'Video with sound', href: '/docs/models/minimax-h3' },
];
---

<Layout title="Gufo: the Strix Halo inference engine">
  <Navbar currentPath="/" />

  <main id="main-content" class="flex-1">
    <header class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-14 sm:pt-16 sm:pb-16">
      <h1 class="max-w-4xl text-5xl sm:text-6xl lg:text-7xl text-ink leading-[1.05] text-balance">
        The <em class="text-forest">Open Source</em> Strix Halo AI engine
      </h1>
      <p class="mt-5 max-w-2xl text-lg sm:text-xl text-ink-2 leading-relaxed">
        Gufo is an open source inference engine built to run text, vision and audio models on AMD Strix Halo.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/docs" class="inline-flex items-center h-12 px-6 rounded-full bg-forest text-ivory text-sm font-semibold hover:bg-forest-dark transition-colors">Get started <span class="ml-3" aria-hidden="true">→</span></a>
        <a href="/benchmarks" class="inline-flex items-center h-12 px-6 rounded-full border border-line-strong text-ink text-sm font-semibold hover:bg-paper transition-colors">See benchmarks</a>
      </div>
    </header>

    <section class="border-t border-line bg-paper/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
          <div>
            <p class="eyebrow mb-3">01 / GET STARTED</p>
            <h2 class="text-3xl sm:text-4xl">Run Gufo your way</h2>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/docs/install" class="group flex flex-col min-h-40 rounded-xl border border-line bg-ivory p-5 hover:border-forest transition-colors">
            <span class="flex items-center justify-between gap-4"><span class="font-mono text-sm text-forest">01 / PLATFORM</span><img src="/images/linux.png" alt="" width="40" height="40" class="h-10 w-10 object-contain" /></span>
            <span class="mt-auto pt-8 flex items-end justify-between gap-4"><span><span class="block text-2xl font-semibold text-ink">Linux</span><span class="block mt-2 text-sm text-ink-2">Install and run Gufo</span></span><span class="text-xl text-forest group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span></span>
          </a>
          <a href="/docs/install#windows" class="group flex flex-col min-h-40 rounded-xl border border-line bg-ivory p-5 hover:border-forest transition-colors">
            <span class="flex items-center justify-between gap-4"><span class="font-mono text-sm text-forest">02 / PLATFORM</span><img src="/images/windows.png" alt="" width="40" height="40" class="h-10 w-10 object-contain" /></span>
            <span class="mt-auto pt-8 flex items-end justify-between gap-4"><span><span class="block text-2xl font-semibold text-ink">Windows</span><span class="block mt-2 text-sm text-ink-2">Install and run Gufo</span></span><span class="text-xl text-forest group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span></span>
          </a>
          <a href="https://lemonade-server.ai/docs/guide/cli/#gufo-gufo-recipe" target="_blank" rel="noopener noreferrer" class="group flex flex-col min-h-40 rounded-xl border border-line bg-ivory p-5 hover:border-forest transition-colors">
            <span class="flex items-center justify-between gap-4"><span class="font-mono text-sm text-forest">03 / INTEGRATION</span><img src="/images/lemonade.ico" alt="" width="40" height="40" class="h-10 w-10 object-contain" /></span>
            <span class="mt-auto pt-8 flex items-end justify-between gap-4"><span><span class="block text-2xl font-semibold text-ink">Lemonade</span><span class="block mt-2 text-sm text-ink-2">Gufo is a supported backend</span></span><span class="text-xl text-forest" aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-8">
          <div><p class="eyebrow mb-3">02 / MODELS</p><h2 class="text-3xl sm:text-4xl">Models built into Gufo</h2><p class="mt-4 text-ink-2 leading-relaxed">Explore text, vision and audio models, each with its own implementation.</p></div>
          <a href="/extensions" class="text-sm font-semibold text-forest underline decoration-line-strong hover:decoration-forest shrink-0">Explore extensions →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {models.map((model) => (
            <a href={model.href} class="group flex flex-col min-h-32 rounded-xl border border-line p-5 hover:border-forest hover:bg-paper/50 transition-colors">
              <span class="text-xs font-mono uppercase tracking-wide text-forest">{model.role}</span>
              <span class="mt-auto pt-5 flex items-end justify-between gap-4"><span class="text-xl font-semibold text-ink">{model.name}</span><span class="text-forest group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-forest text-ivory">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14 grid md:grid-cols-2 gap-8 md:gap-16">
        <div><p class="font-mono text-xs text-ivory/70 mb-4">03 / COMMUNITY</p><h2 class="text-3xl sm:text-4xl">Open Source.</h2></div>
        <div class="text-ivory/85 leading-relaxed"><p>Gufo is open source and contributions are welcome. The community also maintains Gufo RDMA, a fork for linking two Strix Halo systems.</p><a href="https://github.com/neuhaus/gufo" target="_blank" rel="noopener noreferrer" class="inline-block mt-6 text-sm font-semibold text-ivory underline decoration-ivory/50 hover:decoration-ivory">Explore Gufo RDMA ↗</a></div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
