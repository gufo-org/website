---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ModelMatrix from '../components/ModelMatrix.astro';

const principles = [
  {
    title: 'One target, optimized vertically',
    body:
      'Linux x86-64 on Ryzen AI MAX+ 395 with Radeon 8060S (gfx1151) is the only production target. Wave32 HIP kernels are compiled for that GPU and nothing else, so there is no lowest-common-denominator abstraction to pay for.',
  },
  {
    title: 'Batteries included',
    body:
      'Seven models ship in one executable: dense and MoE text with images, speech recognition, speech synthesis and voice cloning, image generation and editing, and text to audiovisual output.',
  },
  {
    title: 'Speculative decoding that keeps output',
    body:
      'DFlash2 for Qwen3.8 27B, MTP for Flash-Next and DSpark for DeepSeek V4 Flash. Greedy speculation must reproduce autoregressive output; sampled speculation preserves the target distribution.',
  },
  {
    title: 'Concurrency as a first-class workload',
    body:
      'A bounded session pool, request batching, cancellation propagated from socket closure, and RAM plus optional on-disk conversation caching. Concurrent throughput is measured, not assumed.',
  },
];

// Headline figures from docs/models/qwen3.8-27b/BENCHMARKS.md (Q4, HTTP, greedy).
const stats = [
  { value: '656 tok/s', label: 'Prefill, Qwen3.8 27B', note: '+84% vs llama.cpp' },
  { value: '63 tok/s', label: 'DFlash2 decode, repetitive', note: '+76% vs llama.cpp' },
  { value: '5.9 s', label: 'Cold load to serving', note: 'llama.cpp takes 23.3 s' },
  { value: '7 models', label: 'Text, audio, image, video', note: 'One binary' },
];

const images = [
  {
    name: 'gufo-runtime',
    body: 'Production image for inference, benchmarks and the HTTP server.',
    command: 'podman pull ghcr.io/gufo-org/toolboxes/gufo-runtime:latest',
  },
  {
    name: 'gufo-dev',
    body: 'Development image with the HIP compiler, profilers and build tooling.',
    command: 'podman pull ghcr.io/gufo-org/toolboxes/gufo-dev:latest',
  },
];
---

<Layout title="Gufo: the Strix Halo inference engine">
  <Navbar currentPath="/" />

  <main class="flex-1">
    <!-- Hero -->
    <header class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-20 sm:pt-28 sm:pb-24">
      <p class="eyebrow mb-6">gfx1151 · Ryzen AI MAX+ 395 · 128 GiB unified memory</p>
      <h1 class="text-5xl sm:text-7xl text-ink leading-[1.04] max-w-4xl">
        The Strix Halo inference engine
      </h1>
      <p class="mt-8 text-lg sm:text-xl text-ink-2 leading-relaxed max-w-2xl">
        Gufo runs text, images, audio and video on Ryzen AI MAX+ 395 systems with Radeon 8060S and up to 128 GiB of
        unified memory. One C++20 executable, one OpenAI-compatible server.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/docs" class="inline-flex items-center h-11 px-5 rounded-full bg-forest text-ivory text-sm hover:bg-forest-dark transition-colors">
          Get started
        </a>
        <a
          href="/benchmarks"
          class="inline-flex items-center h-11 px-5 rounded-full border border-line-strong text-ink text-sm hover:bg-paper transition-colors"
        >
          See benchmarks
        </a>
      </div>

      <a href="/benchmarks" class="group mt-16 grid grid-cols-2 lg:grid-cols-4 border-t border-line">
        {stats.map((st, i) => (
          <div class={`pt-6 pb-2 pr-4 ${i % 2 ? 'pl-4 lg:pl-6 border-l border-line' : i ? 'lg:pl-6 lg:border-l lg:border-line' : ''}`}>
            <div class="font-mono text-2xl sm:text-3xl text-ink tracking-tight">{st.value}</div>
            <div class="mt-2 text-sm text-ink-2">{st.label}</div>
            <div class="mt-0.5 text-sm text-ink-3">{st.note}</div>
          </div>
        ))}
      </a>
    </header>

    <!-- Principles -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div><p class="eyebrow mb-3">01 / Principles</p><h2 class="text-3xl text-ink">Why Gufo</h2></div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-12">
          {principles.map((p) => (
            <div>
              <h3 class="text-base font-semibold text-ink">{p.title}</h3>
              <p class="mt-3 text-[15px] text-ink-2 leading-relaxed">{p.body}</p>
            </div>
          ))}
          <a href="/philosophy" class="text-sm text-ink underline decoration-line-strong hover:decoration-ink">
            Read the project philosophy
          </a>
        </div>
      </div>
    </section>

    <!-- Quickstart -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid grid-cols-1 lg:grid-cols-3 gap-10 [&>*]:min-w-0">
        <div>
          <p class="eyebrow mb-3">02 / Quickstart</p>
          <h2 class="text-3xl text-ink">Serve in two commands</h2>
          <p class="mt-5 text-[15px] text-ink-2 leading-relaxed">
            Download weights, then run the runtime image with GPU device access. The server speaks the OpenAI API on
            port 8080, so Open WebUI, VS Code or any OpenAI SDK client can point at
            <code class="text-ink">localhost:8080/v1</code>.
          </p>
          <p class="mt-4 text-sm text-ink-3 leading-relaxed">
            Rootless Podman needs <code>crun</code> for <code>--group-add keep-groups</code>, and your user needs access
            to <code>/dev/kfd</code> and <code>/dev/dri/renderD*</code>, usually via the <code>render</code> and
            <code>video</code> groups.
          </p>
          <a href="/docs#quickstart" class="inline-block mt-6 text-sm text-ink underline decoration-line-strong hover:decoration-ink">
            Full quickstart and source builds
          </a>
        </div>

        <div class="lg:col-span-2 code-block self-start">
          <div class="code-block-header"><span>Quickstart</span><span>sh</span></div>
          <pre class="p-5 text-[13px] leading-relaxed text-ink overflow-x-auto"><span class="text-ink-3"># Download a target and its DFlash2 draft</span>
hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --local-dir models/Qwen3.8-27B-GGUF

<span class="text-ink-3"># Serve it with speculative decoding</span>
podman run --rm --userns=keep-id:uid=1000,gid=1000 \
  --device /dev/kfd --device /dev/dri --group-add keep-groups \
  --ulimit memlock=-1 -p 8080:8080 -v ./models:/models:ro \
  ghcr.io/gufo-org/toolboxes/gufo-runtime:latest \
  gufo serve --host 0.0.0.0 --port 8080 llm \
  --model /models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --speculative dflash2 --dflash-model /models/…-DFlash2-Q4_K_M.gguf</pre>
        </div>
      </div>
    </section>

    <!-- Models -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <p class="eyebrow mb-3">03 / Models</p>
            <h2 class="text-3xl text-ink">Supported models</h2>
            <p class="mt-3 text-[15px] text-ink-2 max-w-2xl leading-relaxed">
              Native implementations under <code>src/models/</code>, each owning its kernels, tests and numerical
              contracts.
            </p>
          </div>
          <a href="/benchmarks" class="text-sm text-ink underline decoration-line-strong hover:decoration-ink shrink-0">
            Benchmark tables
          </a>
        </div>

        <ModelMatrix />
      </div>
    </section>

    <!-- Containers -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid grid-cols-1 lg:grid-cols-3 gap-10 [&>*]:min-w-0">
        <div>
          <p class="eyebrow mb-3">04 / Containers</p>
          <h2 class="text-3xl text-ink">Docker and Podman images</h2>
          <p class="mt-5 text-[15px] text-ink-2 leading-relaxed">
            Reproducible Nix-built images for running and developing Gufo. They run as a dedicated non-root user with no
            sudo or PAM stack.
          </p>
          <a href="/docs#toolboxes" class="inline-block mt-6 text-sm text-ink underline decoration-line-strong hover:decoration-ink">
            Container run guide
          </a>
        </div>

        <div class="lg:col-span-2 divide-y divide-line border-y border-line">
          {images.map((img) => (
            <div class="py-6 space-y-3">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="font-mono text-sm text-ink">{img.name}</h3>
                <p class="text-sm text-ink-3">{img.body}</p>
              </div>
              <pre class="code-block px-4 py-3 text-[13px] text-ink overflow-x-auto">{img.command}</pre>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
