---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ModelMatrix from '../components/ModelMatrix.astro';

const principles = [
  { title: 'Fewer models, done well', body: 'The best model for each size, not every model.' },
  { title: 'Speed never costs quality', body: 'Every model has a quality report.' },
  { title: 'Measure the whole workload', body: 'A faster kernel that makes requests slower gets rejected.' },
  { title: 'Real workloads, reproducible builds', body: 'Several users and long conversations are the normal case.' },
];

const quickstart = `# Download a target and its DFlash2 draft
hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q8_K_XL.gguf \\
  --local-dir models/Qwen3.8-27B-GGUF
hf download z-lab/Qwen3.8-27B-DFlash2-GGUF Qwen3.8-27B-DFlash2-Q4_K_M.gguf \\
  --local-dir models/Qwen3.8-27B-DFlash2-GGUF

# Serve it with speculative decoding
podman run --rm --userns=keep-id:uid=1000,gid=1000 \\
  --device /dev/kfd --device /dev/dri --group-add keep-groups \\
  --ulimit memlock=-1 -p 8080:8080 -v ./models:/models:ro \\
  ghcr.io/gufo-org/toolboxes/gufo-runtime:latest \\
  gufo serve --host 0.0.0.0 --port 8080 llm \\
  --model /models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf \\
  --speculative dflash2 \\
  --dflash-model /models/Qwen3.8-27B-DFlash2-GGUF/Qwen3.8-27B-DFlash2-Q4_K_M.gguf`;
---

<Layout title="Gufo: the Strix Halo inference engine">
  <Navbar currentPath="/" />

  <main class="flex-1">
    <!-- Hero -->
    <header class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-20 sm:pt-28 sm:pb-24">
      <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] text-ink leading-[1.04] lg:whitespace-nowrap">
        The <em class="font-bold">Open Source</em> Strix Halo AI engine
      </h1>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/docs" class="inline-flex items-center h-11 px-5 rounded-full bg-forest text-ivory text-sm hover:bg-forest-dark transition-colors">
          Get started
        </a>
        <a
          href="/benchmarks"
          class="inline-flex items-center h-11 px-5 rounded-full border border-line-strong text-ink text-sm hover:bg-paper transition-colors"
        >
          See benchmarks
        </a>
      </div>
    </header>

    <!-- Principles -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div><p class="eyebrow mb-3">01 / Principles</p><h2 class="text-3xl text-ink">Why Gufo</h2></div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-12">
          <p class="sm:col-span-2 text-lg text-ink leading-relaxed">
            We were tired of owning hardware we couldn't fully use. So we built Gufo: an inference engine tuned end to
            end for Strix Halo, running only the best model in each class, with no performance left on the table.
          </p>
          {principles.map((p) => (
            <div>
              <h3 class="text-base font-semibold text-ink">{p.title}</h3>
              <p class="mt-3 text-[15px] text-ink-2 leading-relaxed">{p.body}</p>
            </div>
          ))}
          <p class="sm:col-span-2 text-[15px] text-ink-2 leading-relaxed">
            Contributions are welcome. Two community forks are worth a look: a
            <a href="https://github.com/pixmaate/gufo" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line-strong hover:decoration-ink">Windows port</a>
            and
            <a href="https://github.com/neuhaus/gufo" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line-strong hover:decoration-ink">Gufo RDMA</a>
            for two Strix Halos linked together.
          </p>
        </div>
      </div>
    </section>

    <!-- Quickstart -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid grid-cols-1 lg:grid-cols-3 gap-10 [&>*]:min-w-0">
        <div>
          <p class="eyebrow mb-3">02 / Quickstart</p>
          <h2 class="text-3xl text-ink">Serve in two steps</h2>
          <p class="mt-5 text-[15px] text-ink-2 leading-relaxed">
            Download the weights, then start the runtime image with access to the GPU. The server listens on port 8080
            and speaks the OpenAI API, so Open WebUI, Codex or any OpenAI SDK can use
            <code class="text-ink">localhost:8080/v1</code>.
          </p>
          <a href="/docs#quickstart" class="inline-block mt-6 text-sm text-ink underline decoration-line-strong hover:decoration-ink">
            Full quickstart, or build from source
          </a>
        </div>

        <div class="lg:col-span-2 code-block self-start">
          <div class="code-block-header"><span>Quickstart</span><span>sh</span></div>
          <Code code={quickstart} lang="sh" theme="github-light" class="p-5 text-[13px] leading-relaxed overflow-x-auto bg-transparent!" />
        </div>
      </div>
    </section>

    <!-- Models -->
    <section class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 space-y-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <p class="eyebrow mb-3">03 / Models</p>
            <h2 class="text-3xl text-ink">Supported models</h2>
            <p class="mt-3 text-[15px] text-ink-2 max-w-2xl leading-relaxed">
              Each model has its own implementation, kernels and tests under <code>src/models/</code>.
            </p>
          </div>
          <a href="/benchmarks" class="text-sm text-ink underline decoration-line-strong hover:decoration-ink shrink-0">
            Benchmark tables
          </a>
        </div>

        <ModelMatrix />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
