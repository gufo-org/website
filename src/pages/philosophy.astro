---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pillars = [
  {
    id: 'community',
    number: '01',
    title: 'Built with the community',
    subtitle: 'Contributions are welcome',
    content: [
      'Gufo needs the Strix Halo community to keep getting better. Outside changes go through the same measurements and review as ours.',
      'The goal is one place for local AI on this machine: text, audio, image and video models behind one server, instead of a text engine plus a separate Python stack for everything else.',
      'Every model ships with its benchmarks, a quality report and a log of what we tried, so you can check a change yourself.',
    ],
  },
  {
    id: 'single-target',
    number: '02',
    title: 'One machine',
    subtitle: 'Strix Halo with 128 GiB of memory is the design point',
    content: [
      'Engines that run on CUDA, Metal and CPU at the same time pay for it with extra layers and compromises. Gufo only targets Linux on Strix Halo, and the HIP backend refuses any GPU other than gfx1151.',
      'Machines with less memory still work for the models that fit. The 128 GiB of unified memory is what lets a 27B dense model, an 80 GiB mixture-of-experts model and the audio models share one desktop.',
    ],
  },
  {
    id: 'curation',
    number: '03',
    title: 'Fewer models, done well',
    subtitle: 'The best model for each size, not every model',
    content: [
      'We support the best models that fit on this hardware. Fewer models means less code to maintain and more time to optimize and test each one.',
      "Each model lives in its own folder with its own loader, kernels, tests and CPU reference. Kernels aren't shared between models, so a change to one can't break another.",
    ],
  },
  {
    id: 'quality',
    number: '04',
    title: 'Speed never costs quality',
    subtitle: 'Every model has a quality report',
    content: [
      "The report compares Gufo with an independent implementation, position by position on the same input tokens, and lists the gaps we haven't closed yet.",
      "Greedy speculative decoding has to match normal decoding exactly. Numbers we haven't measured stay marked TODO, and a skipped test never counts as a pass.",
    ],
  },
  {
    id: 'measurement',
    number: '05',
    title: 'Measure the whole workload',
    subtitle: 'A faster kernel that makes requests slower gets rejected',
    content: [
      'We measure the complete request, find what actually limits it, then change one thing at a time against a trusted reference.',
      'Runs are only compared when everything else matches: source revision, weights, prompt, context depth, concurrency, driver and ROCm version. Headline numbers come from runs without the profiler attached.',
      "When an optimization wins, it becomes the default. There's no flag to turn it on.",
    ],
  },
  {
    id: 'operations',
    number: '06',
    title: 'Real workloads, reproducible builds',
    subtitle: 'Several users and long conversations are the normal case',
    content: [
      'Concurrent requests, cancellation and conversation caching get benchmarked like everything else.',
      'The production build stays small: no tests, profilers or Python, and Python is never needed to serve a request. Nix pins the whole toolchain so results can be reproduced, and the container images run as a normal user.',
    ],
  },
];
---

<Layout title="Philosophy · Gufo">
  <Navbar currentPath="/philosophy" />

  <main class="flex-1">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-24">
      <header class="pb-12 border-b border-line">
        <p class="eyebrow mb-5">Philosophy</p>
        <h1 class="text-4xl sm:text-6xl text-ink leading-[1.08]">Small on purpose</h1>
        <p class="mt-8 font-serif text-xl text-ink-2 leading-relaxed">
          Gufo supports one machine and a short list of models. That focus is what makes it fast, and the rules below
          keep it honest.
        </p>
        <p class="mt-6 text-sm text-ink-3">
          Based on the repository's <code>README.md</code>, <code>docs/PERFORMANCE.md</code> and
          <code>docs/BENCHMARKS.md</code>.
        </p>
      </header>

      <nav class="py-10 border-b border-line" aria-label="Principles">
        <ol class="space-y-2 text-[15px]">
          {pillars.map((p) => (
            <li class="flex gap-4">
              <span class="font-mono text-sm text-ink-4 pt-0.5">{p.number}</span>
              <a href={`#${p.id}`} class="text-ink-2 hover:text-ink underline decoration-transparent hover:decoration-line-strong">
                {p.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {pillars.map((p) => (
        <section id={p.id} class="pt-14 scroll-mt-20">
          <p class="eyebrow">{p.number} / Principle</p>
          <h2 class="mt-2 text-3xl text-ink leading-tight">{p.title}</h2>
          <p class="mt-3 text-ink-3">{p.subtitle}</p>
          <div class="mt-6 space-y-5 font-serif text-[19px] text-ink-2 leading-[1.7]">
            {p.content.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      ))}

      <section class="mt-16 pt-10 border-t border-line">
        <h2 class="text-2xl text-ink">In short</h2>
        <ul class="mt-6 space-y-3 text-[15px] text-ink-2 leading-relaxed">
          <li><span class="text-ink font-medium">One platform:</span> Linux on AMD Strix Halo (<code>gfx1151</code>).</li>
          <li><span class="text-ink font-medium">Few models:</span> the best one for each size, each with its own code.</li>
          <li><span class="text-ink font-medium">Real numbers:</span> every benchmark has a date and settings; missing ones say TODO.</li>
          <li><span class="text-ink font-medium">Quality first:</span> an optimization that fails a model's numerical checks doesn't ship.</li>
          <li><span class="text-ink font-medium">Reproducible:</span> Nix pins the toolchain and the images run as a normal user.</li>
        </ul>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
