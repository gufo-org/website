---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout title="Behind Gufo" description="How Gufo works and why it works that way: engineering posts, measurements and design decisions.">
  <Navbar currentPath="/blog" />
  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-24">
      <header class="pb-12 border-b border-line">
        <p class="eyebrow mb-5">Blog</p>
        <h1 class="text-4xl sm:text-6xl text-ink leading-[1.08]">Behind Gufo</h1>
        <p class="mt-8 font-serif text-xl text-ink-2 leading-relaxed">How Gufo works and why it works that way.</p>
      </header>

      {posts.length === 0 && <p class="py-10 text-ink-3">Coming soon.</p>}

      <ol class="divide-y divide-line">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-6 py-10">
              <div class="font-mono text-xs text-ink-4 pt-1.5 space-y-1">
                <time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time>
                <p class="text-ink-3">{post.data.kind}</p>
              </div>
              <div>
                <h2 class="text-2xl sm:text-3xl text-ink leading-tight group-hover:text-forest transition-colors">{post.data.title}</h2>
                <p class="mt-3 text-ink-3 leading-relaxed">{post.data.summary}</p>
                {post.data.tags.length > 0 && (
                  <p class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => <span class="text-[11px] text-ink-3 border border-line-strong rounded-full px-2.5 py-0.5">{tag}</span>)}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer />
</Layout>
