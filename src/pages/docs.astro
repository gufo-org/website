---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { catalogue } from '../data/models';

const nav = [
  {
    group: 'Getting started',
    items: [
      { id: 'quickstart', label: 'Quickstart with containers' },
      { id: 'platform', label: 'Supported platform' },
      { id: 'build', label: 'Build from source' },
    ],
  },
  {
    group: 'Using Gufo',
    items: [
      { id: 'cli', label: 'CLI commands' },
      { id: 'models', label: 'Model guides' },
      { id: 'api', label: 'OpenAI-compatible API' },
      { id: 'clients', label: 'Clients and UIs' },
    ],
  },
  {
    group: 'How it works',
    items: [
      { id: 'speculative', label: 'Speculative decoding' },
      { id: 'serving', label: 'Concurrent serving' },
      { id: 'queues', label: 'Compute queue budget' },
    ],
  },
  {
    group: 'Development',
    items: [
      { id: 'presets', label: 'CMake presets and options' },
      { id: 'workflow', label: 'Development loop' },
      { id: 'profiling', label: 'Profiling and benchmarking' },
    ],
  },
  {
    group: 'Deployment',
    items: [
      { id: 'toolboxes', label: 'OCI images' },
      { id: 'nix-serve', label: 'Nix serve helper' },
    ],
  },
];

const dependencies = [
  ['ROCm HIP compiler/runtime, hipBLAS, hipBLASLt, rocBLAS', 'GPU execution and matrix multiplication'],
  ['hipCUB, rocPRIM, rocWMMA headers', 'Compiled GPU kernels'],
  ['ICU, libcurl, OpenSSL, libpng, libjpeg', 'Tokenization, HTTPS, hashing and images'],
  ['FFmpeg and ffprobe', 'Video/audio output; invoked as separate executables'],
];

const presets = [
  ['release', 'RelWithDebInfo', 'Production inference with HIP; no tests, no tools'],
  ['gpu-test', 'RelWithDebInfo + assertions', 'HIP, tests and development tools'],
  ['cpu-test', 'RelWithDebInfo', 'Host-only tests, no HIP'],
  ['cpu-sanitizer', 'Debug + ASan/UBSan', 'Host memory and undefined-behavior diagnostics'],
];

const options = [
  ['ENGINE_ENABLE_HIP', 'ON', 'Build the gfx1151 HIP backend; only gfx1151 is accepted'],
  ['BUILD_TESTING', 'OFF', 'Build correctness tests'],
  ['GUFO_BUILD_TOOLS', 'OFF', 'Build kernel benchmarks and tuning executables'],
  ['GUFO_ENABLE_WARNINGS', 'ON', 'Compiler warnings'],
  ['GUFO_ENABLE_SANITIZERS', 'OFF', 'AddressSanitizer and UndefinedBehaviorSanitizer'],
];

const endpoints = [
  ['POST', '/v1/chat/completions', 'Main chat API: streaming, images, tools'],
  ['POST', '/v1/responses', 'Text and image input, structured output, optional SSE'],
  ['POST', '/v1/completions', 'Optional legacy text completion adapter'],
  ['GET', '/v1/models', 'Loaded model aliases and capabilities'],
  ['POST', '/v1/audio/transcriptions', 'When an STT implementation is loaded'],
  ['POST', '/v1/audio/speech', 'When a TTS implementation is loaded'],
  ['POST', '/v1/images/generations', 'When Qwen-Image-2.1 serving is configured'],
  ['POST', '/v1/images/edits', 'When Qwen-Image-2.1 serving is configured'],
  ['POST', '/v1/videos', 'When a validated MiniMax H3 checkpoint is configured'],
  ['GET', '/health · /ready · /metrics', 'Liveness, readiness, Prometheus metrics (text serving)'],
];

const speculative = [
  {
    mode: 'DFlash2',
    model: 'Qwen3.8 27B',
    flag: '--speculative dflash2 --dflash-model PATH',
    body:
      'Adaptive block-length policy by default; --draft-tokens caps proposals and --draft-policy fixed is a comparison mode. The Q4_K_M draft serves both the Q4 and Q8 targets.',
  },
  {
    mode: 'MTP',
    model: 'Qwen3.8 Flash-Next',
    flag: '--speculative mtp --mtp-model PATH',
    body:
      'Shared-Q8_0 predictor sidecar with adaptive drafting of one to seven tokens. Sampled requests use deterministic acceptance and cost control so seeded replay reproduces.',
  },
  {
    mode: 'DSpark',
    model: 'DeepSeek V4 Flash',
    flag: '--dspark-model PATH',
    body:
      'Verifies proposals against the target, commits only accepted prefixes, and keeps sampling and controller state private per request. The support model is optional.',
  },
];

const commands = [
  ['gufo serve', 'Starts the OpenAI-compatible server for the modality you name: llm, tts, asr, image or video.'],
  ['gufo chat', 'Maintains an interactive conversation, loading the runtime directly or connecting to a running server.'],
  ['gufo prompt', 'Executes one request and exits. Useful for scripted and piped generation.'],
  ['gufo bench', 'Measures model execution directly, greedy by default.'],
  ['gufo transcribe', 'Runs native Qwen3-ASR-1.7B speech recognition from the terminal.'],
  ['gufo video', 'Runs MiniMax H3 generation.'],
  ['gufo diagnose', 'Non-interactive system and hardware diagnostics: drivers, groups, permissions.'],
];
---

<Layout title="Documentation · Gufo">
  <Navbar currentPath="/docs" />

  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      <!-- Sidebar -->
      <!-- On small screens the section list folds into a dropdown above the content -->
      <details class="lg:hidden border-y border-line text-sm">
        <summary class="cursor-pointer py-3 text-ink-2 select-none">On this page</summary>
        <div class="pb-4 space-y-4">
          {nav.map((section) => (
            <div>
              <div class="text-xs mb-1 text-ink-4">{section.group}</div>
              <ul>
                {section.items.map((item) => (
                  <li><a href={`#${item.id}`} class="block py-1.5 text-ink-2 hover:text-ink">{item.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <aside class="hidden lg:block lg:col-span-1 min-w-0 border-r border-line pr-4 space-y-6 text-sm sticky top-24">
        {nav.map((section) => (
          <div>
            <div class="text-xs mb-2 text-ink-4">{section.group}</div>
            <ul class="space-y-1">
              {section.items.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc={item.id}
                    class="block px-2.5 py-1.5 rounded text-ink-2 hover:text-ink hover:bg-paper-2 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="p-3 bg-paper rounded border border-line text-xs space-y-1.5">
          <div class="text-ink font-semibold font-mono">Canonical docs</div>
          <p class="text-ink-3 leading-relaxed">
            This page summarizes the repository's own documents. Flags are intentionally not enumerated here. Use
            <code class="text-ink">--help</code> so nothing drifts from the implementation.
          </p>
        </div>
      </aside>

      <!-- Content -->
      <main class="lg:col-span-3 min-w-0 space-y-12">
        <div class="flex items-center gap-2 text-xs text-ink-3">
          <a href="/" class="hover:text-ink">Home</a>
          <span>/</span>
          <span class="text-ink">Documentation</span>
          <span>/</span>
          <span class="text-ink font-semibold">User and developer guide</span>
        </div>

        <!-- Quickstart -->
        <section id="quickstart" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h1 class="text-4xl sm:text-5xl text-ink">Quickstart</h1>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The fastest path is the published runtime image. Download weights, start the server, then call it with any
            OpenAI-compatible client.
          </p>

          <div class="code-block">
            <div class="code-block-header"><span>Download weights</span><span>sh</span></div>
            <pre><code>hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --revision 4ca720788d1e01f1bff70c033e0d0028fd02e502 \
  --repo-type model --local-dir models/Qwen3.8-27B-GGUF

hf download z-lab/Qwen3.8-27B-DFlash2-GGUF Qwen3.8-27B-DFlash2-Q4_K_M.gguf \
  --revision 2d9571f8ce46e151f61c6499c99dee6079e1d610 \
  --repo-type model --local-dir models/Qwen3.8-27B-DFlash2-GGUF</code></pre>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Serve with DFlash2 speculative decoding</span><span>sh</span></div>
            <pre><code>podman pull ghcr.io/gufo-org/toolboxes/gufo-runtime:latest

podman run --rm \
  --userns=keep-id:uid=1000,gid=1000 \
  --device /dev/kfd --device /dev/dri \
  --group-add keep-groups --ulimit memlock=-1 \
  -p 8080:8080 -v ./models:/models:ro \
  ghcr.io/gufo-org/toolboxes/gufo-runtime:latest \
  gufo serve --host 0.0.0.0 --port 8080 llm \
  --model /models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --speculative dflash2 \
  --dflash-model /models/Qwen3.8-27B-DFlash2-GGUF/Qwen3.8-27B-DFlash2-Q4_K_M.gguf</code></pre>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Ask it something</span><span>sh</span></div>
            <pre><code>curl http://localhost:8080/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '&#123;"model": "Qwen3.8-27B-UD-Q8_K_XL",
      "messages": [&#123;"role": "user", "content": "Say something"&#125;]&#125;'</code></pre>
          </div>

          <div class="admonition admonition-important">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>GPU access for rootless containers</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Rootless Podman needs <code class="text-ink font-mono">crun</code> for
              <code class="text-ink font-mono">--group-add keep-groups</code>. Your host user must have read/write
              access to <code class="text-ink">/dev/kfd</code> and <code class="text-ink">/dev/dri/renderD*</code>,
              usually through the <code class="text-ink">render</code> and <code class="text-ink">video</code>
              groups; log out and back in after changing membership. Container groups named
              <code class="text-ink">video</code>/<code class="text-ink">render</code> do not preserve host
              supplementary groups. If ROCm reports no device, check <code class="text-ink">id</code>,
              <code class="text-ink">ls -l /dev/kfd /dev/dri/renderD*</code> and
              <code class="text-ink">podman info --format '&#123;&#123;.Host.OCIRuntime.Name&#125;&#125;'</code>.
            </p>
          </div>

          <div class="admonition admonition-info">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>SELinux hosts</span>
            </div>
            <div class="text-[15px] text-ink-2 leading-relaxed space-y-2">
              <p>
                On Fedora or another SELinux-enforcing host, GPU enumeration can succeed while SELinux blocks mapping
                <code class="text-ink">/dev/kfd</code>, which ROCr reports as a misleading “Memory critical” error.
                Check the host audit log:
              </p>
              <div class="bg-ivory p-2 rounded font-mono text-[11px] text-ink">
                sudo ausearch -m avc -ts recent | grep -E '/dev/kfd|hsa_device_t'
              </div>
              <p>
                If it shows a denied <code class="text-ink">map</code>, the documented fix is
                <code class="text-ink">sudo setsebool -P container_use_devices true</code>. It affects every
                container on that host, so review the policy scope before enabling it.
              </p>
            </div>
          </div>
        </section>

        <!-- Platform -->
        <section id="platform" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Supported platform</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Linux x86-64 on AMD Strix Halo (<code class="text-ink font-mono">gfx1151</code>) is the supported
            production target: Ryzen AI MAX+ 395 systems with Radeon 8060S and up to 128 GiB of unified memory. The HIP
            backend accepts that architecture only. Tests, profilers, tuning executables and Python reference runners are
            not installed with the production package.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-3.5 rounded bg-paper border border-line space-y-1.5 font-mono">
              <div class="text-ink font-semibold">Runtime</div>
              <div>GPU target: <span class="text-ink">gfx1151 (RDNA 3.5)</span></div>
              <div>Wavefront: <span class="text-ink-2">Wave32</span></div>
              <div>Memory: <span class="text-ink-2">unified LPDDR5X, CPU and GPU</span></div>
              <div>Devices: <span class="text-ink-2">/dev/kfd, /dev/dri</span></div>
            </div>
            <div class="p-3.5 rounded bg-paper border border-line space-y-1.5 font-mono">
              <div class="text-ink font-semibold">Qualified toolchain</div>
              <div>Compiler: <span class="text-ink">GCC 15.3, C++20</span></div>
              <div>ROCm: <span class="text-ink-2">7.2.3</span></div>
              <div>Build: <span class="text-ink-2">CMake 3.21+, Ninja, pkg-config</span></div>
              <div>Not required: <span class="text-ink-2">Python, Triton, CK, MIOpen</span></div>
            </div>
          </div>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Probes, not spec sheets</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Runtime probes determine the available compute units, memory, firmware and power mode. Performance claims
              come from measured hardware ceilings produced by <code class="text-ink">tools/bench/gfx1151_peak.hip</code>,
              not from published peak specifications. Smaller memory configurations still work and keep the speed
              benefits for models that fit; Windows, macOS and non-AMD accelerators are out of scope.
            </p>
          </div>
        </section>

        <!-- Build -->
        <section id="build" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Build from source</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            CMake owns one production configuration for both Nix and ordinary Linux builds. No wrapper script is needed.
          </p>

          <div class="code-block">
            <div class="code-block-header"><span>With Nix</span><span>sh</span></div>
            <pre><code><span class="code-comment"># Production package, no tests or tools</span>
nix build
./result/bin/gufo diagnose
./result/bin/gufo serve llm --model /path/to/model.gguf

<span class="code-comment"># Hosted CPU and repository checks</span>
nix build .#checks.x86_64-linux.pr

<span class="code-comment"># GPU development, profilers, reference tools</span>
nix develop</code></pre>
          </div>

          <div class="admonition admonition-important">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Stage new files before building</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Flakes only see tracked files, so run <code class="text-ink font-mono">git add</code> on new paths
              before <code class="text-ink font-mono">nix build</code>. Stage only the paths your task owns.
            </p>
          </div>

          <h3 class="text-sm font-semibold text-ink pt-2">Without Nix</h3>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Install a C++20 compiler, CMake 3.21+, Ninja, pkg-config and the development packages below. Attention and
            audio convolution kernels compile directly from HIP.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Dependency</th>
                  <th class="px-4 py-2.5">Used for</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {dependencies.map(([dep, use]) => (
                  <tr>
                    <td class="px-4 py-2.5 font-mono text-ink">{dep}</td>
                    <td class="px-4 py-2.5">{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Debian / Ubuntu example</span><span>sh</span></div>
            <pre><code>sudo apt install build-essential cmake ninja-build pkg-config \
  libicu-dev libcurl4-openssl-dev libssl-dev libpng-dev libjpeg-dev ffmpeg

sudo apt install hipblas-dev hipblaslt-dev rocblas-dev \
  hipcub-dev rocprim-dev rocwmma-dev

cmake --preset release -DCMAKE_INSTALL_PREFIX="$HOME/.local"
cmake --build --preset release --parallel 4
./build/release/gufo diagnose</code></pre>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Configuring fails at <code class="text-ink-2">find_package(hipblas)</code> when those ROCm packages are
            missing; other distributions name them <code class="text-ink-2">-devel</code>. For nonstandard
            installations pass <code class="text-ink-2">-DCMAKE_PREFIX_PATH="/opt/rocm"</code>, and if compiler
            discovery picks a system Clang also pass
            <code class="text-ink-2">-DCMAKE_HIP_COMPILER=/opt/rocm/llvm/bin/clang++</code>. Install with
            <code class="text-ink-2">cmake --install build/release</code>; model weights are acquired separately.
          </p>
        </section>

        <!-- CLI -->
        <section id="cli" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">CLI commands</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Terminal generation and HTTP serving share model runtimes, tokenizers and sampling; the HTTP scheduler adds
            concurrent request management and persistent prompt caching. Every command supports
            <code class="text-ink font-mono">--help</code> and <code class="text-ink font-mono">--version</code>,
            and unknown options or invalid combinations return an error instead of being ignored.
          </p>

          <div class="space-y-2">
            {commands.map(([name, body]) => (
              <div class="p-4 rounded-lg bg-paper border border-line space-y-1">
                <h3 class="font-semibold text-ink font-mono text-sm">{name}</h3>
                <p class="text-[15px] text-ink-2 leading-relaxed">{body}</p>
              </div>
            ))}
          </div>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Flags live in --help, not here</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              The repository deliberately does not document the feature-to-flag mapping, so it cannot drift from the
              implementation. Run <code class="text-ink font-mono">gufo serve --help</code> or
              <code class="text-ink font-mono">gufo serve llm --help</code> for the current options. Broadly, the
              LLM server exposes model identity, context and memory sizing, the full sampling set, reasoning controls, an
              optional on-disk prompt cache, speculative decoding, and per-client limits for queueing, timeouts and
              output size.
            </p>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Audio serving</span><span>sh</span></div>
            <pre><code><span class="code-comment"># Synthesis, with two named reference voices</span>
gufo serve tts --model models/Qwen3-TTS-12Hz-1.7B-Base --context 4096 \
  --voice narrator_eng=/audio/clear-english-voice.wav \
  --voice-text narrator_eng=/audio/clear-english-voice.txt

<span class="code-comment"># Transcription</span>
gufo serve asr --model models/Qwen3-ASR-1.7B --context 1024</code></pre>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Each process loads one checkpoint; llama-swap can route several services under one API URL.
            <code class="text-ink-2">--context</code> reserves the model's token capacity, and ASR applies that
            capacity per audio chunk, so long recordings do not need one enormous context.
          </p>
        </section>

        <!-- Models -->
        <section id="models" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Model guides</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Weights are downloaded separately and are not part of the runtime package. Each model guide lists the
            required files, supported modes and complete benchmark settings.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Model</th>
                  <th class="px-4 py-2.5">Weights and inputs</th>
                  <th class="px-4 py-2.5">Modes</th>
                  <th class="px-4 py-2.5 font-mono">Guide</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {catalogue.map((m) => (
                  <tr class="align-top">
                    <td class="px-4 py-2.5 font-semibold text-ink whitespace-nowrap">{m.name}</td>
                    <td class="px-4 py-2.5">{m.weights}</td>
                    <td class="px-4 py-2.5 text-sky-700 whitespace-nowrap">{m.modes}</td>
                    <td class="px-4 py-2.5 font-mono text-[11px] text-ink-3">{m.docPath}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Model-owned packages</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Each family lives in <code class="text-ink-2">src/models/&lt;model&gt;</code> as its own static
                library with its own config, loader, engine, kernels and CPU reference. Kernels are not reused across
                models, which bounds the blast radius of a change. Tests sit in
                <code class="text-ink-2">tests/models/&lt;model&gt;</code>.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Four documents per model</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                <code class="text-ink-2">README.md</code> for usage and modes,
                <code class="text-ink-2">BENCHMARKS.md</code> for retained measurements with scope and date,
                <code class="text-ink-2">QUALITY.md</code> for measured quality and unresolved gaps, and
                <code class="text-ink-2">EXPERIMENTS.md</code> for retained and rejected decisions.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Qwen-Image-2.1 weights use the non-commercial Qwen Research License and MiniMax H3 requires an
            operator-supplied checkpoint under its own community license; both are separate from Gufo's MIT license, and
            neither is downloaded during build, installation or server startup.
          </p>
        </section>

        <!-- API -->
        <section id="api" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">OpenAI-compatible API</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Chat Completions is the main API, with streaming, images and tools. Responses supports text and image input
            with optional streaming, and Anthropic Messages exposes a synchronous text subset. Compatibility is a
            versioned contract: supported fields behave as documented and unsupported fields return explicit errors
            instead of being ignored.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Method</th>
                  <th class="px-4 py-2.5">Path</th>
                  <th class="px-4 py-2.5 font-sans">Availability</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {endpoints.map(([method, path, note]) => (
                  <tr class="hover:bg-paper-2 transition-colors">
                    <td class="px-4 py-2.5 text-ink font-semibold whitespace-nowrap">{method}</td>
                    <td class="px-4 py-2.5 text-ink whitespace-nowrap">{path}</td>
                    <td class="px-4 py-2.5 text-ink-3 font-sans">{note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            <code class="text-ink-2">/v1/embeddings</code> is not implemented and returns 501. JSON parsing rejects
            duplicate keys, invalid numbers and nesting beyond 128 containers. Diagnostic telemetry carries status, token
            counts, timing and cancellation state only, never prompt text, model paths or token IDs.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="code-block">
              <div class="code-block-header"><span>Chat completion</span><span>sh</span></div>
              <pre><code>curl http://localhost:8080/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '&#123;"model": "qwen", "stream": true,
      "reasoning_effort": "high",
      "messages": [&#123;"role": "user", "content": "Hi"&#125;]&#125;'</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Speech synthesis</span><span>sh</span></div>
              <pre><code>curl -sS http://127.0.0.1:8080/v1/audio/speech \
  -H 'Content-Type: application/json' \
  -d '&#123;"model": "qwen3-tts-12hz-1.7b-base",
      "voice": "narrator", "input": "Hello from Gufo."&#125;' \
  --output speech.wav</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Transcription</span><span>sh</span></div>
              <pre><code>curl -sS http://127.0.0.1:8080/v1/audio/transcriptions \
  -F file=@speech.wav -F model=qwen3-asr-1.7b \
  -F response_format=json</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Image generation</span><span>sh</span></div>
              <pre><code>curl --fail-with-body http://127.0.0.1:8080/v1/images/generations \
  -H 'Content-Type: application/json' \
  -d '&#123;"model": "Qwen-Image-2.1", "prompt": "A red ceramic teapot",
      "size": "1024x1024", "seed": 42&#125;' &gt; response.json</code></pre>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Text serving defaults match llama.cpp: <code class="text-ink-2">--context 0</code> takes the model's
            native context from metadata and <code class="text-ink-2">--max-tokens -1</code> generates until EOS or
            the context is exhausted. Reasoning tokens count toward a response limit, and a response can never exceed the
            remaining context. Exhaustion reports <code class="text-ink-2">length</code> or
            <code class="text-ink-2">incomplete</code> without discarding earlier conversation tokens.
          </p>
        </section>

        <!-- Clients -->
        <section id="clients" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Clients and UIs</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            For Open WebUI, VS Code and OpenAI SDK clients, set the API base URL to
            <code class="text-ink font-mono">http://localhost:8080/v1</code>.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="space-y-2">
              <h3 class="font-semibold text-ink text-sm">Python, openai SDK</h3>
              <div class="code-block">
                <div class="code-block-header"><span>example.py</span><span>python</span></div>
                <pre><code>from openai import OpenAI
client = OpenAI(
  base_url="http://localhost:8080/v1",
  api_key="not-needed",
)
stream = client.responses.create(
  model="qwen", input="Hello", store=False, stream=True
)</code></pre>
              </div>
            </div>

            <div class="space-y-2">
              <h3 class="font-semibold text-ink text-sm">Open WebUI and other frontends</h3>
              <div class="p-4 rounded-lg bg-paper border border-line text-[15px] text-ink-2 leading-relaxed space-y-2">
                <p>
                  Point the frontend's OpenAI-compatible endpoint at <code class="text-ink">http://&lt;host&gt;:8080/v1</code>.
                  Serve with <code class="text-ink">--host 0.0.0.0</code> when running inside a container, or the
                  published port will not answer.
                </p>
                <p>
                  Set <code class="text-ink">--api-key</code> to require
                  <code class="text-ink">Authorization: Bearer &lt;key&gt;</code> on every request, including health
                  checks. Browser CORS preflight stays unauthenticated.
                </p>
                <p>
                  <code class="text-ink">--served-model-name</code> chooses the name reported in
                  <code class="text-ink">/v1/models</code>, which is what a client's <code class="text-ink">model</code>
                  field should say. It is cosmetic and does not change which weights are loaded.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Speculative decoding -->
        <section id="speculative" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Speculative decoding</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            A draft model proposes tokens for the target model to verify. Greedy decoding must reproduce the target's
            tokens; sampled decoding must preserve the target's distribution, though it need not match an autoregressive
            run's sequence for the same seed. Speed depends on acceptance and verification cost.
          </p>

          <div class="space-y-3">
            {speculative.map((s) => (
              <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-semibold text-ink text-sm">
                    {s.mode} <span class="text-ink-3 font-normal text-xs">· {s.model}</span>
                  </h3>
                  <code class="text-[11px] px-2 py-0.5 rounded bg-ivory border border-line-strong text-ink font-mono">
                    {s.flag}
                  </code>
                </div>
                <p class="text-[15px] text-ink-2 leading-relaxed">{s.body}</p>
              </div>
            ))}
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            HTTP serving supports <code class="text-ink-2">dflash2</code>, <code class="text-ink-2">dspark</code>
            and Flash-Next <code class="text-ink-2">mtp</code>. All three require a minimum draft length of one.
            Per-model measured gains are on the <a href="/benchmarks" class="text-ink font-semibold hover:underline">benchmarks page</a>.
          </p>
        </section>

        <!-- Concurrent serving -->
        <section id="serving" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Concurrent serving and caching</h2>
          <a href="/cache" class="block p-4 rounded-lg border border-line-strong bg-paper text-sm text-ink hover:bg-paper transition-colors">Explore the cache interactively → <span class="text-ink-3">Follow live sessions, checkpoint restores, shared KV and disk persistence.</span></a>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            HTTP requests share one immutable model containing the mapped weights and tokenizer. Each request leases a
            preallocated executor with independent KV, recurrent, graph, activation and logit state, from a bounded pool
            sized by <code class="text-ink font-mono">--sessions N</code>. The scheduler batches ready requests
            when the model runner supports their execution mode, and socket closure propagates cancellation into it.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Prompt caching</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Computed prompt state is reused across requests, and optionally across restarts with
                <code class="text-ink-2">--cache-disk</code>, bounded by explicit byte budgets for the cache and its
                write staging area.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Client limits</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Pending-request caps overall and per client, request timeouts, maximum output bytes, and buffered-output
                budgets per request and in total, so one slow client cannot exhaust memory.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Reasoning controls</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Thinking on, off or model default, with effort from <code class="text-ink-2">minimal</code> to
                <code class="text-ink-2">max</code> and a policy for preserving earlier turns' reasoning. Conflicting
                controls return an error rather than a guess.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Sampling follows each model's officially recommended defaults. Explicit request values override explicit
            server options; null request values inherit where supported, and explicit zeros are preserved. Use
            <code class="text-ink-2">--temperature 0</code> or <code class="text-ink-2">"temperature": 0</code>
            for greedy output.
          </p>
        </section>

        <!-- Queue budget -->
        <section id="queues" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Hardware compute queue budget</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The <code class="text-ink font-mono">gfx1151</code> command processor keeps eight compute queues mapped
            at once, counted across every process on the device. Past that total the firmware scheduler time-slices them
            even when they are empty: the GPU then reports a busy engine at its top shader clock and draws about 26 W
            above idle for as long as the processes live. Queues are claimed on a process's first HIP dispatch and never
            released, so four HIP processes is the ceiling on one device.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Server</th>
                  <th class="px-4 py-2.5 text-right">GPU_MAX_HW_QUEUES</th>
                  <th class="px-4 py-2.5 text-right">Resident compute queues</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                <tr><td class="px-4 py-2.5 text-ink">serve llm</td><td class="px-4 py-2.5 text-right">2</td><td class="px-4 py-2.5 text-right">3</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve tts</td><td class="px-4 py-2.5 text-right">1</td><td class="px-4 py-2.5 text-right">2</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve asr</td><td class="px-4 py-2.5 text-right">1</td><td class="px-4 py-2.5 text-right">2</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve image, serve video</td><td class="px-4 py-2.5 text-right">runtime default</td><td class="px-4 py-2.5 text-right">up to 5</td></tr>
              </tbody>
            </table>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Each server reads the queues already in use from the kernel driver, exports its cap before loading a model
            and logs a <code class="text-ink-2">queue_budget</code> event. The cap is only lowered to fit free slots,
            never raised to fill them, so throughput does not depend on server start order. Text and audio caps are
            measured to cost no throughput. An operator-set value is honoured and still reported if it will not fit.
          </p>
        </section>

        <!-- Presets -->
        <section id="presets" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">CMake presets and options</h2>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Configure preset</th>
