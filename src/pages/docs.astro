---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { catalogue } from '../data/models';

const nav = [
  {
    group: 'Getting started',
    items: [
      { id: 'quickstart', label: 'Quickstart with containers' },
      { id: 'platform', label: 'Supported platform' },
      { id: 'build', label: 'Build from source' },
    ],
  },
  {
    group: 'Using Gufo',
    items: [
      { id: 'cli', label: 'CLI commands' },
      { id: 'models', label: 'Model guides' },
      { id: 'api', label: 'API' },
      { id: 'clients', label: 'Clients and UIs' },
    ],
  },
  {
    group: 'How it works',
    items: [
      { id: 'speculative', label: 'Speculative decoding' },
      { id: 'serving', label: 'Serving and caching' },
      { id: 'queues', label: 'GPU queue limit' },
    ],
  },
  {
    group: 'Development',
    items: [
      { id: 'presets', label: 'CMake presets and options' },
      { id: 'workflow', label: 'Development loop' },
      { id: 'profiling', label: 'Profiling and benchmarking' },
    ],
  },
  {
    group: 'Deployment',
    items: [
      { id: 'toolboxes', label: 'OCI images' },
      { id: 'nix-serve', label: 'Nix serve helper' },
    ],
  },
];

const dependencies = [
  ['ROCm HIP compiler/runtime, hipBLAS, hipBLASLt, rocBLAS', 'GPU execution and matrix multiplication'],
  ['hipCUB, rocPRIM, rocWMMA headers', 'Compiled GPU kernels'],
  ['ICU, libcurl, OpenSSL, libpng, libjpeg', 'Tokenizers, HTTPS, hashing and images'],
  ['FFmpeg and ffprobe', 'Video and audio output, called as separate programs'],
];

const presets = [
  ['release', 'RelWithDebInfo', 'Production inference with HIP; no tests, no tools'],
  ['gpu-test', 'RelWithDebInfo + assertions', 'HIP, tests and development tools'],
  ['cpu-test', 'RelWithDebInfo', 'Host-only tests, no HIP'],
  ['cpu-sanitizer', 'Debug + ASan/UBSan', 'Host memory and undefined-behavior diagnostics'],
];

const options = [
  ['ENGINE_ENABLE_HIP', 'ON', 'Build the HIP backend (gfx1151 only)'],
  ['BUILD_TESTING', 'OFF', 'Build correctness tests'],
  ['GUFO_BUILD_TOOLS', 'OFF', 'Build kernel benchmarks and tuning executables'],
  ['GUFO_ENABLE_WARNINGS', 'ON', 'Compiler warnings'],
  ['GUFO_ENABLE_SANITIZERS', 'OFF', 'AddressSanitizer and UndefinedBehaviorSanitizer'],
];

const endpoints = [
  ['POST', '/v1/chat/completions', 'Main chat API: streaming, images, tools'],
  ['POST', '/v1/responses', 'Text, images, function tools, structured output, optional streaming'],
  ['POST', '/v1/messages', 'Anthropic Messages: text, thinking and tools, optional streaming'],
  ['POST', '/v1/completions', 'Legacy text completions'],
  ['GET', '/v1/models', 'Loaded models and what they support'],
  ['POST', '/v1/audio/transcriptions', 'With gufo serve asr'],
  ['POST', '/v1/audio/speech', 'With gufo serve tts'],
  ['POST', '/v1/images/generations', 'With gufo serve image'],
  ['POST', '/v1/images/edits', 'With gufo serve image'],
  ['POST', '/v1/videos', 'With gufo serve video and a MiniMax H3 checkpoint'],
  ['GET', '/health · /ready · /metrics', 'Health checks and Prometheus metrics'],
];

const speculative = [
  {
    mode: 'DFlash2',
    model: 'Qwen3.8 27B',
    flag: '--speculative dflash2 --dflash-model PATH',
    body:
      'Picks how many tokens to draft on the fly. --draft-tokens sets a cap. The same Q4_K_M draft works with both the Q4 and Q8 models.',
  },
  {
    mode: 'MTP',
    model: 'Qwen3.8 Flash-Next',
    flag: '--speculative mtp --mtp-model PATH',
    body:
      'Uses the small Q8_0 predictor that ships with the model and drafts one to seven tokens at a time. Seeded sampled requests replay the same way every time.',
  },
  {
    mode: 'DSpark',
    model: 'DeepSeek V4 Flash',
    flag: '--dspark-model PATH',
    body:
      'Keeps only the drafted tokens the main model agrees with. Each request has its own sampling state. The support model is optional.',
  },
];

const commands = [
  ['gufo serve', 'Starts the server. Pick what to serve: llm, tts, asr, image or video.'],
  ['gufo chat', 'Chat in the terminal, either loading the model itself or talking to a running server.'],
  ['gufo prompt', 'Runs one request and exits. Handy in scripts and pipes.'],
  ['gufo eval', 'Grades the pinned DeepSeek V4 Flash capability questions against a running server.'],
  ['gufo bench', 'Measures model speed directly, greedy by default.'],
  ['gufo transcribe', 'Transcribes audio with Qwen3-ASR from the terminal.'],
  ['gufo video', 'Generates video with MiniMax H3.'],
  ['gufo diagnose', 'Checks drivers, groups and permissions, and tells you what is wrong.'],
];
---

<Layout title="Documentation · Gufo">
  <Navbar currentPath="/docs" />

  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      <!-- Sidebar -->
      <!-- On small screens the section list folds into a dropdown above the content -->
      <details class="lg:hidden border-y border-line text-sm">
        <summary class="cursor-pointer py-3 text-ink-2 select-none">On this page</summary>
        <div class="pb-4 space-y-4">
          {nav.map((section) => (
            <div>
              <div class="text-xs mb-1 text-ink-4">{section.group}</div>
              <ul>
                {section.items.map((item) => (
                  <li><a href={`#${item.id}`} class="block py-1.5 text-ink-2 hover:text-ink">{item.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <aside class="hidden lg:block lg:col-span-1 min-w-0 border-r border-line pr-4 space-y-6 text-sm sticky top-24">
        {nav.map((section) => (
          <div>
            <div class="text-xs mb-2 text-ink-4">{section.group}</div>
            <ul class="space-y-1">
              {section.items.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc={item.id}
                    class="block px-2.5 py-1.5 rounded text-ink-2 hover:text-ink hover:bg-paper-2 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="p-3 bg-paper rounded border border-line text-xs space-y-1.5">
          <div class="text-ink font-semibold">About this page</div>
          <p class="text-ink-3 leading-relaxed">
            This page summarizes the docs in the repository. It doesn't list every flag; run
            <code class="text-ink">--help</code> for those.
          </p>
        </div>
      </aside>

      <!-- Content -->
      <main class="lg:col-span-3 min-w-0 space-y-12">
        <div class="flex items-center gap-2 text-xs text-ink-3">
          <a href="/" class="hover:text-ink">Home</a>
          <span>/</span>
          <span class="text-ink">Documentation</span>
          <span>/</span>
          <span class="text-ink font-semibold">User and developer guide</span>
        </div>

        <!-- Quickstart -->
        <section id="quickstart" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h1 class="text-4xl sm:text-5xl text-ink">Quickstart</h1>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The quickest way in is the prebuilt image. Download the weights, start the server, and send it a request.
          </p>

          <div class="code-block">
            <div class="code-block-header"><span>Download weights</span><span>sh</span></div>
            <pre><code>hf download unsloth/Qwen3.8-27B-GGUF Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --revision 4ca720788d1e01f1bff70c033e0d0028fd02e502 \
  --repo-type model --local-dir models/Qwen3.8-27B-GGUF

hf download z-lab/Qwen3.8-27B-DFlash2-GGUF Qwen3.8-27B-DFlash2-Q4_K_M.gguf \
  --revision 2d9571f8ce46e151f61c6499c99dee6079e1d610 \
  --repo-type model --local-dir models/Qwen3.8-27B-DFlash2-GGUF</code></pre>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Serve with DFlash2 speculative decoding</span><span>sh</span></div>
            <pre><code>podman pull ghcr.io/gufo-org/toolboxes/gufo-runtime:latest

podman run --rm \
  --userns=keep-id:uid=1000,gid=1000 \
  --device /dev/kfd --device /dev/dri \
  --group-add keep-groups --ulimit memlock=-1 \
  -p 8080:8080 -v ./models:/models:ro \
  ghcr.io/gufo-org/toolboxes/gufo-runtime:latest \
  gufo serve --host 0.0.0.0 --port 8080 llm \
  --model /models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf \
  --speculative dflash2 \
  --dflash-model /models/Qwen3.8-27B-DFlash2-GGUF/Qwen3.8-27B-DFlash2-Q4_K_M.gguf</code></pre>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Ask it something</span><span>sh</span></div>
            <pre><code>curl http://localhost:8080/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '&#123;"model": "Qwen3.8-27B-UD-Q8_K_XL",
      "messages": [&#123;"role": "user", "content": "Say something"&#125;]&#125;'</code></pre>
          </div>

          <div class="admonition admonition-important">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>GPU access for rootless containers</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Rootless Podman needs <code class="text-ink font-mono">crun</code> for
              <code class="text-ink font-mono">--group-add keep-groups</code>. Your user needs read and write access to
              <code class="text-ink">/dev/kfd</code> and <code class="text-ink">/dev/dri/renderD*</code>, usually by
              joining the <code class="text-ink">render</code> and <code class="text-ink">video</code> groups. Log out
              and back in after changing groups. Groups with the same names inside the container don't count. If ROCm
              finds no device, check <code class="text-ink">id</code>,
              <code class="text-ink">ls -l /dev/kfd /dev/dri/renderD*</code> and
              <code class="text-ink">podman info --format '&#123;&#123;.Host.OCIRuntime.Name&#125;&#125;'</code>.
            </p>
          </div>

          <div class="admonition admonition-info">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>SELinux hosts</span>
            </div>
            <div class="text-[15px] text-ink-2 leading-relaxed space-y-2">
              <p>
                On Fedora and other SELinux hosts, the GPU can show up while SELinux still blocks
                <code class="text-ink">/dev/kfd</code>. ROCm then reports a misleading “Memory critical” error. Check the
                host's audit log:
              </p>
              <pre class="code-block">sudo ausearch -m avc -ts recent | grep -E '/dev/kfd|hsa_device_t'</pre>
              <p>
                If it shows a denied <code class="text-ink">map</code>, run
                <code class="text-ink">sudo setsebool -P container_use_devices true</code>. This applies to every
                container on the host, so make sure that's what you want.
              </p>
            </div>
          </div>
        </section>

        <!-- Platform -->
        <section id="platform" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Supported platform</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Gufo supports Linux x86-64 on AMD Strix Halo (<code class="text-ink font-mono">gfx1151</code>): Ryzen AI
            MAX+ 395 systems with Radeon 8060S and up to 128 GiB of unified memory. The HIP backend won't build for any
            other GPU.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-3.5 rounded bg-paper border border-line space-y-1.5 font-mono">
              <div class="text-ink font-semibold">Runtime</div>
              <div>GPU target: <span class="text-ink">gfx1151 (RDNA 3.5)</span></div>
              <div>Wavefront: <span class="text-ink-2">Wave32</span></div>
              <div>Memory: <span class="text-ink-2">unified LPDDR5X, CPU and GPU</span></div>
              <div>Devices: <span class="text-ink-2">/dev/kfd, /dev/dri</span></div>
            </div>
            <div class="p-3.5 rounded bg-paper border border-line space-y-1.5 font-mono">
              <div class="text-ink font-semibold">Qualified toolchain</div>
              <div>Compiler: <span class="text-ink">GCC 15.3, C++20</span></div>
              <div>ROCm: <span class="text-ink-2">7.2.3</span></div>
              <div>Build: <span class="text-ink-2">CMake 3.21+, Ninja, pkg-config</span></div>
              <div>Not required: <span class="text-ink-2">Python, Triton, CK, MIOpen</span></div>
            </div>
          </div>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Measured, not quoted</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Gufo checks the compute units, memory, firmware and power mode at runtime. Performance targets come from
              ceilings we measured with <code class="text-ink">tools/bench/gfx1151_peak.hip</code>, not from spec sheets.
              Machines with less memory work for the models that fit. Windows, macOS and other GPUs aren't supported
              here, though there is a community <a href="https://github.com/pixmaate/gufo" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line-strong hover:decoration-ink">Windows port</a>.
            </p>
          </div>
        </section>

        <!-- Build -->
        <section id="build" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Build from source</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The same CMake setup builds with Nix or on any regular Linux distribution.
          </p>

          <div class="code-block">
            <div class="code-block-header"><span>With Nix</span><span>sh</span></div>
            <pre><code><span class="code-comment"># Production package, no tests or tools</span>
nix build
./result/bin/gufo diagnose
./result/bin/gufo serve llm --model /path/to/model.gguf

<span class="code-comment"># Hosted CPU and repository checks</span>
nix build .#checks.x86_64-linux.pr

<span class="code-comment"># GPU development, profilers, reference tools</span>
nix develop</code></pre>
          </div>

          <div class="admonition admonition-important">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Stage new files before building</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Nix flakes only see files Git knows about, so <code class="text-ink font-mono">git add</code> new files
              before running <code class="text-ink font-mono">nix build</code>.
            </p>
          </div>

          <h3 class="text-sm font-semibold text-ink pt-2">Without Nix</h3>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            You need a C++20 compiler, CMake 3.21+, Ninja, pkg-config and these development packages:
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Dependency</th>
                  <th class="px-4 py-2.5">Used for</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {dependencies.map(([dep, use]) => (
                  <tr>
                    <td class="px-4 py-2.5 font-mono text-ink">{dep}</td>
                    <td class="px-4 py-2.5">{use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Debian / Ubuntu example</span><span>sh</span></div>
            <pre><code>sudo apt install build-essential cmake ninja-build pkg-config \
  libicu-dev libcurl4-openssl-dev libssl-dev libpng-dev libjpeg-dev ffmpeg

sudo apt install hipblas-dev hipblaslt-dev rocblas-dev \
  hipcub-dev rocprim-dev rocwmma-dev

cmake --preset release -DCMAKE_INSTALL_PREFIX="$HOME/.local"
cmake --build --preset release --parallel 4
./build/release/gufo diagnose</code></pre>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            If configuring stops at <code class="text-ink-2">find_package(hipblas)</code>, the ROCm packages are missing
            (other distributions call them <code class="text-ink-2">-devel</code>). If ROCm lives somewhere unusual, pass
            <code class="text-ink-2">-DCMAKE_PREFIX_PATH="/opt/rocm"</code>, and if CMake picks the system Clang, pass
            <code class="text-ink-2">-DCMAKE_HIP_COMPILER=/opt/rocm/llvm/bin/clang++</code>. Install with
            <code class="text-ink-2">cmake --install build/release</code>. Weights are downloaded separately.
          </p>
        </section>

        <!-- CLI -->
        <section id="cli" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">CLI commands</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Everything is a subcommand of the one <code class="text-ink font-mono">gufo</code> binary. The terminal
            commands and the server use the same models and sampling; the server adds request scheduling and prompt
            caching. Every command has <code class="text-ink font-mono">--help</code>, and unknown or conflicting
            options are an error, never silently ignored.
          </p>

          <div class="space-y-2">
            {commands.map(([name, body]) => (
              <div class="p-4 rounded-lg bg-paper border border-line space-y-1">
                <h3 class="font-semibold text-ink font-mono text-sm">{name}</h3>
                <p class="text-[15px] text-ink-2 leading-relaxed">{body}</p>
              </div>
            ))}
          </div>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>For flags, use --help</span>
            </div>
            <p class="text-[15px] text-ink-2 leading-relaxed">
              Flags change often, so they aren't listed here. Run <code class="text-ink font-mono">gufo serve --help</code>
              or <code class="text-ink font-mono">gufo serve llm --help</code>. The LLM server covers context and memory
              size, sampling, reasoning, the disk cache, speculative decoding and per-client limits.
            </p>
          </div>

          <div class="code-block">
            <div class="code-block-header"><span>Audio serving</span><span>sh</span></div>
            <pre><code><span class="code-comment"># Synthesis, with two named reference voices</span>
gufo serve tts --model models/Qwen3-TTS-12Hz-1.7B-Base --context 4096 \
  --voice narrator_eng=/audio/clear-english-voice.wav \
  --voice-text narrator_eng=/audio/clear-english-voice.txt

<span class="code-comment"># Transcription</span>
gufo serve asr --model models/Qwen3-ASR-1.7B --context 1024</code></pre>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Each process serves one model. To put several behind one URL, use llama-swap. For ASR,
            <code class="text-ink-2">--context</code> applies per audio chunk, so long recordings don't need a huge
            context.
          </p>
        </section>

        <!-- Models -->
        <section id="models" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Model guides</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Weights aren't bundled; download them separately. Each model's guide in the repository lists the exact files
            and benchmark settings.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Model</th>
                  <th class="px-4 py-2.5">Weights and inputs</th>
                  <th class="px-4 py-2.5">Modes</th>
                  <th class="px-4 py-2.5 font-mono">Guide</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {catalogue.map((m) => (
                  <tr class="align-top">
                    <td class="px-4 py-2.5 font-semibold text-ink whitespace-nowrap">{m.name}</td>
                    <td class="px-4 py-2.5">{m.weights}</td>
                    <td class="px-4 py-2.5 text-sky-700 whitespace-nowrap">{m.modes}</td>
                    <td class="px-4 py-2.5 font-mono text-[11px] text-ink-3">{m.docPath}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">One folder per model</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Each model is its own library in <code class="text-ink-2">src/models/&lt;model&gt;</code>, with its own
                loader, kernels and CPU reference. Kernels aren't shared, so changing one model can't break another.
                Tests live in <code class="text-ink-2">tests/models/&lt;model&gt;</code>.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Four docs per model</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                <code class="text-ink-2">README.md</code> for how to use it,
                <code class="text-ink-2">BENCHMARKS.md</code> for dated measurements,
                <code class="text-ink-2">QUALITY.md</code> for quality checks and known gaps, and
                <code class="text-ink-2">EXPERIMENTS.md</code> for what we tried and kept or dropped.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Licenses differ from Gufo's MIT license: Qwen-Image-2.1 weights are under the non-commercial Qwen Research
            License, and MiniMax H3 needs a checkpoint you supply under its community license. Gufo never downloads
            either one for you.
          </p>
        </section>

        <!-- API -->
        <section id="api" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">API</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The server speaks the OpenAI Chat Completions and Responses APIs, plus Anthropic Messages. All three handle
            tools and streaming; Chat Completions and Responses also take images. Fields Gufo doesn't support return an
            error instead of being quietly ignored. The full contract is in <code class="text-ink font-mono">docs/SERVER.md</code>.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Method</th>
                  <th class="px-4 py-2.5">Path</th>
                  <th class="px-4 py-2.5 font-sans">Availability</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {endpoints.map(([method, path, note]) => (
                  <tr class="hover:bg-paper-2 transition-colors">
                    <td class="px-4 py-2.5 text-ink font-semibold whitespace-nowrap">{method}</td>
                    <td class="px-4 py-2.5 text-ink whitespace-nowrap">{path}</td>
                    <td class="px-4 py-2.5 text-ink-3 font-sans">{note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            <code class="text-ink-2">/v1/embeddings</code> isn't implemented and returns 501. Logs and metrics never
            include prompt text unless you turn on <code class="text-ink-2">--trace</code>.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="code-block">
              <div class="code-block-header"><span>Chat completion</span><span>sh</span></div>
              <pre><code>curl http://localhost:8080/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '&#123;"model": "qwen", "stream": true,
      "reasoning_effort": "high",
      "messages": [&#123;"role": "user", "content": "Hi"&#125;]&#125;'</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Speech synthesis</span><span>sh</span></div>
              <pre><code>curl -sS http://127.0.0.1:8080/v1/audio/speech \
  -H 'Content-Type: application/json' \
  -d '&#123;"model": "qwen3-tts-12hz-1.7b-base",
      "voice": "narrator", "input": "Hello from Gufo."&#125;' \
  --output speech.wav</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Transcription</span><span>sh</span></div>
              <pre><code>curl -sS http://127.0.0.1:8080/v1/audio/transcriptions \
  -F file=@speech.wav -F model=qwen3-asr-1.7b \
  -F response_format=json</code></pre>
            </div>

            <div class="code-block">
              <div class="code-block-header"><span>Image generation</span><span>sh</span></div>
              <pre><code>curl --fail-with-body http://127.0.0.1:8080/v1/images/generations \
  -H 'Content-Type: application/json' \
  -d '&#123;"model": "Qwen-Image-2.1", "prompt": "A red ceramic teapot",
      "size": "1024x1024", "seed": 42&#125;' &gt; response.json</code></pre>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Defaults match llama.cpp: the model's full context, and generation runs until the model stops or the context
            fills up. <code class="text-ink-2">--context</code> and <code class="text-ink-2">--max-tokens</code> change
            that. Reasoning tokens count toward the response limit.
          </p>
        </section>

        <!-- Clients -->
        <section id="clients" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Clients and UIs</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Open WebUI, VS Code, Codex and the OpenAI SDKs all work: set the base URL to
            <code class="text-ink font-mono">http://localhost:8080/v1</code>.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="space-y-2">
              <h3 class="font-semibold text-ink text-sm">Python, openai SDK</h3>
              <div class="code-block">
                <div class="code-block-header"><span>example.py</span><span>python</span></div>
                <pre><code>from openai import OpenAI
client = OpenAI(
  base_url="http://localhost:8080/v1",
  api_key="not-needed",
)
stream = client.responses.create(
  model="qwen", input="Hello", store=False, stream=True
)</code></pre>
              </div>
            </div>

            <div class="space-y-2">
              <h3 class="font-semibold text-ink text-sm">Open WebUI and other frontends</h3>
              <div class="p-4 rounded-lg bg-paper border border-line text-[15px] text-ink-2 leading-relaxed space-y-2">
                <p>
                  Point the frontend at <code class="text-ink">http://&lt;host&gt;:8080/v1</code>. Inside a container,
                  serve with <code class="text-ink">--host 0.0.0.0</code> or the published port won't answer.
                </p>
                <p>
                  <code class="text-ink">--api-key</code> makes every request, health checks included, need
                  <code class="text-ink">Authorization: Bearer &lt;key&gt;</code>.
                </p>
                <p>
                  <code class="text-ink">--served-model-name</code> sets the name clients see in
                  <code class="text-ink">/v1/models</code> and send as <code class="text-ink">model</code>. It's only a
                  label.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Speculative decoding -->
        <section id="speculative" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Speculative decoding</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            A small draft model guesses the next few tokens and the main model checks them in one pass. With greedy
            decoding you get exactly the same text as without drafting. With sampling the odds are the same, but a given
            seed won't produce the same text as a normal run. How much faster it gets depends on how many guesses are
            right.
          </p>

          <div class="space-y-3">
            {speculative.map((s) => (
              <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-semibold text-ink text-sm">
                    {s.mode} <span class="text-ink-3 font-normal text-xs">· {s.model}</span>
                  </h3>
                  <code class="text-[11px] px-2 py-0.5 rounded bg-ivory border border-line-strong text-ink font-mono">
                    {s.flag}
                  </code>
                </div>
                <p class="text-[15px] text-ink-2 leading-relaxed">{s.body}</p>
              </div>
            ))}
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Measured speedups for each model are on the <a href="/benchmarks" class="text-ink font-semibold hover:underline">benchmarks page</a>.
          </p>
        </section>

        <!-- Concurrent serving -->
        <section id="serving" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Serving and caching</h2>
          <a href="/cache" class="block p-4 rounded-lg border border-line-strong bg-paper text-sm text-ink hover:bg-paper transition-colors">See how the new cache will work → <span class="text-ink-3">An interactive walkthrough of the cache redesign.</span></a>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            All requests share one copy of the weights. Each running request gets its own session with its own KV cache
            and state, from a pool you size with <code class="text-ink font-mono">--sessions N</code>. Requests that
            can run together are batched, and closing the connection cancels the request.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Prompt caching</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Processed prompts are reused by later requests, and with <code class="text-ink-2">--cache-disk</code>
                they survive restarts. You set how much RAM and disk the cache may use.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Client limits</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Limits on queued requests per client, timeouts and buffered output, so one slow client can't eat all the
                memory.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Reasoning controls</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Turn thinking on or off and set the effort from <code class="text-ink-2">minimal</code> to
                <code class="text-ink-2">max</code>. Conflicting settings are an error, not a guess.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Sampling uses each model's recommended defaults. Values in a request override the server's flags. For greedy
            output, use <code class="text-ink-2">--temperature 0</code> or <code class="text-ink-2">"temperature": 0</code>.
          </p>
        </section>

        <!-- Queue budget -->
        <section id="queues" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">GPU queue limit</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            The <code class="text-ink font-mono">gfx1151</code> GPU can keep eight compute queues active at once, across
            all processes. Go past that and the firmware starts switching between queues even when they're idle: the GPU
            looks busy, runs at full clock and draws about 26 W more than idle until those processes exit. A process
            claims its queues on its first GPU call and never gives them back, so plan on at most four HIP processes per
            machine.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Server</th>
                  <th class="px-4 py-2.5 text-right">GPU_MAX_HW_QUEUES</th>
                  <th class="px-4 py-2.5 text-right">Resident compute queues</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                <tr><td class="px-4 py-2.5 text-ink">serve llm</td><td class="px-4 py-2.5 text-right">2</td><td class="px-4 py-2.5 text-right">3</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve tts</td><td class="px-4 py-2.5 text-right">1</td><td class="px-4 py-2.5 text-right">2</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve asr</td><td class="px-4 py-2.5 text-right">1</td><td class="px-4 py-2.5 text-right">2</td></tr>
                <tr><td class="px-4 py-2.5 text-ink">serve image, serve video</td><td class="px-4 py-2.5 text-right">runtime default</td><td class="px-4 py-2.5 text-right">up to 5</td></tr>
              </tbody>
            </table>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            Each server checks how many queues are already taken, lowers its own limit to fit and logs a
            <code class="text-ink-2">queue_budget</code> event. It never raises the limit, so the order you start
            servers in doesn't change their speed. The lower limits for text and audio cost nothing measurable. If you
            set the value yourself, Gufo keeps it and warns if it doesn't fit.
          </p>
        </section>

        <!-- Presets -->
        <section id="presets" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">CMake presets and options</h2>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Configure preset</th>
                  <th class="px-4 py-2.5">Build type</th>
                  <th class="px-4 py-2.5">Contents</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {presets.map(([name, type, contents]) => (
                  <tr>
                    <td class="px-4 py-2.5 font-mono text-ink whitespace-nowrap">{name}</td>
                    <td class="px-4 py-2.5 whitespace-nowrap">{type}</td>
                    <td class="px-4 py-2.5">{contents}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            The <code class="text-ink-2">pr</code> build preset runs the same CPU checks as CI. Test presets are
            <code class="text-ink-2">cpu-test</code>, <code class="text-ink-2">cpu-sanitizer</code>,
            <code class="text-ink-2">gpu-fast</code> (skips slow tests and ones that need model files),
            <code class="text-ink-2">gpu-full</code>, <code class="text-ink-2">deepseek-gpu</code> and
            <code class="text-ink-2">qwen-gpu-kernel-oracle</code>.
          </p>

          <div class="border border-line rounded-lg overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-ivory text-ink-3 text-xs border-b border-line">
                <tr>
                  <th class="px-4 py-2.5">Option</th>
                  <th class="px-4 py-2.5">Default</th>
                  <th class="px-4 py-2.5">Effect</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-paper text-ink-2">
                {options.map(([name, def, effect]) => (
                  <tr>
                    <td class="px-4 py-2.5 font-mono text-ink whitespace-nowrap">{name}</td>
                    <td class="px-4 py-2.5 font-mono whitespace-nowrap">{def}</td>
                    <td class="px-4 py-2.5">{effect}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Workflow -->
        <section id="workflow" class="space-y-4 border-b border-line pb-8 scroll-mt-20">
          <h2 class="text-3xl text-ink">Development loop</h2>
          <p class="text-[15px] text-ink-2 leading-relaxed">
            Run the smallest check that covers your change, and build only the target you're working on. Formatting and
            repository checks don't need a GPU.
          </p>

          <div class="code-block">
            <div class="code-block-header"><span>Focused checks</span><span>sh</span></div>
            <pre><code><span class="code-comment"># Formatting, shared with CI; add --fix to apply</span>
nix shell --inputs-from . nixpkgs#clang-tools -c python3 tools/ci/check-format.py

<span class="code-comment"># Build and run one test target</span>
nix develop -c cmake --preset gpu-test
nix develop -c cmake --build --preset gpu-test --target &lt;test-target&gt;
nix develop -c ctest --preset gpu-full -R '^&lt;test-name&gt;$' --output-on-failure

<span class="code-comment"># Documentation-only changes</span>
nix build .#checks.x86_64-linux.docs</code></pre>
          </div>

          <p class="text-xs text-ink-3 leading-relaxed">
            CI runs <code class="text-ink-2">nix build .#checks.x86_64-linux.pr</code> on Ubuntu: formatting, docs and
            the CPU tests. It has no GPU and no weights, so run the GPU tests for your change locally. A test skipped
            because a model or device is missing doesn't count as passing.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Conventions</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Google-style C++20, 80 columns. clang-tidy runs over <code class="text-ink-2">src/</code> with warnings as
                errors. Each option has one name, with no aliases.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Optimizations</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Change one thing at a time and check it against a trusted reference. If it's slower or less accurate, it's
                dropped. If it wins, it becomes the default with no flag.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-paper border border-line space-y-2">
              <h3 class="font-semibold text-ink text-sm">Submitting changes</h3>
              <p class="text-xs text-ink-3 leading-relaxed">
                Use Conventional Commits with one-line messages. PRs are squash-merged with their title, and the release
                workflow handles versions and the changelog.
              </p>
            </div>
          </div>
        </section>

