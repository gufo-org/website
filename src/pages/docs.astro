                  <div>from openai import OpenAI</div>
                  <div>client = OpenAI(base_url="http://localhost:8080/v1", api_key="gufo")</div>
                  <div class="pt-1">resp = client.chat.completions.create(</div>
                  <div class="pl-4">model="qwen3.8-27b",</div>
                  <div class="pl-4">messages=[&#123;"role": "user", "content": "Hello!"&#125;]</div>
                  <div>)</div>
                  <div>print(resp.choices[0].message.content)</div>
                </div>
              </div>
            </div>

            <!-- Open WebUI / LibreChat -->
            <div class="p-4 rounded-lg bg-[#242526] border border-[#3e4042] space-y-2">
