---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Content, getHeadings } from '../content/readme.md';
import '../styles/prose.css';

// Sidebar groups, filled with the README's own section headings.
const groups = [
  { group: 'Getting started', slugs: ['quickstart', 'build-from-source'] },
];
const headings = getHeadings();
const nav = groups.map(({ group, slugs }) => ({
  group,
  items: slugs.flatMap((slug) => headings.filter((h) => h.slug === slug).map((h) => ({ id: h.slug, label: h.text }))),
}));
---

<Layout
  title="Documentation · Gufo"
  description="Run Gufo on AMD Strix Halo: quickstart with Podman, the OpenAI-compatible API, and building from source with or without Nix."
>
  <Navbar currentPath="/docs" />

  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      <!-- On small screens the section list folds into a dropdown above the content -->
      <details class="lg:hidden border-y border-line text-sm">
        <summary class="cursor-pointer py-3 text-ink-2 select-none">On this page</summary>
        <div class="pb-4 space-y-4">
          {nav.map((section) => (
            <div>
              <div class="text-xs mb-1 text-ink-4">{section.group}</div>
              <ul>
                {section.items.map((item) => (
                  <li><a href={`#${item.id}`} class="block py-1.5 text-ink-2 hover:text-ink">{item.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <aside class="hidden lg:block lg:col-span-1 min-w-0 border-r border-line pr-4 space-y-6 text-sm sticky top-24">
        {nav.map((section) => (
          <div>
            <div class="text-xs mb-2 text-ink-4">{section.group}</div>
            <ul class="space-y-1">
              {section.items.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc={item.id}
                    class="block px-2.5 py-1.5 rounded text-ink-2 hover:text-ink hover:bg-paper-2 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="p-3 bg-paper rounded border border-line text-xs space-y-1.5">
          <div class="text-ink font-semibold">About this page</div>
          <p class="text-ink-3 leading-relaxed">
            This page mirrors the repository README. It doesn't list every flag; run
            <code class="text-ink">--help</code> for those.
          </p>
        </div>
      </aside>

      <main class="lg:col-span-3 min-w-0">
        <div class="flex items-center gap-2 text-xs text-ink-3 mb-6">
          <a href="/" class="hover:text-ink">Home</a>
          <span>/</span>
          <span class="text-ink">Documentation</span>
        </div>
        <h1 class="text-4xl sm:text-5xl text-ink mb-8">Documentation</h1>
        <div class="prose-gufo [&_table]:block [&_table]:overflow-x-auto [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24">
          <Content />
        </div>
      </main>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  // Highlight the sidebar entry for the section currently at the top of the viewport.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]),
  );
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  function update() {
    // The last section whose top has passed just below the sticky navbar.
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 120) current = section;
    }
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
      current = sections[sections.length - 1];
    }
    links.forEach((link, id) => link.classList.toggle('sidebar-link-active', id === current?.id));
  }

  let queued = false;
  window.addEventListener(
    'scroll',
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true },
  );
  update();
</script>
