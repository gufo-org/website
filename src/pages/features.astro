---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Features — gufo">
  <Navbar currentPath="/features" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Sidebar (Docusaurus Features Sidebar) -->
      <aside class="lg:col-span-1 border-r border-[#3e4042]/50 pr-4 space-y-6 text-sm">
        <div>
          <div class="font-bold text-white uppercase text-xs tracking-wider mb-2 text-slate-400">
            Gufo Features
          </div>
          <ul class="space-y-1">
            <li>
              <a href="#unified-memory" class="block px-2.5 py-1.5 rounded text-slate-300 hover:text-[#25c2a0] hover:bg-[#242526] transition-colors">
                1.0 Unified Memory (HSA)
              </a>
            </li>
            <li>
              <a href="#wave32" class="block px-2.5 py-1.5 rounded text-slate-300 hover:text-[#25c2a0] hover:bg-[#242526] transition-colors">
                2.0 Wave32 SIMD & VOPD
              </a>
            </li>
            <li>
              <a href="#paged-kv" class="block px-2.5 py-1.5 rounded text-slate-300 hover:text-[#25c2a0] hover:bg-[#242526] transition-colors">
                3.0 Paged KV Cache Manager
              </a>
            </li>
            <li>
              <a href="#npu" class="block px-2.5 py-1.5 rounded text-slate-300 hover:text-[#25c2a0] hover:bg-[#242526] transition-colors">
                4.0 XDNA2 NPU Pipeline
              </a>
            </li>
            <li>
              <a href="#hip-hrx" class="block px-2.5 py-1.5 rounded text-slate-300 hover:text-[#25c2a0] hover:bg-[#242526] transition-colors">
                5.0 Dual HIP & HRX Backend
              </a>
            </li>
          </ul>
        </div>

        <div class="p-3 bg-[#242526] rounded border border-[#3e4042] text-xs font-mono space-y-1">
          <div class="text-slate-400 font-bold">Target Specification</div>
          <div>GPU: <span class="text-[#25c2a0]">gfx1151 (40 CUs)</span></div>
          <div>RAM: <span class="text-white">128 GiB LPDDR5X</span></div>
          <div>Bandwidth: <span class="text-emerald-400">278.4 GB/s peak</span></div>
          <div>NPU: <span class="text-sky-400">XDNA2 (50 TOPS)</span></div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="lg:col-span-3 space-y-10">
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <a href="/" class="hover:text-white">Home</a>
          <span>/</span>
          <span class="text-slate-200">Features</span>
          <span>/</span>
          <span class="text-[#25c2a0] font-semibold">Core Runtime Capabilities</span>
        </div>

        <!-- Section 1: Unified Memory -->
        <section id="unified-memory" class="space-y-4 border-b border-[#3e4042]/50 pb-8">
          <h1 class="text-3xl font-extrabold text-white tracking-tight">1.0 Unified Memory Subsystem & HSA</h1>
          <p class="text-sm text-slate-300 leading-relaxed">
            AMD Strix Halo features a wide 256-bit LPDDR5X memory subsystem offering up to 128 GiB of shared physical memory across CPU, GPU, and NPU. By eliminating PCIe bus bottlenecks:
          </p>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Zero Host-Device PCIe Copies</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Model weights and KV caches reside directly in pinned physical allocations. Kernels access page tables via direct HSA memory descriptors without intermediate DMA copy buffers.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-lg bg-[#242526] border border-[#3e4042] space-y-2">
              <h3 class="font-bold text-white text-xs font-mono uppercase">Discrete GPU Pipeline (PCIe)</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Requires loading weights across PCIe (32 GB/s limit), staging allocations in host RAM, and partitioning fixed VRAM buffers.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-[#242526] border border-[#3e4042] space-y-2">
              <h3 class="font-bold text-[#25c2a0] text-xs font-mono uppercase">Strix Halo Unified Pipeline</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Direct physical memory mapping. Sustains 268+ GB/s out of the measured 278.4 GB/s ceiling directly during autoregressive generation.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 2: Wave32 & VOPD -->
        <section id="wave32" class="space-y-4 border-b border-[#3e4042]/50 pb-8">
          <h2 class="text-2xl font-bold text-white tracking-tight">2.0 RDNA 3.5 Wave32 Execution & VOPD</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            The 40-CU RDNA 3.5 GPU (<code class="text-[#25c2a0] font-mono">gfx1151</code>) achieves peak ALU occupancy when dispatched with Wave32 wavefronts rather than CDNA Wave64 modes.
          </p>

          <div class="admonition admonition-info">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>VOPD Dual-Issue Instruction Scheduling</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              GEMM and GEMV loops pair independent vector arithmetic instructions into dual-issue 64-bit packages, maximizing floating-point operations per clock cycle.
            </p>
          </div>
        </section>

        <!-- Section 3: Paged KV Cache -->
        <section id="paged-kv" class="space-y-4 border-b border-[#3e4042]/50 pb-8">
          <h2 class="text-2xl font-bold text-white tracking-tight">3.0 Paged KV Cache Subsystem</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Fixed-size 16-token page blocks prevent memory fragmentation and allow instantaneous zero-copy prefix sharing between concurrent requests and speculative validation trees.
          </p>

          <div class="docusaurus-code">
            <div class="docusaurus-code-header">
              <span>Paged KV Block Mapping</span>
              <span>Memory Schema</span>
            </div>
            <div class="p-4 text-xs font-mono text-slate-300 space-y-1">
              <div>Seq 1 [0..63] ──▶ Blocks: [ #14, #29, #102, #8 ]</div>
              <div>Seq 2 [0..31] ──▶ Blocks: [ #14, #29 ] (Prefix cache hit, 0 additional bytes)</div>
              <div class="text-[#25c2a0] pt-1">O(1) allocation & deallocation on request lifecycle</div>
            </div>
          </div>
        </section>

        <!-- Section 4: XDNA2 NPU -->
        <section id="npu" class="space-y-4 border-b border-[#3e4042]/50 pb-8">
          <h2 class="text-2xl font-bold text-white tracking-tight">4.0 XDNA2 Heterogeneous Execution</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            The 50-TOPS XDNA2 NPU is evidence-gated for low-power speculative drafting and prompt prefill assistance, sharing the memory ring directly with the GPU without CPU userspace copies.
          </p>
        </section>

        <!-- Section 5: Dual Backend (HIP & HRX) -->
        <section id="hip-hrx" class="space-y-4">
          <h2 class="text-2xl font-bold text-white tracking-tight">5.0 Dual Backend Architecture: HIP & HRX</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            gufo provides two distinct GPU execution routes on <code class="text-[#25c2a0] font-mono">gfx1151</code>: the default production <b>ROCm/HIP executor</b> and the high-efficiency <b>native HRX (Hyperloom) executor</b>.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-lg bg-[#242526] border border-[#3e4042] space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-white text-xs font-mono uppercase">1. ROCm / HIP Executor</h3>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono">Default Production</span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                Standard high-throughput path powering <code class="text-[#25c2a0]">gufo serve</code>, multi-token batching, continuous request scheduling, and model-owned HIP kernel dispatch across all supported models.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-[#242526] border border-[#3e4042] space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-[#25c2a0] text-xs font-mono uppercase">2. Native HRX (Hyperloom) Executor</h3>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-mono">--qwen-backend hrx-native</span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                Direct low-level executor bypassing HIP driver interception. Loads 20 compiled Loom artifacts, offset-preserving mapped GGUF weights, and runs the single-token Q8_0 path with built-in bit-exact verification (<code class="text-[#25c2a0]">--validate-hrx 1</code>).
              </p>
            </div>
          </div>

          <div class="admonition admonition-tip">
            <div class="admonition-title">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Automated HRX Verification &amp; FFN-Down Optimization</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Native HRX execution is verified with <code class="text-[#25c2a0] font-mono">--validate-hrx 1</code>, comparing the complete logit vector against the HIP reference. The retained 256-thread FFN-down artifact reduces wave32 counts from 17 to 8 per workgroup, improving decode throughput by +1.7%.
            </p>
          </div>
        </section>
      </main>
    </div>
  </div>

  <Footer />
</Layout>
